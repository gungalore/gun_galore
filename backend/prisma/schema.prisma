// Gun Galore — Prisma schema (Prisma 7).
// URL is in prisma.config.ts (Prisma 7 requirement — not in schema).
// Run:  npx prisma migrate dev --name <description>
// See CLAUDE.md for the full data model built up phase by phase.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Foundation model — minimal seed so the initial migration is non-empty.
// Safe to remove once real models (User, Listing, etc.) are added in M1.
// ---------------------------------------------------------------------------

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
