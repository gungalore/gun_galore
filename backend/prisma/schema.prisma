// Gun Galore — Prisma schema (Prisma 7).
// URL is in prisma.config.ts (Prisma 7 requirement — not in schema).
// Run:  npx prisma migrate dev --name <description>
// See CLAUDE.md for the full data model built up phase by phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  // Legacy tier — kept so existing rows don't break. Treat as
  // MONITORING_ADMIN going forward (read-only).
  ADMIN
  // Top tier — can create other admins, modify KYC overrides, etc.
  // Maps to the user-facing "Full admin" label in the UI.
  SUPERADMIN
  // Read-only tier — sees the dashboard, listings, transactions, KYC
  // credit balance, but can't take destructive actions. Maps to the
  // user-facing "Monitoring admin" label. (Currently not enforced on
  // individual endpoints yet — that gate work is tracked separately.)
  MONITORING_ADMIN
}

enum OfferStatus {
  PENDING // awaiting seller response (48h TTL)
  COUNTERED // seller made a counter-offer; buyer must respond within 24h
  ACCEPTED // seller accepted original offer
  REJECTED // seller declined
  WITHDRAWN // buyer withdrew before seller responded
  EXPIRED // TTL elapsed without response
  CONVERTED // transaction created from this offer
}

enum ListingType {
  BUY_NOW
  TAKE_A_SHOT
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAYMENT_PENDING // reserved while buyer completes Peach checkout
  SOLD
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  HELD // payment received, funds held until delivery confirmed
  PENDING_ADMIN_VERIFICATION
  RELEASED // payout sent to seller
  DISPUTED
  REFUNDED
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum SellerTier {
  NEW
  ESTABLISHED
  TRUSTED
  TOP_SELLER
  DEALER
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum ClaudeDecision {
  APPROVE
  AUTO_FIX_AND_APPROVE
  REJECT
  HUMAN_REVIEW
}

enum ShippingMethod {
  PUDO // Pudo locker-to-locker (non-firearm)
  TCG // The Courier Guy door-to-door (non-firearm)
  DEALER_TRANSFER // Routed through a SAPS-licensed dealer (firearm — buyer picks dealer at checkout)
  PRIVATE_ARRANGE // Buyer + seller arrange in-person legal transfer (firearm — pair go to a dealer themselves)
}

enum ShippingStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTH_WEST
  NORTHERN_CAPE
  WESTERN_CAPE
}

enum RaffleStatus {
  DRAFT // admin building it
  ACTIVE // tickets on sale
  CLOSED_AWAITING_DRAW // timer ended, in 24h cooling window
  DRAWN // winner picked, in claim window
  CLAIMED // winner claimed prize
  CANCELLED_MIN_NOT_MET // refunding all entrants
  CANCELLED_BY_ADMIN // killed manually
  EXPIRED_UNCLAIMED // all winners failed to claim in window
}

enum TicketStatus {
  PENDING_PAYMENT // checkout started, awaiting Peach confirmation
  CONFIRMED // payment captured, ticket in the draw
  REFUNDED // returned to buyer (min-not-met)
  POSTAL // free-entry route, no payment
}

enum ItemSource {
  PLATFORM_OWNED // platform-supplied prize
  SELLER_APPLICATION // seller wants the platform to raffle it
}

// Pre-purchase product-only Q&A on a listing. There is NO buyer/seller
// messaging on Gun Galore — the only sanctioned pre-sale dialog is this
// structured, Claude-moderated Q&A on the listing page itself.
enum ListingQuestionStatus {
  PENDING_MODERATION // submitted, awaiting Claude pass 1 (moderation)
  REJECTED_BY_MODERATION // Claude rejected (off-topic / contact details / negotiation)
  AWAITING_SELLER_ANSWER // moderation passed, no prior Q matched — seller notified
  AUTO_ANSWERED // Claude found a recent matching prior Q + reused the seller's answer
  ANSWERED_BY_SELLER // seller answered manually via the dashboard
  HIDDEN // admin or seller hid this Q&A row from the public panel
}

// Featured-slot system (paid placement on the left rail). 10 slots
// rotate via per-slot auctions. See FeaturedSlot model below.
enum FeaturedSlotStatus {
  VACANT // no occupant + no active auction (cold start only)
  AUCTION_RUNNING // pre-auction is open, no current occupant yet
  BIND_WINDOW // auction closed, winner has 15 min to pick a listing
  OCCUPIED // listing bound, featured live until featuredUntil
}

enum FeaturedAuctionStatus {
  OPEN // accepting bids
  CLOSED_AWARDED // closed with a winner
  CLOSED_NO_BIDS // closed with zero bids — slot reopens an ad-hoc auction
  CANCELLED_BY_ADMIN // admin killed the auction
}

// Why the auction was opened — affects duration (24h scheduled vs 2h ad-hoc).
enum FeaturedAuctionKind {
  SCHEDULED // opens 24h before the predecessor's featuredUntil
  AD_HOC // listing sold mid-feature OR cold-start vacancy
}

enum FeaturedBidStatus {
  ACTIVE // outstanding, may still win
  WON // this bid won its auction (Peach charge pending)
  LOST // outbid before auction close
  WITHDRAWN // bidder pulled before auction close (if allowed)
  REFUNDED // won + paid + later refunded (e.g. admin force-evict)
}

// Five tiers map a bid amount to a featured duration. The amounts +
// durations are CONFIGURABLE via FeaturedSlotConfig — these enum
// names are stable label-free discriminators (display labels come
// from the config row, not the enum, so re-pricing doesn't require
// a schema migration).
enum FeaturedTier {
  T1
  T2
  T3
  T4
  T5
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                String     @id @default(cuid())
  clerkId           String     @unique
  email             String     @unique
  // Public-facing handle. Lowercased + unique. Optional until first set so we
  // can backfill existing Clerk-only users without breaking them.
  username          String?    @unique
  phone             String?
  // Phone-verification state. We send a 4-digit OTP via SMSPortal when the
  // seller changes their phone; phoneVerified flips to true once they
  // submit the matching code. phoneOtpHash stores a sha256 of the
  // active code so the raw number never sits on disk.
  phoneVerified     Boolean    @default(false)
  phoneOtpHash      String?
  phoneOtpExpiresAt DateTime?
  firstName         String?
  lastName          String?
  avatarUrl         String?
  // Personal / shipping address — distinct from per-listing pickup
  // address on `Listing`. Edited from /profile/edit.
  addrBuilding      String?
  addrStreet        String?
  addrAddress2      String?
  addrSuburb        String?
  addrCity          String?
  addrPostalCode    String?
  addrProvince      Province?
  addrLat           Float?
  addrLng           Float?
  sellerTier        SellerTier @default(NEW)
  trustScore        Int        @default(0)
  averageRating     Float?
  kycStatus         KycStatus  @default(NONE)
  kycVerifiedAt     DateTime?
  kycDocumentUrl    String? // Cloudinary URL of uploaded ID document (LEGACY — old manual flow)

  // ─────────────── VerifyNow KYC flow ───────────────
  // Triggered automatically when the first buyer kicks off a purchase
  // on one of this seller's listings. The seller is then prompted via
  // SMS + email + in-app banner to complete VerifyNow (SA ID lookup +
  // selfie face-match). Manual KYC entry from /profile has been removed.
  //
  // kycRequiredAt = when the first sale forced verification. Once set,
  // the in-app banner stays visible until kycStatus === VERIFIED.
  kycRequiredAt             DateTime?
  // POPIA consent must be explicit before any Home Affairs lookup. Set
  // when the seller ticks the consent box on /kyc/verify.
  kycConsentGivenAt         DateTime?
  // Home Affairs SA ID lookup passed (firstName/lastName already
  // populated from that response). Selfie still pending.
  kycIdVerifiedAt           DateTime?
  // Total face-match attempts. ≥3 fails → AdminAlert is raised and
  // the seller is told to contact support.
  kycAttempts               Int       @default(0)
  kycFaceMatchScore         Float?
  kycFaceMatchStatus        String?
  kycVerifyNowTransactionId String?
  // SHA-256 hash of the SA ID number (salted with ID_HASH_SECRET).
  // Stored ONLY as a hash so the raw 13-digit ID never lands on disk
  // — POPIA-friendly + lets us detect "this ID is already in use" by
  // hash collision check before calling VerifyNow. Unique at the DB
  // level so a duplicate registration physically can't land.
  kycIdHash                 String?   @unique
  // SA ID number stored AES-GCM encrypted at rest. Set when the
  // seller completes their profile (modal pops up after their first
  // listing publishes). On first sale, KycService decrypts it and
  // runs the VerifyNow Home Affairs lookup — the seller only does
  // the selfie face-match step. After KYC passes we PURGE this
  // column (set null) and keep only kycIdHash long-term; the
  // encrypted blob is transient PII we don't keep around.
  // Encryption key derives from ID_HASH_SECRET via HKDF in
  // backend/src/common/id-crypto.ts.
  idNumberEncrypted         String?
  totalSales                Int       @default(0)
  isBanned                  Boolean   @default(false)
  bannedAt                  DateTime?

  // Seller "Complete profile" gate — set when the seller submits the
  // post-first-publish profile modal (name/surname/username/phone/
  // address/ID/banking). Read on payout to ensure we have everything
  // required to disburse funds. Sellers can keep listing more items
  // without re-doing this; payout is what actually blocks until set.
  profileCompletedAt DateTime?

  // Banking — collected on the profile modal, validated against
  // Peach AVS (Account Verification Service) on save. All fields
  // null until the seller fills them in. We DON'T encrypt these at
  // rest; SA bank account numbers aren't classed as PII under POPIA
  // the same way an ID number is, and we need the plaintext to run
  // future payouts via Peach.
  bankName           String?
  bankAccountHolder  String?
  bankAccountNumber  String?
  bankBranchCode     String?
  bankAccountType    String? // "cheque" | "savings" | "transmission"
  // Stamp set when Peach AVS returns "match" on the bank details.
  // We re-run AVS on every save (per operator decision) so this
  // always reflects the most recent confirmation.
  bankVerifiedAt     DateTime?
  // Last raw Peach AVS response code, for audit if a payout fails
  // and we need to trace why.
  bankAvsResult      String?

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Auction system — non-payment strikes
  auctionStrikes Int       @default(0)
  lastStrikeAt   DateTime?

  // Dispatch SLA strikes — incremented when the 7d auto-refund cron
  // fires on a courier-shipped order this seller failed to dispatch
  // within the window. Three strikes are the operator threshold for
  // a manual review / suspension. Lives separately from auction
  // strikes because the rules + consequences are different.
  dispatchStrikes Int @default(0)

  listings           Listing[]
  buyerTransactions  Transaction[]  @relation("BuyerTransactions")
  sellerTransactions Transaction[]  @relation("SellerTransactions")
  ratingsGiven       Rating[]       @relation("RatingsGiven")
  ratingsReceived    Rating[]       @relation("RatingsReceived")
  offersPlaced       Offer[]        @relation("BuyerOffers")
  bidsPlaced         Bid[]          @relation("BidderBids")
  highBidOnListings  Listing[]      @relation("CurrentHighBidder")
  contactDetailRejections ContactDetailRejection[]
  watchlist          AuctionWatch[]

  // Q&A on listings — back-relations for "questions I've asked" and
  // "questions I've answered" (the latter is virtually always the
  // seller of the listing the question is on).
  askedListingQuestions    ListingQuestion[] @relation("AskedQuestions")
  answeredListingQuestions ListingQuestion[] @relation("AnsweredQuestions")

  // Raffles
  raffleTickets            Ticket[]
  raffleWinsAsWinner       RaffleWinner[]            @relation("WinnerUser")
  raffleSellerApplications RaffleSellerApplication[]

  // Featured slot system — back-relations.
  // `featuredSlotBids` is every bid this user has ever placed on a
  // featured slot auction (active, won, or lost). `featuredSlots` is
  // the (zero or more) slots this user currently occupies — populated
  // when their bid won + they bound a listing to it + the slot's
  // `featuredUntil` is still in the future.
  featuredSlotBids FeaturedSlotBid[] @relation("FeaturedSlotBidder")
  featuredSlots    FeaturedSlot[]    @relation("FeaturedSlotOccupant")

  // ── Zoho Books linkage ────────────────────────────────────────────
  // The user's Contact record in Zoho Books. Created lazily the first
  // time we need to invoice them (e.g. on their first sale that hits
  // verification APPROVED). Once created, reused for every subsequent
  // invoice/sales receipt so we don't duplicate contacts in Books.
  // Null = not yet synced; presence = ready to invoice without a
  // round-trip to create the contact.
  zohoContactId String?

  // ── ActionToken back-relation ────────────────────────────────────
  // SMS-link action tokens that authorise this user (e.g. tokens that
  // let them accept an offer / pay for a sale / raise a bid without
  // needing a Clerk session). Cascade-deleted when the user is deleted.
  actionTokensAuthorised ActionToken[] @relation("ActionTokensAuthorised")

  // ── Notification inbox back-relation ─────────────────────────────
  // In-app inbox rows. Written by NotificationsService.persist() in
  // addition to every email/SMS dispatch. Cascade-deleted with the user.
  notifications Notification[]

  // ── Wishlist back-relation ───────────────────────────────────────
  // Saved listings the user wants to come back to. See WatchedListing.
  // Distinct from AuctionWatch (which is bidding-specific notification
  // opt-in); wishlist is the general "save for later" pattern.
  wishlistEntries WatchedListing[]

  // ── Push notification back-relation ──────────────────────────────
  // Browser/PWA push subscription endpoints. One row per device a user
  // has opted in on (iPhone PWA + Android Chrome = two rows). Fired
  // by PushService.sendToUser when NotificationsService.persist
  // writes a non-dismissible (action-required) inbox row.
  pushSubscriptions PushSubscription[]

  // ── Ask GG subscription tier ─────────────────────────────────────
  // Orthogonal to SellerTier. SellerTier reflects marketplace
  // reputation (NEW → DEALER); SubscriptionTier reflects the AI
  // assistant subscription (FREE / MEMBER / PRO). A user can be
  // both DEALER + PRO, or NEW + FREE, etc.
  //
  // FREE = default. MEMBER + PRO are paid via Peach recurring
  // billing (see Subscription model). Admin can grant MEMBER/PRO
  // manually for testing / comp accounts (recorded in
  // AdminAuditEvent like any tier change).
  subscriptionTier        SubscriptionTier @default(FREE)
  // Peach card-vault ID. Created lazily on first paid subscription;
  // reused for every subsequent recurring charge. Mirrors the
  // zohoContactId pattern. NULL until the subscription billing
  // rail goes live (operator-side blocker — separate work).
  peachCustomerId         String?          @unique
  // Verified-expert badge (Pro tier). Awarded by admin after the
  // user has 5+ verified KB submissions. Visible site-wide next to
  // their username on listings + KB entries + Q&A answers.
  isVerifiedExpert        Boolean          @default(false)
  verifiedExpertAt        DateTime?
  expertBadgeReason       String?
  // Lifetime counters for FREE-tier caps. Free users get 5 messages
  // + 5 photo IDs per rolling 30 days; the AskGgUsage daily rollup
  // is the source of truth for windows, but these lifetime counts
  // make it cheap to render "you've used N total" in the UI without
  // a daily-rollup aggregation query.
  askGgLifetimeMessages   Int              @default(0)
  askGgLifetimePhotoIds   Int              @default(0)

  // Back-relations (Ask GG subscription + assistant)
  subscription              Subscription?
  askGgConversations        AskGgConversation[]
  askGgKbEntries            AskGgKbEntry[]       @relation("KbAuthor")
  askGgUsage                AskGgUsage[]
}

// =====================================================================
// In-app Notifications inbox
// =====================================================================
// Persistent feed of events for the user — the source of truth behind
// the bell icon in the bottom tab bar + the /notifications inbox page.
// Mirrors every email/SMS dispatched by NotificationsService.
//
// "Resolved" semantics: a notification stays in the inbox (and counts
// toward the bell badge) until either:
//   * The linked entity transitions to a terminal state and
//     NotificationsService.resolveByEntity() stamps resolvedAt
//     (e.g. seller accepts an offer → the seller's "offer received"
//     notification auto-resolves), OR
//   * The user explicitly dismisses an informational notification
//     via the × button (only allowed when dismissible = true).
//
// Opening the inbox or tapping a row does NOT clear anything — that
// was the explicit user-spec'd behaviour. The badge only drops when
// the user actually acts on the underlying entity.
enum NotificationCategory {
  BUYER    // events relevant to the user as a buyer
  SELLER   // events relevant to the user as a seller
  ACCOUNT  // KYC / AVS / broadcasts / admin messages
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  // Discriminator for the event (e.g. 'offer_received', 'bid_outbid').
  // Free-form string so we can add new event types without a migration.
  type      String

  title     String
  body      String
  url       String?              // deep-link path (e.g. /transactions/abc)
  iconKey   String?              // UI icon hint (offer | bid | sold | ...)

  // Linkage to the underlying entity. resolveByEntity() in the service
  // looks up unresolved rows by (linkedType, linkedId) and stamps
  // resolvedAt on them when the entity transitions.
  linkedType String?             // 'offer' | 'transaction' | 'bid' | 'listing' | 'raffle'
  linkedId   String?

  // Resolution state.
  resolvedAt DateTime?
  resolvedBy String?             // 'user_action' | 'dismissed' | 'auto_expired'

  // True for informational notifications the user can swipe/tap to
  // dismiss. False for action-required ones — those can ONLY clear
  // via resolveByEntity when the underlying entity transitions.
  dismissible Boolean             @default(false)

  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Bell-badge / active-feed query: WHERE userId=? AND resolvedAt IS NULL
  @@index([userId, resolvedAt, createdAt(sort: Desc)])
  // resolveByEntity lookup
  @@index([linkedType, linkedId, resolvedAt])
}

model Category {
  id                  String     @id @default(cuid())
  name                String
  slug                String     @unique
  parentId            String?
  parent              Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children            Category[] @relation("SubCategories")
  // True when this category contains items legally classified as firearms
  // (the Firearms parent + all its children, plus Barrels under Gun Smithing).
  isFirearm           Boolean    @default(false)
  // Subset of isFirearm — these MUST ship via licensed-dealer transfer.
  // SAPS regulation: firearms + barrels cannot move between individuals
  // without dealer paperwork.
  requiresLicence     Boolean    @default(false)
  // Whether this category appears on the used marketplace (Sell form +
  // marketplace filters). False for live-ammo categories.
  availableSecondhand Boolean    @default(true)
  // Whether this category appears on the dealer New Store (M3 phase).
  availableNewStore   Boolean    @default(false)
  isActive            Boolean    @default(true)
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())

  listings Listing[]
}

model Listing {
  id              String  @id @default(cuid())
  // Human-trackable reference shown to buyers + sellers (e.g. UM000123,
  // AU000045, TS000007). Prefix encodes listingType:
  //   UM = Used marketplace (BUY_NOW)
  //   AU = Auction          (AUCTION)
  //   TS = Take a Shot      (TAKE_A_SHOT)
  // Assigned at create time via ReferenceCounter — see
  // listings/reference.helper.ts. Nullable so legacy rows can be
  // back-filled in a separate pass without blocking the migration.
  referenceNumber String? @unique

  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title       String
  description String
  price       Int? // ZAR cents; null for TAKE_A_SHOT listings
  listingType ListingType
  status      ListingStatus @default(DRAFT)
  condition   Condition
  province    Province

  isFirearm Boolean @default(false)
  make      String?
  model     String?
  calibre   String?

  // ----- Firearm/barrel licence + serial capture (SAP 534 workflow) -----
  // Only populated for isFirearm / licence-controlled listings. Collected
  // in the Sell form and cross-checked by Claude vision at create time:
  //   - serialNumber: seller-typed; must match the serial photo AND the
  //     serial printed on the licence.
  //   - serialPhotoUrl / licencePhotoUrl: Cloudinary URLs of the proof
  //     photos (serial stamp on the firearm/barrel, and the licence doc).
  //   - licenceHolderName: name vision read off the licence (must match
  //     the seller).
  //   - licenceExpiresAt: expiry date vision read off the licence. Drives
  //     the listing gate (expired/≤30d blocked, 31–90d warn) and the daily
  //     auto-delist cron (set EXPIRED once ≤30d out).
  serialNumber      String?
  serialPhotoUrl    String?
  licencePhotoUrl   String?
  licenceHolderName String?
  licenceExpiresAt  DateTime?

  // Parcel weight + dimensions captured by the seller in the Sell form.
  // Required for non-firearm listings (Pudo + TCG need them to quote
  // rates). Firearm listings can leave them null because DEALER_TRANSFER
  // and PRIVATE_ARRANGE don't use the courier API. Pudo's largest L2L
  // locker box is 60×41×69 cm at 20 kg — anything beyond that forces
  // TCG door-to-door (the Sell form hides the PUDO option when over).
  weightGrams Int?
  lengthCm    Int?
  widthCm     Int?
  heightCm    Int?

  autoAcceptThreshold Int? // ZAR cents; Take a Shot only

  // ----- AUCTION-specific fields -----
  // price (above) = starting bid for AUCTION listings
  reservePrice    Int? // optional hidden reserve; never exposed publicly
  buyNowPrice     Int? // optional Buy Now price — only honoured while bidCount == 0
  isFeatured      Boolean   @default(false) // R150 paid placement
  currentBid      Int? // current visible high bid in ZAR cents
  currentBidderId String? // current high bidder
  currentBidder   User?     @relation("CurrentHighBidder", fields: [currentBidderId], references: [id])
  bidCount        Int       @default(0)
  reserveMet      Boolean   @default(false)
  startTime       DateTime?
  endTime         DateTime? // may be extended by snipe protection
  durationDays    Int? // 3 / 5 / 7 / 14 — snapshot of seller's choice
  endedAt         DateTime? // when the end-cron processed this auction

  // LOCKED per CLAUDE.md — seller always absorbs the processing fee.
  // Field is kept for backwards compatibility with old rows but is no
  // longer surfaced in the Sell form.
  passFeeToBuyer Boolean @default(false)

  // Seller-offered shipping methods. For non-firearm listings this is
  // some non-empty subset of [PUDO, TCG]. For firearm / barrel listings
  // it's a subset of [DEALER_TRANSFER, PRIVATE_ARRANGE]. DEALER_TRANSFER
  // is MANDATORY for firearm listings — the seller can additionally
  // offer PRIVATE_ARRANGE, but they cannot list a firearm without
  // dealer-stock as an option. ListingsService.create + update enforce
  // this. The buyer picks ONE of these at checkout and that pick lands
  // on Transaction.shippingMethod.
  shippingMethods ShippingMethod[] @default([])

  // Optional seller-supplied hint of where they intend to dealer-stock
  // a firearm (e.g. "Pretoria Arms, Centurion"). Only meaningful when
  // the listing is a firearm + offers DEALER_TRANSFER. Shown to buyers
  // on the listing detail page so a buyer near that dealer can see
  // they'd have less driving post-purchase. Free text, max 200 chars,
  // not validated against a dealer registry — purely informational.
  // Seller is NOT bound to this dealer (the actual stocking dealer is
  // captured at dealer-verification upload time).
  plannedDealerLocation String?

  // Seller pickup address (where Pudo/TCG collect from, or where the
  // private/dealer-transfer hand-off originates). Captured at listing
  // time. Auto-filled from Google Places autocomplete when available.
  pickupBuilding   String?
  pickupStreet     String?
  pickupAddress2   String?
  pickupSuburb     String?
  pickupCity       String?
  pickupPostalCode String?
  pickupLat        Float?
  pickupLng        Float?

  // Seller's preferred Pudo locker (set when shippingMethods includes
  // PUDO). Auto-suggested from pickupLat/pickupLng → nearest 3 lockers,
  // or overridden by the seller from a Meilisearch lookup.
  pickupPudoLockerId String?

  claudeDecision            ClaudeDecision?
  claudeConfidence          Float?
  claudeReasons             String[]
  claudeReviewedAt          DateTime?
  claudeOriginalDescription String?
  claudeAutoFixApplied      Boolean         @default(false)

  adminReviewedById   String?
  adminReviewedAt     DateTime?
  adminOverrideReason String?

  expiresAt DateTime?
  soldAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  images       ListingImage[]
  transactions Transaction[]
  offers       Offer[]
  bids         Bid[]
  watchers     AuctionWatch[]
  // Users who saved this listing to their wishlist. Distinct from
  // `watchers` (auction-bidding opt-in). Used for the heart-icon
  // state across browse grids + /wishlist page + future "X people
  // saved this" social-proof signal.
  wishlistedBy WatchedListing[]
  questions    ListingQuestion[]

  // Featured-slot back-relation. When a seller wins a featured slot
  // auction + binds this listing to it, the slot's
  // `currentListingId` points here. Optional 1:1 (a listing is in
  // ≤1 slot at a time, a slot has ≤1 listing).
  featuredInSlot FeaturedSlot? @relation("FeaturedSlotListing")

  @@index([status, listingType])
  @@index([categoryId])
  @@index([sellerId])
  @@index([endTime])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Dealer {
  id            String   @id @default(cuid())
  name          String
  licenceNumber String   @unique
  address       String
  suburb        String
  city          String
  province      Province
  postalCode    String
  lat           Float?
  lng           Float?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]

  @@index([province])
  @@index([isActive])
}

model Transaction {
  id String @id @default(cuid())

  // Parties
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("SellerTransactions", fields: [sellerId], references: [id])

  // Pricing — all ZAR cents, snapshot at point of sale
  listingPrice        Int // snapshot of listing.price
  commissionZar       Int
  processingFee       Int // Peach fee (3.5% + R1.50 fixed, ×1.15 VAT)
  // Shipping cost the buyer paid, sourced from a live Pudo / TCG rate
  // quote at checkout. Zero for firearm listings (DEALER_TRANSFER and
  // PRIVATE_ARRANGE don't use the courier API). Stored separately from
  // buyerTotal so we can show the breakdown later + remit to the
  // courier without re-computing.
  shippingCost        Int     @default(0)
  // Service level snapshot — "L2LXS - ECO" / "D2DM - ECO" etc. Comes
  // straight from Pudo's response so we can pass it back into the
  // shipment-create call without re-fetching the quote.
  shippingServiceCode String?
  passFeeToBuyer      Boolean // snapshot of listing.passFeeToBuyer
  buyerTotal          Int // what buyer is charged by Peach
  sellerPayout        Int // what seller receives after deductions

  // Payment
  paymentStatus   PaymentStatus @default(HELD)
  peachCheckoutId String?
  // @unique: a gateway payment id can settle exactly ONE transaction.
  // Defence-in-depth against replaying one Peach success against multiple
  // orders — the second markPaid hits a unique violation. NULLs are
  // exempt (Postgres) so unpaid rows are fine. Replaces the old
  // non-unique @@index([peachPaymentId]).
  peachPaymentId  String?       @unique
  peachResultCode String?
  paidAt          DateTime?
  releasedAt      DateTime?

  // Shipping
  shippingMethod    ShippingMethod?
  shippingStatus    ShippingStatus?
  trackingReference String?
  dispatchedAt      DateTime?
  deliveredAt       DateTime?

  // Pudo locker-to-locker
  pudoDropoffLockerId String? // seller's drop-off locker (set at dispatch)
  pudoPickupLockerId  String? // buyer's chosen pickup locker
  pudoTrackingCode    String?

  // TCG door delivery
  deliveryAddress Json? // { building?, streetAddress, address2?, suburb, city, province, postalCode, lat?, lng? } — contactName + contactPhone resolved from User at shipment-creation time
  tcgWaybill      String?

  // Firearm dealer transfer
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  // KYC gate — populated when seller passes KYC after payment received
  sellerKycClearedAt DateTime?

  // Dispatch SLA — set the first (and only) time the 48h nudge cron
  // sends a "please dispatch" reminder to the seller. Idempotency
  // guard so the cron doesn't spam them every 10 min after the
  // window passes.
  dispatchNudgedAt DateTime?

  // ── Seller accept flow (TOK-7) ───────────────────────────────────
  // Two-step seller workflow: after the buyer pays, the seller has 48h
  // to ACCEPT the transaction (one-tap via SMS), then 5 days from accept
  // to DISPATCH. Without acceptedAt being set the buyer sits in
  // "Awaiting seller accept" status on their order page.
  //
  // Migration: every transaction with paidAt set at deployment time
  // gets `acceptedAt = paidAt` backfilled so the new acceptance gate
  // doesn't suddenly trap legacy in-flight orders.
  //
  // accept/dispatch deadlines are stored so the UI countdown chips
  // can use a single field instead of recomputing paidAt+48h on every
  // render, and the cron can do an indexed scan on the deadline column.
  acceptedAt          DateTime?
  acceptDeadlineAt    DateTime?  // = paidAt + 48h, set when payment captured
  dispatchDeadlineAt  DateTime?  // = acceptedAt + 5d, set when seller accepts

  // Seller rejection of the sale — instead of accepting, seller can
  // reject. Triggers Peach refund + buyer notification. rejectedReason
  // surfaces in the buyer's notification and in the admin audit log.
  rejectedAt      DateTime?
  rejectedReason  String?

  // Set when the 48h-no-accept cron escalates the order to the admin
  // queue (operator-confirmed 2026-05-27: no auto-refund on this
  // timeout, admin manually decides). Idempotency guard against the
  // cron raising the same flag every 10 min.
  acceptEscalatedAt DateTime?

  // PRIVATE_ARRANGE explicit consent. The buyer ticked two checkboxes
  // and typed "I UNDERSTAND" at checkout to acknowledge that payment
  // protection ends at payment capture — the seller is paid
  // immediately and contact details are revealed to both parties so
  // they can coordinate the dealer meet. Without this column being
  // set, the immediate-payout branch in markPaid() refuses to fire
  // (defence in depth against a buyer hitting the API without going
  // through the consent screen).
  privateArrangeAcceptedAt DateTime?

  // ─── Dealer-stock-in verification (firearm DEALER_TRANSFER only) ──
  // When the firearm is delivered to the chosen SAPS-licensed dealer,
  // the seller uploads 3 photos (SAPS 534 form, last line of dealer's
  // stock register, firearm with serial visible). Claude vision scans
  // them against a rubric and writes the result here. Payout release
  // for firearm DEALER_TRANSFER transactions is gated on
  // dealerVerificationStatus = 'APPROVED'.
  //
  // Status lifecycle:
  //   null               — not applicable (non-firearm, or PRIVATE_ARRANGE)
  //   PENDING_UPLOAD     — seller hasn't submitted photos yet
  //   PENDING_CLAUDE     — photos uploaded, Claude scan in progress
  //   PENDING_ADMIN_REVIEW — Claude returned 50-79% confidence, admin must review
  //   APPROVED           — auto (≥80% all criteria) or admin override
  //   REJECTED           — auto (<50% on any criterion) or admin reject; seller must reshoot
  //
  // The Cloudinary URLs are nullable so admin can render whichever
  // ones uploaded successfully (one-or-two-failed retry path).
  saps534PhotoUrl              String?
  stockRegisterPhotoUrl        String?
  firearmSerialPhotoUrl        String?
  dealerVerificationStatus     String?
  // 0..100, weighted average of per-criterion confidence scores.
  dealerVerificationScore      Float?
  // Full structured JSON returned by Claude — per-criterion scores +
  // extracted values + issues list. Stored verbatim for audit + so
  // the admin panel can re-render Claude's reasoning without a re-run.
  dealerVerificationFindings   Json?
  dealerVerifiedAt             DateTime?
  // Stock-register entry number the dealer (or seller) types in, for
  // SAPS audit cross-reference. Optional — not always available at
  // upload time.
  dealerStockRegisterRef       String?

  // ── Stocked-at dealer contact (sent to buyer on payout release) ──
  // When verification approves, Gun Galore's job ends. We notify the
  // buyer of WHERE the firearm is — the dealer the seller dropped it
  // at — so the buyer can arrange their own inter-dealer transfer or
  // collection. Captured on the seller's verification upload form
  // alongside the 3 photos; surfaced on the buyer's transaction page
  // and in the payout-released notification email/SMS.
  stockedAtDealerName     String?
  stockedAtDealerAddress  String?
  stockedAtDealerPhone    String?

  // ── Zoho Books linkage ────────────────────────────────────────────
  // Documents created in Books for this transaction:
  //   - zohoCommissionInvoiceId: Gun Galore → Seller invoice for the
  //     platform commission. Created on verification APPROVED.
  //   - zohoCommissionPaymentId: the payment record that marks the
  //     invoice paid. Created when the seller payout fires.
  //   - zohoCreditNoteId: only set on refund — credit note against
  //     the original commission invoice.
  //
  // zohoSyncStatus tracks the most recent attempt:
  //   - null / 'IDLE': nothing has tried to sync yet
  //   - 'PENDING': sync attempt in flight
  //   - 'OK': latest attempt succeeded
  //   - 'FAILED': latest attempt failed (see zohoSyncError + zohoSyncLastAttemptAt)
  //   - 'SKIPPED': feature flag was off when the event fired
  zohoCommissionInvoiceId String?
  zohoCommissionPaymentId String?
  zohoCreditNoteId        String?
  zohoSyncStatus          String?
  zohoSyncError           String?
  zohoSyncLastAttemptAt   DateTime?

  // ── Manual EFT payment (PAYMENT_MODE=manual) ────────────────────────
  // While there is no live card gateway, buyers pay GG by EFT using
  // `orderReference` as their bank reference. The site matches FNB
  // inContact alerts (provisional) + the daily FNB statement
  // (authoritative) against this reference + the exact amount. Distinct
  // from the listing's own reference number; unique per order.
  orderReference   String?   @unique
  // EFT lifecycle: manualDetectedAt = an inContact alert matched
  // (provisional, seller NOT yet notified); manualVerifiedAt = the FNB
  // statement confirmed it (authoritative → markPaid runs).
  manualDetectedAt DateTime?
  manualVerifiedAt DateTime?
  // 24-hour pay-by deadline shown to the buyer. The item stays reserved
  // for the committed buyer for the full window (long enough that the
  // daily statement reconciliation runs at least once while it's still
  // theirs); the freeze-expiry cron only releases the listing back to
  // ACTIVE if NOTHING has been detected/paid by then.
  manualPayByAt    DateTime?
  // Set when the freeze-expiry cron soft-cancels an un-paid manual order
  // (releases the listing but KEEPS this row so a LATE statement payment
  // for orderReference can still be matched → surfaced as "paid after
  // expiry" for admin refund/re-fulfil instead of being lost).
  manualCancelledAt DateTime?
  // Payment-reminder idempotency guards: a "12 hours left" and a
  // "1 hour left" SMS nudge across the 24h window.
  manualWarn12hAt  DateTime?
  manualWarn1hAt   DateTime?

  // Admin
  adminNote         String?
  adminReviewedById String?
  adminReviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages            Message[]
  trackingEvents      TrackingEvent[]
  rating              Rating?
  manualPayments      ManualPayment[]
  confirmedDeliveryAt DateTime?

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([paymentStatus])
  @@index([manualPayByAt])
  // peachPaymentId now has a @unique on the field (creates its own index).
}

// Append-only timeline of shipping + payment milestones per Transaction.
// Powers the buyer/seller-facing tracking UI on /transactions/[id].
//
// Two writers:
//   1. Internal flow — we record a row at each state change we own
//      (paid, dispatched, delivered confirmed, payout released). These
//      rows have source=INTERNAL.
//   2. Polling cron — every 10 min the cron asks Pudo (and later TCG)
//      for the parcel's tracking_events, maps carrier statuses to our
//      internal status via status-map.ts, then appends any events we
//      haven't seen yet. These rows have source=PUDO or source=TCG.
//
// Idempotency: the @@unique([transactionId, status, occurredAt]) tuple
// stops the cron from inserting the same carrier event twice if it
// re-appears in a later poll. occurredAt is the carrier's timestamp
// (or now() for internal events); recordedAt is when our system first
// observed it. status uses the collapsed internal vocabulary from
// status-map.ts (PUDO_PIN_ISSUED, PARCEL_DROPPED_OFF, AT_LOCKER, etc).
model TrackingEvent {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Collapsed internal vocabulary (see status-map.ts). Free string so
  // we don't have to migrate the schema each time a new carrier status
  // gets added to the map.
  status    String
  // Raw carrier value before mapping ("ARRIVED_AT_LOCKER" / "Out For
  // Delivery" / etc). Null for INTERNAL-sourced events.
  rawStatus String?
  // INTERNAL | PUDO | TCG — who reported this event.
  source    String
  // Human-readable line shown on the timeline. Optional; the UI falls
  // back to a per-status default when null.
  message   String?

  // When the event happened from the carrier's perspective (or our
  // system's clock for INTERNAL events). Used for sort order on the
  // timeline + as part of the idempotency key.
  occurredAt DateTime
  // When our system first wrote this row.
  recordedAt DateTime @default(now())

  @@unique([transactionId, status, occurredAt])
  @@index([transactionId])
}

// Self-improving FAQ panel that sits on every listing's detail page.
// Replaces buyer/seller messaging entirely — see CLAUDE.md and the
// design note in chat history. Two Claude passes per question:
//
//   Pass 1 (Haiku — moderation): is this a product-info question?
//     Reject anything off-topic, contact-detail-leaking, or trying to
//     negotiate price (price moves through the Offer system, not
//     Q&A). Rejected rows stay in the table for audit but never go
//     public.
//
//   Pass 2 (Sonnet — semantic dedup): if pass 1 passed, look at all
//     prior ANSWERED_BY_SELLER rows for this listing within the last
//     30 days. If one semantically matches, auto-publish the answer
//     using the seller's prior reply (rewritten in fresh voice) and
//     set autoAnsweredFromQuestionId for traceability. If no match,
//     status → AWAITING_SELLER_ANSWER and the seller is notified.
//
// Sellers can flag an AI answer as "not right" → invalidates the
// source Q so it won't auto-answer again, and the seller writes a
// fresh manual reply. Buyers can flag any public row → admin review.
model ListingQuestion {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId   String
  asker     User    @relation("AskedQuestions", fields: [askerId], references: [id])

  question String

  // Claude pass 1 — moderation. APPROVE / REJECT and the public-facing
  // reason ("Keep it to product details", etc).
  questionDecision String? // 'APPROVE' | 'REJECT'
  questionReason   String?

  status ListingQuestionStatus @default(PENDING_MODERATION)

  // Answer fields — populated when a seller answers manually OR when
  // Claude auto-answers from a prior Q. answeredByUserId is null in
  // the auto-answer case (the asker still attributes it to "Gun
  // Galore AI" in the UI).
  answer           String?
  answeredByUserId String?
  answeredByUser   User?     @relation("AnsweredQuestions", fields: [answeredByUserId], references: [id])
  answeredAt       DateTime?

  // When the answer came from Claude pass 2 — this points at the
  // source ListingQuestion whose seller-written answer we re-used.
  // Lets us surface "based on a prior question" in the UI + lets the
  // seller invalidate the source if the AI got it wrong.
  autoAnsweredFromQuestionId String?
  autoAnsweredFrom           ListingQuestion?  @relation("AutoAnswerSource", fields: [autoAnsweredFromQuestionId], references: [id])
  autoAnswers                ListingQuestion[] @relation("AutoAnswerSource")

  // Seller pressed "this isn't right" on an AI-published answer →
  // we set invalidatedAt on the SOURCE Q (the one Claude reused),
  // which excludes it from future dedup matches. The bad AI answer
  // gets status=HIDDEN until the seller writes a fresh reply.
  invalidatedAt DateTime?

  // Public-panel state + abuse signal.
  reportedCount Int     @default(0)
  isPublic      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, status])
  @@index([askerId])
  @@index([answeredByUserId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  firstName    String?
  lastName     String?
  // Optional link to the Clerk user record (mirrored into our User
  // table). When set, outbound alerts (SMS + email) are pulled from
  // User.phone / User.email so we never duplicate contact info between
  // tables. Nullable so the seed superadmin (and any legacy admin
  // created before Clerk-linkage) keeps working with email+password.
  clerkId      String?   @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Back-relation for AdminAuditEvent.adminUser (every audit row is
  // attributed to the admin who triggered it).
  auditEvents              AdminAuditEvent[]
  // Back-relation for ReloadingManual.uploadedByAdmin — admin who
  // ingested a reloading manual via the inbox-scan flow.
  reloadingManualsUploaded ReloadingManual[] @relation("ReloadingUploader")
}

// Cross-resource audit trail for every destructive admin action.
// Each row is one admin operation: who did it, when, on what, what
// changed (oldValue → newValue), and the reason they typed at the
// time. Read-only from the UI; only inserted by AdminAuditService.
// Domain-specific audit tables (RaffleAuditEvent, FeaturedSlotAuditEvent)
// stay as-is for module-specific event types; this table captures the
// broad ops surface — user bans / tier changes / KYC overrides /
// transaction refunds / etc.
model AdminAuditEvent {
  id            String   @id @default(cuid())
  adminUserId   String
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id])
  // Free-form action verb — e.g. "USER_BAN", "USER_UNBAN",
  // "USER_TIER_CHANGE", "USER_KYC_OVERRIDE", "TRANSACTION_REFUND",
  // "LISTING_FORCE_HIDE". String not enum so new actions don't need
  // schema migrations.
  action        String
  // Resource being acted upon — usually a User.id, Transaction.id,
  // Listing.id. Nullable for actions that don't have a single target.
  resourceType  String?  // 'User' | 'Transaction' | 'Listing' | 'Raffle' | ...
  resourceId    String?
  // Snapshot of what changed. Both nullable so single-direction
  // events (e.g. force-hide a listing) can record just newValue.
  oldValue      String?  // JSON-stringified
  newValue      String?  // JSON-stringified
  // Reason the admin typed in the confirmation dialog. NOT nullable
  // for any USER_* / TRANSACTION_* / LISTING_* action; the service
  // enforces this at insert time.
  reason        String
  createdAt     DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// Free-form audit channel for ops to see and act on. Currently raised
// by the KYC service when a seller fails face-match 3+ times in a row —
// the next step is for an admin to call them or override the decision
// manually. `type` is a free string (e.g. "KYC_REPEATED_FAILURE") so
// new categories can be added without a schema change. `referenceId`
// is whatever the row is about (usually a User.id).
model AdminAlert {
  id          String    @id @default(cuid())
  type        String
  referenceId String?
  context     String?
  urgent      Boolean   @default(false)
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([resolved])
}

// Persisted record of every contact-detail filter block. Powers:
//   - command-center "fee bypass attempts (7d)" attention card
//   - /admin/trust-safety queue (grouped by user, with sample text)
//   - repeat-offender detection (≥N rejections in window → ban candidate)
//
// Stored even when we don't know the user (e.g. failed clerkId lookup)
// — userId nullable, sampleText capped at 200 chars to avoid storing
// the whole flagged note when a buyer pastes a long block.
//
// `channel` is a free string (offer-note, counter-note, rating-comment,
// future: message-content) so new wire-in sites don't need a migration.
// `category` mirrors the ContactDetailFilterService RejectCategory
// enum: phone | email | url | social-platform | off-platform-coordination | address.
model ContactDetailRejection {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel    String
  category   String
  sampleText String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([category])
}

model Rating {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  raterId       String
  rater         User        @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedId       String
  rated         User        @relation("RatingsReceived", fields: [ratedId], references: [id])
  stars         Int // 1–5
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([ratedId])
}

model Message {
  id              String      @id @default(cuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  senderClerkId   String
  content         String
  originalContent String? // populated when content was auto-stripped by moderation
  wasModerated    Boolean     @default(false)
  readAt          DateTime?
  createdAt       DateTime    @default(now())

  @@index([transactionId, createdAt])
}

model Offer {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User    @relation("BuyerOffers", fields: [buyerId], references: [id])

  offerAmount   Int // ZAR cents — buyer's initial offer
  counterAmount Int? // ZAR cents — seller's counter (one only)
  buyerNote     String?
  sellerNote    String?
  status        OfferStatus @default(PENDING)

  // buyer has 24h to respond to a counter
  expiresAt DateTime

  // link to transaction once CONVERTED
  transactionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId]) // one active offer per buyer per listing
  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Auction system — Bid + AuctionWatch
// ---------------------------------------------------------------------------

model Bid {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User    @relation("BidderBids", fields: [bidderId], references: [id])

  // Public visible bid amount in ZAR cents (what other users see in history).
  // The bidder's true max (proxy) is held separately and never exposed.
  amount    Int
  maxAmount Int // private — auto-bid ceiling

  // Snapshot of whether THIS bid won the auction once it ended.
  // Set by the end-auctions cron; null while auction is live.
  isWinner Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([bidderId])
}

model AuctionWatch {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
  @@index([userId])
}

// User ↔ Listing wishlist join. One row per saved listing. Cascade-
// deletes both sides so a removed user / listing cleans up without a
// background job. The compound unique stops accidental duplicates
// (the wishlist service relies on this for upsert semantics). The
// (userId, createdAt) index supports the "newest first" ordering on
// /wishlist without a sort.
//
// Naming: kept as "WatchedListing" rather than "WishlistEntry" so
// that future "X people watching this" social-proof rollups can
// .count() on the same table directly without renaming.
model WatchedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
}

// Browser / installed-PWA push subscription. Created when the user
// taps "Enable push notifications" → the browser calls
// pushManager.subscribe() and returns an endpoint URL + two crypto
// keys. We store one row per device per user.
//
// `endpoint` is globally unique (a per-device URL on the push
// gateway — FCM for Android Chrome / Mozilla autopush for Firefox /
// APNS for iOS Safari). Used as the upsert key so a single device
// can only have one active subscription per user.
//
// `category` array lets users mute one notification category without
// muting all of them (e.g., disable ACCOUNT push but keep BUYER /
// SELLER). Default = all three categories enabled.
//
// `lastUsedAt` is bumped each time we successfully push to this
// endpoint. A weekly cron prunes subscriptions where lastUsedAt is
// > 90 days old (the device probably uninstalled the PWA / cleared
// SW). Cascade-deletes with the user.
model PushSubscription {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String                 @unique
  p256dh     String
  auth       String
  userAgent  String?
  category   NotificationCategory[] @default([BUYER, SELLER, ACCOUNT])
  createdAt  DateTime               @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Raffles / Competitions (M5)
// ---------------------------------------------------------------------------

model Raffle {
  id              String  @id @default(cuid())
  // Human-trackable reference shown alongside the prize (RAxxxxxx).
  // Assigned at create-time the same way Listings are. Nullable for
  // back-fill compatibility.
  referenceNumber String? @unique

  title       String
  description String
  // LEGACY single-image URL — kept for back-compat reads. The new
  // multi-image flow writes to the RaffleImage relation below; the
  // public detail page reads `images[0]` as the cover.
  imageUrl    String?

  // Item being raffled. Item is platform-owned by default — sellers can
  // apply via RaffleSellerApplication, gated by the feature flag.
  itemSource     ItemSource @default(PLATFORM_OWNED)

  // Pricing model — three operator inputs:
  //   * itemValueCents   = the prize's selling price (what we'd list it at)
  //   * itemCostCents    = what we paid to acquire the prize
  //   * ticketPriceCents = per-ticket charge
  // targetTicketCount is auto-derived on create as
  //   ceil(itemValueCents / ticketPriceCents) — sell-out exactly covers
  // the prize price, anything beyond that is operator margin (margin =
  // itemValueCents - itemCostCents). Stored on the row so all the
  // downstream code that reads target (progress bar, sold-out trigger,
  // refund-all) keeps working without per-query division.
  itemValueCents     Int // selling price of the prize (ZAR cents)
  itemCostCents      Int @default(0) // what we paid for the prize
  ticketPriceCents   Int
  targetTicketCount  Int // derived = ceil(itemValueCents / ticketPriceCents)

  // Sold counts (cheap to read on the public detail page)
  ticketsSoldPaid   Int @default(0) // CONFIRMED tickets only
  ticketsSoldPostal Int @default(0) // POSTAL entries (free)

  // Multiple-choice question gate (CPA Section 36 game-of-skill leg).
  // Always 4 options; correct answer is ALWAYS C (operator decision —
  // simpler than tracking per-raffle correct-answer state). Buyers
  // can't progress to payment until they've answered, and the
  // backend rejects ticket purchases with answer != 'C'. Frontend
  // greys out the Pay button until any radio is picked.
  question  String
  optionA   String
  optionB   String
  optionC   String // ALWAYS the correct answer (hardcoded — see RafflesService)
  optionD   String

  // Timeline. End-time was dropped per operator request — raffles
  // run until all tickets sell out. Cooling-window draw still applies
  // (drawAt = ticketsSoldPaid+ticketsSoldPostal hits targetTicketCount + 24h).
  startTime     DateTime
  // 24h cooling window between sell-out and drawAt
  drawAt        DateTime?
  drawnAt       DateTime?
  // Claim window depends on tier — see /admin/competitions/create
  claimDeadline DateTime?

  // Status machine
  status RaffleStatus @default(DRAFT)

  // Draw verification
  drawSeed        String? // hex of crypto.randomBytes(32)
  drawSeedHash    String? // SHA-256 of drawSeed — published before draw if pre-commit used
  winningTicketId String?

  // Re-raffle lineage
  parentRaffleId   String?
  parent           Raffle?  @relation("ReRaffle", fields: [parentRaffleId], references: [id])
  children         Raffle[] @relation("ReRaffle")
  relistGeneration Int      @default(0) // 0 = original, 1 = first re-raffle, ...

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Phase E3 — Ask GG subscriber raffles. When set, this raffle is
  // exclusive to subscribers of that tier (e.g. MEMBER raffle is for
  // Members + Pros, PRO raffle is Pros only — the cron picks based
  // on User.subscriptionTier).
  //
  //   null   → standard public raffle (existing behaviour)
  //   MEMBER → Ask GG Member raffle: auto-entered free on create,
  //            48h auto-draw, prize value hidden on public surfaces
  //   PRO    → Ask GG Pro raffle: same but Pro-only
  //
  // itemValueCents + ticketPriceCents are conventionally set to 0
  // for subscriber raffles (operator sizes prize off-platform as
  // a % of subscription income). The hidePrizeValue flag is the
  // belt-and-braces UI guard against accidentally exposing a stale
  // value if the operator typed one. targetTicketCount is also 0
  // (auto-entry doesn't have a sell-out trigger; the 48h timer
  // drives draw scheduling instead).
  subscriberTierRestriction SubscriptionTier?
  // If true, every active subscriber of the matching tier gets a
  // free ticket auto-issued the moment the raffle goes ACTIVE.
  // Snapshot semantics: only users subscribed at that moment are
  // entered (later sign-ups don't get in this week).
  autoEnterSubscribers      Boolean           @default(false)
  // 48h-after-publish target for the auto-draw cron. Set when the
  // operator publishes a subscriber raffle. Standard public raffles
  // use the existing drawAt (sell-out + 24h cooling) instead.
  subscriberDrawAt          DateTime?
  // Belt-and-braces: even if a value was typed by mistake, hiding
  // it client-side keeps the "no fixed value" framing the operator
  // wants for subscriber raffles. Defaults true when the raffle is
  // a subscriber raffle.
  hidePrizeValue            Boolean           @default(false)

  tickets Ticket[]
  winners RaffleWinner[]
  events  RaffleAuditEvent[]
  images  RaffleImage[]

  @@index([status])
  @@index([drawAt])
  @@index([subscriberTierRestriction, subscriberDrawAt])
}

// Multi-image upload for raffles — mirrors ListingImage so the
// frontend can reuse the same upload + gallery components. First
// uploaded image becomes the cover (isPrimary). Cascade-deleted with
// the raffle. Cloudinary handles the actual files (folder: raffles/).
model RaffleImage {
  id        String   @id @default(cuid())
  raffleId  String
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([raffleId])
}

model Ticket {
  id String @id @default(cuid())

  raffleId String
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  // Paid tickets have buyerId + transactionId. Postal tickets have postalEntryId.
  buyerId String?
  buyer   User?   @relation(fields: [buyerId], references: [id])

  ticketNumber  Int // sequential within a raffle (1, 2, 3, …)
  referenceCode String @unique // 8-char alphanumeric reference, used on PDFs and postal forms

  status TicketStatus @default(PENDING_PAYMENT)

  // Payment reference (for refund/reconciliation)
  amountCents     Int       @default(0) // 0 for postal
  peachCheckoutId String?
  peachPaymentId  String?
  paidAt          DateTime?
  refundedAt      DateTime?

  // Postal-entry tie (set when status = POSTAL)
  postalEntryId String?
  postalEntry   PostalEntry? @relation(fields: [postalEntryId], references: [id])

  // ── Zoho Books linkage ────────────────────────────────────────────
  // When a buyer pays for N tickets in one Peach checkout, ONE Sales
  // Receipt is created in Books covering the batch. All N tickets in
  // that batch share the same zohoSalesReceiptId for traceability —
  // the sync logic dedupes by peachCheckoutId so we don't issue
  // multiple receipts for the same payment.
  // Postal tickets (amountCents = 0) skip Books entirely — no money
  // changed hands.
  zohoSalesReceiptId    String?
  zohoSyncStatus        String?
  zohoSyncError         String?
  zohoSyncLastAttemptAt DateTime?

  createdAt DateTime @default(now())

  @@index([raffleId, status])
  @@index([buyerId])
}

model RaffleWinner {
  id String @id @default(cuid())

  raffleId String
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  // The user who won (or null for postal winner — we contact via the postal entry).
  userId   String?
  user     User?   @relation("WinnerUser", fields: [userId], references: [id])
  ticketId String

  // 1 = primary, 2 = first backup, 3 = second backup
  position Int

  // Per-tier claim window (snapshot at draw time)
  claimDeadline DateTime
  claimedAt     DateTime?
  // FORFEITED when the claim window lapses without action
  forfeitedAt   DateTime?

  // Prize dispatch tracking. Set when an admin marks the prize as
  // dispatched via /admin/competitions/[id]. NULL until dispatched.
  // Order of events for the primary winner:
  //   1. position=1 row created on draw     → notify user
  //   2. user clicks Claim                   → claimedAt set
  //   3. admin courier-bundles the prize, then marks it dispatched
  //      via the admin dossier — this stamps all five fields below in
  //      one shot + sends the buyer their tracking info.
  // The Command-Center attention queue uses the index to surface
  // "claimed but not dispatched yet" winners as a TO-DO for admins.
  prizeDispatchedAt        DateTime?
  prizeTrackingRef         String?   // courier tracking number (Pudo / TCG / other)
  prizeCarrierLabel        String?   // 'Pudo' | 'The Courier Guy' | 'Aramex' | 'Other' (freeform)
  prizeDispatchedByAdminId String?   // AdminUser.id of who marked dispatched
  prizeDispatchNote        String?   // optional admin note (e.g. waybill #, condition)

  createdAt DateTime @default(now())

  @@unique([raffleId, position])
  @@index([raffleId])
  // Lets the Command Center attention queue fast-count "claimed but
  // not dispatched" winners with a single covered index lookup.
  @@index([prizeDispatchedAt])
}

model PostalEntry {
  id String @id @default(cuid())

  raffleId String

  // Reference code on the posted PDF form
  referenceCode String @unique

  // Free-text postal contact captured by admin from the envelope
  firstName String
  lastName  String
  phone     String?
  email     String?
  address   String?

  // Admin who keyed the entry
  enteredByAdminId String
  enteredAt        DateTime @default(now())

  tickets Ticket[]

  @@index([raffleId])
}

model RaffleSellerApplication {
  id String @id @default(cuid())

  applicantId String
  applicant   User   @relation(fields: [applicantId], references: [id])

  title          String
  description    String
  itemValueCents Int
  imageUrl       String?

  status    String  @default("PENDING") // PENDING / APPROVED / REJECTED
  adminNote String?

  reviewedByAdminId String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model RaffleAuditEvent {
  id       String @id @default(cuid())
  raffleId String
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  // e.g. CREATED, OPENED, TICKET_SOLD, POSTAL_ENTRY_ADDED, MIN_NOT_MET,
  // DRAW_RUN, WINNER_CLAIMED, WINNER_FORFEIT, BACKUP_PROMOTED, RELISTED, CANCELLED
  eventType String

  // Free-form payload — JSON string for forward-compat (Prisma 7 native JSON
  // varies per adapter; we keep a string to avoid surprises).
  payloadJson String?

  actorUserId  String?
  actorAdminId String?

  createdAt DateTime @default(now())

  @@index([raffleId, createdAt])
  @@index([eventType])
}

// Single-row settings table for feature flags + global config.
// Looked up by key. Values are strings (parse as needed).
// PAYMENT_MODE = 'manual' (FNB EFT) | 'paygate' (Stitch, dormant) lives here.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Manual EFT payments (no live card gateway) ────────────────────────
// Every incoming-payment signal we observe — whether a fast FNB
// inContact email alert (provisional) or a row from the daily FNB
// statement CSV (authoritative) — is logged here, deduped by
// externalId, and matched to a Transaction by orderReference + amount.
// Unmatched rows form the admin investigation queue.
enum ManualPaymentSource {
  INCONTACT // parsed from an FNB inContact email alert
  STATEMENT // parsed from an uploaded FNB statement CSV row
}

enum ManualPaymentStatus {
  MATCHED // bound to exactly one Transaction by ref + amount
  UNMATCHED // no order matched — needs admin allocation/refund
  AMBIGUOUS // ref matched but amount differs, or >1 candidate — admin
  REVERSED // a prior provisional match was undone (e.g. statement disproved it)
}

model ManualPayment {
  id         String              @id @default(cuid())
  source     ManualPaymentSource
  // Dedupe key: the email Message-ID for inContact, or a stable hash of
  // (statementUploadId + row) for statement rows, so re-scanning the
  // inbox or re-uploading a statement never double-processes a payment.
  externalId String              @unique
  rawText    String              @db.Text
  amountCents Int
  reference  String? // parsed buyer reference, trimmed/uppercased
  paidAt     DateTime? // value date/time from the alert or statement
  status     ManualPaymentStatus @default(UNMATCHED)

  matchedTransactionId String?
  matchedTransaction   Transaction? @relation(fields: [matchedTransactionId], references: [id])

  note      String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([reference])
}

// One row per admin upload of an FNB statement CSV — an audit trail of
// the daily reconciliation runs (who uploaded what, how much matched).
model StatementUpload {
  id             String   @id @default(cuid())
  filename       String
  uploadedById   String?
  rowCount       Int      @default(0)
  creditRowCount Int      @default(0)
  matchedCount   Int      @default(0)
  unmatchedCount Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Atomic counter for per-prefix reference numbers (UM / AU / TS / RA).
// Used by ListingsService + RafflesService to allocate the next number
// at create time. Increment is done via Prisma's atomic { increment: 1 }
// inside an upsert so concurrent creates don't collide on the same
// number. One row per prefix; created on first allocation.
model ReferenceCounter {
  prefix    String   @id // 'UM' | 'AU' | 'TS' | 'RA'
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Outbound SMS audit log — every send (whether real, stubbed, or
// failed) writes a row here. We use it for debugging delivery issues
// and to prove a verification code was actually dispatched. Each row
// is tied to a free-text reference (e.g. "phone-change-USERID") so we
// can group all attempts for a single flow.
model SmsLog {
  id        String   @id @default(cuid())
  to        String // E.164-normalised destination ("+27...")
  message   String
  reference String?
  status    String // 'SENT' | 'FAILED' | 'STUB'
  messageId String? // SMSPortal's id, when available
  error     String?
  createdAt DateTime @default(now())

  @@index([reference])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Featured-slot system (paid left-rail placement)
//
// 10 hard-allocated slots rotate via per-slot auctions. Each slot has:
//   - A current occupant (a listing + seller + featuredUntil) when filled
//   - A pre-auction that opens 24h before the occupant's featuredUntil,
//     closes at featuredUntil sharp, winner takes over with zero gap
//   - An ad-hoc 2h auction if the slot frees unexpectedly (occupant's
//     listing sold mid-feature, or admin force-evicted)
//
// Seller flow: bid first → win → 15-min bind window to pick an active
// listing → Peach charged → listing goes featured for the tier duration.
// Losers walk away (no rollover). One seller can hold multiple slots.
// ---------------------------------------------------------------------------

model FeaturedSlot {
  id String @id @default(cuid())

  // 1-10. Hard-allocated at seed. The rail's vertical order matches this.
  slotNumber Int @unique

  status FeaturedSlotStatus @default(VACANT)

  // The listing currently displayed in this slot (null when VACANT or
  // AUCTION_RUNNING or BIND_WINDOW with the winner not yet bound).
  currentListingId String?  @unique
  currentListing   Listing? @relation("FeaturedSlotListing", fields: [currentListingId], references: [id])

  // Quick-lookup denormalisation — the seller who owns the current
  // listing. Also used to enforce "can't bid on a slot you own".
  currentSellerId String?
  currentSeller   User?   @relation("FeaturedSlotOccupant", fields: [currentSellerId], references: [id])

  // When the current occupant's featured time ends. Cron tick promotes
  // the next auction's winner at this exact moment.
  featuredUntil DateTime?

  // Auction tracking. `currentAuctionId` is the auction that's either
  // OPEN now (pre-auction or ad-hoc) or recently closed and in the
  // BIND_WINDOW phase. Cron creates new auctions as slots free up.
  currentAuctionId String?            @unique
  currentAuction   FeaturedAuction?   @relation("SlotCurrentAuction", fields: [currentAuctionId], references: [id])
  auctions         FeaturedAuction[]  @relation("SlotAuctions")
  events           FeaturedSlotAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featuredUntil])
}

model FeaturedAuction {
  id String @id @default(cuid())

  slotId String
  slot   FeaturedSlot @relation("SlotAuctions", fields: [slotId], references: [id], onDelete: Cascade)

  // The back-relation for FeaturedSlot.currentAuction (1:1 to a single
  // auction at any time). Listed without fields so Prisma can wire it.
  slotAsCurrent FeaturedSlot? @relation("SlotCurrentAuction")

  kind   FeaturedAuctionKind
  status FeaturedAuctionStatus @default(OPEN)

  // The auction OPENS the moment the slot becomes vacant (closesAt
  // null = waiting for first bid). On the first bid, the bid handler
  // sets closesAt = now + bidWindowSec (24h by default). Subsequent
  // bids during the window do NOT reset it — the winner is whoever
  // has the highest bid when the timer hits zero.
  openedAt DateTime  @default(now())
  closesAt DateTime?
  closedAt DateTime?

  // Snapshot of the winning bid once closed. Null while OPEN.
  winningBidId String?          @unique
  winningBid   FeaturedSlotBid? @relation("AuctionWinningBid", fields: [winningBidId], references: [id])

  bids FeaturedSlotBid[] @relation("AuctionBids")

  @@index([slotId, status])
  @@index([closesAt])
}

model FeaturedSlotBid {
  id String @id @default(cuid())

  auctionId String
  auction   FeaturedAuction @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)

  bidderId String
  bidder   User   @relation("FeaturedSlotBidder", fields: [bidderId], references: [id])

  // ZAR cents. Backend snaps to nearest tier on submit. This is the
  // FACE bid — what the bidder is "saying" they'd pay, and what the
  // leaderboard uses for ranking. The actual cents collected is
  // `chargedAmountCents` (set at charge time).
  amountCents Int
  tier        FeaturedTier

  // Phase E2 — Ask GG subscription perk (OD1 locked).
  //   FREE   → 0  (full price)
  //   MEMBER → 25 (25% off the slot fee)
  //   PRO    → 50 (50% off the slot fee)
  // Snapshotted on the bid at bid time so the discount can't be
  // gamed by upgrading right before settlement OR penalised by a
  // downgrade between bid + bind. Charged cents = floor(
  // amountCents * (100 - discountPercent) / 100).
  discountPercent     Int @default(0)
  // Actual ZAR cents Peach charged. Null until the bid wins + binds.
  // Once set, Zoho receipt + admin revenue reports use this value
  // (NOT amountCents) so the books match the cash that landed.
  chargedAmountCents  Int?

  status FeaturedBidStatus @default(ACTIVE)

  // Set when the bid wins + Peach is charged (= COMMITTED). Lets admin
  // refund cleanly via the Peach payment ID.
  peachPaymentId String?
  paidAt         DateTime?

  // If the winner doesn't bind a listing within the 15-min bind window
  // we cascade to the next-highest bid. `cascadedFromId` records the
  // forfeited bid we replaced. Read-only audit trail.
  cascadedFromId String?  @unique
  cascadedFrom   FeaturedSlotBid? @relation("BidCascade", fields: [cascadedFromId], references: [id])
  cascadedTo     FeaturedSlotBid? @relation("BidCascade")

  // Back-relation for FeaturedAuction.winningBid.
  wonAuction FeaturedAuction? @relation("AuctionWinningBid")

  // ── Zoho Books linkage ────────────────────────────────────────────
  // Featured-slot fee invoice (Gun Galore → winning bidder) created
  // when the bid wins + Peach captures payment. Only set on winning
  // bids that actually paid (status = COMMITTED + paidAt set).
  zohoInvoiceId         String?
  zohoSyncStatus        String?
  zohoSyncError         String?
  zohoSyncLastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId, amountCents])
  @@index([bidderId, status])
}

// Operator-editable configuration so tier prices + durations + bid floor
// can change WITHOUT a code deploy. Singleton row (id="default" always).
// Admin Settings tab writes through.
model FeaturedSlotConfig {
  id String @id @default("default")

  // Number of slots — default 10. Changing this needs a follow-up
  // migration to add/remove FeaturedSlot rows; UI gates the change
  // behind a confirm dialog.
  slotCount Int @default(10)

  // Bid floor in ZAR cents. Default 10000 (R100).
  bidFloorCents Int @default(10000)

  // Tier amounts in ZAR cents + duration in seconds. Five tiers, all
  // editable. Defaults match the agreed table:
  //   T1 R100 = 86400s   (1d)
  //   T2 R200 = 172800s  (2d)
  //   T3 R300 = 432000s  (5d)
  //   T4 R400 = 604800s  (7d)
  //   T5 R500 = 1209600s (14d)
  t1AmountCents Int @default(10000)
  t1DurationSec Int @default(86400)
  t2AmountCents Int @default(20000)
  t2DurationSec Int @default(172800)
  t3AmountCents Int @default(30000)
  t3DurationSec Int @default(432000)
  t4AmountCents Int @default(40000)
  t4DurationSec Int @default(604800)
  t5AmountCents Int @default(50000)
  t5DurationSec Int @default(1209600)

  // How long the auction stays open AFTER the first bid lands. The
  // auction itself opens the moment the slot becomes vacant, but
  // sits at closesAt=null (waiting for a first bid). When the first
  // bid lands, closesAt is set to now + bidWindowSec. Subsequent
  // bids during the window don't reset it.
  bidWindowSec Int @default(86400) // 24h

  // 15-min bind window the winner has to pick a listing.
  bindWindowSec Int @default(900)

  updatedAt   DateTime @updatedAt
  updatedByAdminId String?
}

// Admin can permanently bar a user from bidding on featured slots
// (e.g. spam, payment-default repeat offender, abuse). Separate from
// the listing-side `isBanned` flag so featured-slot bans don't kill
// the user's whole account.
model FeaturedSlotBidderBan {
  id        String   @id @default(cuid())
  userId    String   @unique
  reason    String
  bannedByAdminId String
  createdAt DateTime @default(now())
}

// Audit log — every featured-slot event. Lets the operator answer
// "who got that slot at 14:32 yesterday and how much did they pay?"
// without leaving the admin panel.
//
// Event types (free-text for forward-compat):
//   AUCTION_OPENED, BID_PLACED, AUCTION_CLOSED, BIND_WINDOW_OPENED,
//   LISTING_BOUND, BIND_WINDOW_EXPIRED, CASCADED_TO_RUNNER_UP,
//   FEATURED_LIVE, FEATURED_EXPIRED, LISTING_SOLD_FREES_SLOT,
//   FORCE_EVICTED, MANUALLY_AWARDED, REFUND_ISSUED, CONFIG_CHANGED,
//   BIDDER_BANNED, BIDDER_UNBANNED
model FeaturedSlotAuditEvent {
  id       String @id @default(cuid())
  slotId   String?
  slot     FeaturedSlot? @relation(fields: [slotId], references: [id])

  eventType String
  payloadJson String? // JSON-encoded payload; freeform per eventType

  // Who fired this. EITHER a user (bidder action) OR an admin
  // (override action). System cron events have both null.
  actorUserId  String?
  actorAdminId String?

  createdAt DateTime @default(now())

  @@index([slotId, createdAt])
  @@index([eventType, createdAt])
}

// =====================================================================
// ActionToken — single-use, scoped tokens for SMS-link action pages
// =====================================================================
// Powers the /a/<token> pages: a buyer or seller gets an SMS with a
// short link, taps it, and lands on a public page (no sign-in) that
// lets them do exactly ONE thing — accept an offer, place a bid, pay
// for an item they won, etc.
//
// Security model:
//   - Token is 16 bytes of cryptographic random (128-bit), base64url
//     encoded (~22 chars in the URL).
//   - Each token is scoped to ONE action on ONE entity. An "accept
//     offer" token can ONLY accept that one offer — it can't reject
//     it, can't access other offers, can't read profile, can't act on
//     other transactions.
//   - One-time consume for mutating actions. Tokens for read-only or
//     multi-load surfaces (e.g. CHECKOUT, where the user loads the
//     page, fills in shipping, then submits payment) stay valid until
//     the "terminal" action consumes them — for checkout that's the
//     POST /transactions call.
//   - Expiry = the underlying decision window. Offers expire in 24h
//     so offer-decision tokens expire then too. Auction-bid tokens
//     expire at the auction's endTime (auto-extends on snipe).
//   - Brute-force lock: invalidAttempts >= 5 → token permanently dead
//     even if not yet used. Prevents guessing valid tokens.
//
// Purposes:
//   OFFER_DECISION   — seller decides on a fresh offer (accept/reject/counter)
//   COUNTER_DECISION — buyer decides on seller's counter (accept/reject/counter-back)
//   AUCTION_BID      — buyer raises bid after being outbid (single or auto-bid)
//   CHECKOUT         — buyer pays for accepted offer / auction win / BUY_NOW
//                      (wider read scope: loads user address/phone for pre-fill)
model ActionToken {
  id    String @id @default(cuid())
  token String @unique // base64url(16 bytes random) — ~22 chars

  // What this token authorises. See enum comment above for valid values.
  // Plain string (not Prisma enum) so we can add purposes without a
  // schema migration each time.
  purpose String

  // What the token acts on. targetType is a model name in lowercase:
  // 'offer' | 'listing' | 'transaction'. targetId is that record's id.
  targetType String
  targetId   String

  // Who the token authorises — when consumed, the underlying service
  // call runs AS this user. Always a real Gun Galore user; never an
  // anonymous session.
  authorisedUserId String
  authorisedUser   User   @relation("ActionTokensAuthorised", fields: [authorisedUserId], references: [id], onDelete: Cascade)

  // Optional metadata for the action — e.g. for CHECKOUT we might
  // store the listing's price snapshot at SMS send time so a price
  // change between SMS and click can be detected. Free-form JSON.
  metadataJson String?

  expiresAt DateTime
  usedAt    DateTime?

  // Failed resolution attempts — incremented on invalid/expired/locked
  // POST attempts. Once >= 5 the token is permanently dead (even if
  // it hadn't been used yet). Stops guess attacks.
  invalidAttempts Int @default(0)

  // Audit linkage — once the token is consumed, store the IP +
  // user-agent of the consuming request for the admin audit trail.
  consumedFromIp        String?
  consumedFromUserAgent String?

  createdAt DateTime @default(now())

  @@index([authorisedUserId, expiresAt])
  @@index([targetType, targetId])
  @@index([expiresAt])
}

// =====================================================================
// External-service credit monitoring
// =====================================================================
// Gun Galore depends on several paid external services (SMSPortal for
// OTPs, VerifyNow for KYC, Cloudinary for media, Anthropic for the
// listing-review agent, Pudo for shipping). Each of those bills against
// a per-account credit/balance pool — if any of them runs dry mid-flow
// the user-facing experience silently breaks (OTP never arrives, KYC
// hangs, image upload returns a 4xx, etc).
//
// The cron in TasksService.pollCreditBalances() polls every service
// every 15 minutes and stores one row here per service per poll. The
// /admin/credits page reads this table to render the live grid + the
// 30-day trend chart per service. Threshold-breach alerts are driven
// by the CreditThreshold table below and dedup'd by lastWarn/Alarm
// timestamps so we don't spam the operator.
//
// `balance` is the primary numeric metric — credits remaining (SMS,
// KYC), rand remaining (VerifyNow ZAR balance), credit units
// (Cloudinary), USD spend over the trailing 24h (Anthropic — note this
// is SPEND not BALANCE, so the threshold logic is inverted). `unit`
// stores the human-readable unit string. Service-specific extras
// (storage GB, transformations used, etc) go in `metadata` so we can
// add new dimensions without a schema migration.
//
// `error` is populated when the fetch fails — the row still gets
// written so the admin trend chart shows a gap rather than a silent
// drop. `balance` is NULL on error.
model CreditSnapshot {
  id        String   @id @default(cuid())
  // Service identifier — matches the `service` column in CreditThreshold.
  // String (not enum) so adding a new service doesn't need a migration.
  // Known values: 'smsportal' | 'verifynow' | 'cloudinary' | 'anthropic' | 'pudo'
  service   String
  balance   Float? // primary numeric metric; NULL when the fetch failed
  unit      String? // 'sms' | 'lookup' | 'ZAR' | 'USD' | 'credits' | 'GB'
  metadata  Json? // service-specific extras (raw response, storage, etc)
  fetchedAt DateTime @default(now())
  error     String? // populated when the fetch failed — for debugging

  // Compound index supports the per-service trend chart query
  // (WHERE service = X ORDER BY fetchedAt DESC LIMIT ...).
  @@index([service, fetchedAt])
}

// Operator-configurable thresholds per service. The poll cron checks
// each snapshot against the threshold for that service: if balance
// drops below warnThreshold the operator gets an email; below
// alarmThreshold both email + SMS fire. Both alerts dedup on a 6h
// window via lastWarnAlertAt / lastAlarmAlertAt so a balance hovering
// just under the threshold doesn't spam.
//
// `enabled = false` short-circuits the check entirely — useful when
// the operator knows credits are temporarily low and doesn't want to
// be paged about it.
model CreditThreshold {
  id               String    @id @default(cuid())
  service          String    @unique // FK by convention to CreditSnapshot.service
  warnThreshold    Float? // amber alert — email only
  alarmThreshold   Float? // red alert — email + SMS
  lastWarnAlertAt  DateTime? // dedup so warn doesn't fire more than once per 6h
  lastAlarmAlertAt DateTime? // dedup so alarm doesn't fire more than once per 6h
  enabled          Boolean   @default(true)
  updatedAt        DateTime  @updatedAt
}

// =====================================================================
// Ask GG — AI assistant subscription
// =====================================================================
// Sister product to the M1-M5 marketplace. Paid AI chat assistant
// with photo identification, knowledge base, reloading-data lookups,
// ballistic calculators, renewal reminders. See the Ask GG plan
// file at C:\Users\gerha\.claude\plans\zesty-forging-stardust.md
// for the full spec + phasing.
//
// Phase A (current) scope:
//   - SubscriptionTier on User (FREE / MEMBER / PRO)
//   - Subscription + SubscriptionCharge models (billing rail, only
//     wires up once Peach card-tokenisation lands)
//   - Conversations + messages + per-message cost tracking
//   - KB entries + per-day usage rollup
// Models exist now even where their full lifecycle (billing,
// KB-verification, embedding search) is built in later drops —
// keeps the schema migrations single + future-proof.

enum SubscriptionTier {
  FREE
  MEMBER
  PRO
}

enum SubscriptionPaymentStatus {
  ACTIVE       // current period valid, will auto-renew at currentPeriodEnd
  PAST_DUE     // last charge failed; in retry window
  SUSPENDED    // 3rd retry failed; tier downgraded to FREE pending payment update
  CANCELLED    // user-initiated cancel; remains valid until currentPeriodEnd
}

enum AskGgConversationOutcome {
  UNRESOLVED   // default; user hasn't responded to the "did this solve it?" prompt
  RESOLVED     // user marked the conversation as helpful — eligible for KB
  ABANDONED    // user marked unhelpful or never returned
}

enum AskGgKbStatus {
  DRAFT        // auto-created from a RESOLVED conversation, awaiting admin review
  SUBMITTED    // user-edited a draft and re-submitted for admin attention
  VERIFIED     // admin approved — surfaces in search results first
  ARCHIVED     // soft-deleted; admin can resurrect
}

// Subscription billing record. ONE row per User; the user's tier
// lives on User.subscriptionTier as the hot-path read. This model
// tracks the recurring-billing lifecycle (period boundaries, retry
// state, Peach customer linkage).
//
// During Phase A (pre-Peach-tokenisation) the row is created only
// by admin grants (subscriptionTier change in /admin/users/[id]
// writes both User.subscriptionTier AND this row). When Peach
// recurring billing lands, POST /subscriptions creates this row
// post-checkout and the daily billing cron advances the period.
model Subscription {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               SubscriptionTier
  status             SubscriptionPaymentStatus @default(ACTIVE)
  billingCycle       String                    // 'monthly' | 'annual' | 'comp' (admin grant, no billing)
  amountCents        Int                       // ZAR cents per cycle. 0 for comp accounts.
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean                   @default(false)
  // Peach vault ID for recurring charges. NULL for comp accounts +
  // pre-Peach-tokenisation grants. Mirrored from User.peachCustomerId
  // at signup so the cron doesn't need to JOIN.
  peachCustomerId    String?
  // Zoho Books customer ID for invoice / receipt linkage. Lazy-
  // created on first successful charge. Same pattern as
  // User.zohoContactId for marketplace transactions.
  zohoCustomerId     String?
  lastChargeAt       DateTime?
  failedChargeCount  Int                       @default(0)
  // Optional fields surfaced in Pro-tier business receipts (Phase E).
  businessName       String?
  vatNumber          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  charges            SubscriptionCharge[]

  // Index supports the daily billing cron:
  // "WHERE status = ACTIVE AND currentPeriodEnd <= now AND
  //  cancelAtPeriodEnd = false"
  @@index([status, currentPeriodEnd])
}

// One row per recurring charge attempt (success or failure). Drives
// the billing-history page on /subscriptions + admin spend audit.
model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         String       // 'PENDING' | 'SUCCEEDED' | 'FAILED' | 'REFUNDED'
  peachPaymentId String?
  zohoReceiptId  String?
  errorMessage   String?
  attemptCount   Int          @default(1)
  chargedAt      DateTime     @default(now())

  @@index([subscriptionId, chargedAt(sort: Desc)])
}

// A single Ask GG chat thread. Most users will have many.
//
// `title` is the first user message truncated to 80 chars (auto-set
// on create; never edited). Conversation history page renders by
// title for fast scanning.
//
// `outcome` flips when the user responds to the post-assistant
// "did this solve it?" prompt. RESOLVED conversations become
// AskGgKbEntry DRAFT rows automatically (Phase C wiring).
//
// `resolvedByMatch` is set when the conversation was answered by
// surfacing a KB hit (no Claude call fired). Powers the per-day
// cost dashboard's "KB-vs-Claude split" chart.
model AskGgConversation {
  id              String                   @id @default(cuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  outcome         AskGgConversationOutcome @default(UNRESOLVED)
  resolvedAt      DateTime?
  resolvedByMatch String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  messages        AskGgMessage[]
  kbEntry         AskGgKbEntry?

  @@index([userId, updatedAt(sort: Desc)])
}

// One row per message in a conversation. Both user + assistant turns
// land here so the full history is replayable.
//
// `imageUrls` is populated for vision messages (Phase B). Up to 5
// Cloudinary URLs per message, matching MAX_VISION_PHOTOS in the
// existing listing-moderation pattern.
//
// Token + cost columns make per-user spend visibility cheap —
// something the existing Claude services (moderation, dealer
// verification) don't track today.
model AskGgMessage {
  id               String            @id @default(cuid())
  conversationId   String
  conversation     AskGgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String            // 'user' | 'assistant' | 'system'
  content          String
  imageUrls        String[]
  model            String?           // 'claude-sonnet-4-6', 'claude-haiku-4-5-…', for cost audit
  promptTokens     Int?
  completionTokens Int?
  costUsd          Float?
  // Citations: Json array of reloading-manual fetches Claude did
  // while answering. Each entry: { manualId, manufacturer, title,
  // edition, pages }. Rendered as chips below the assistant message
  // so the user can verify against the source PDF.
  citations        Json?
  createdAt        DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// Knowledge base entry. Created automatically when a conversation
// is marked RESOLVED (Phase C wiring); curated + verified by admin.
// VERIFIED entries surface first in the search-first flow so future
// users with similar questions get cached answers instead of fresh
// Claude calls — cost per question decreases as the KB matures.
//
// `embedding` is a pgvector column for cosine-similarity search
// (Phase C). NULL for now; backfilled when embeddings infrastructure
// lands.
model AskGgKbEntry {
  id                   String             @id @default(cuid())
  sourceConversationId String?            @unique
  sourceConversation   AskGgConversation? @relation(fields: [sourceConversationId], references: [id])
  authorId             String
  author               User               @relation("KbAuthor", fields: [authorId], references: [id])
  title                String
  question             String
  answer               String
  category             String?
  tags                 String[]
  status               AskGgKbStatus      @default(DRAFT)
  verifiedById         String?
  verifiedAt           DateTime?
  usefulCount          Int                @default(0)
  surfacedCount        Int                @default(0)
  embedding            Bytes?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, verifiedAt(sort: Desc)])
  @@index([category])
}

// Per-user-per-day usage rollup. Powers free-tier caps (5 photo
// IDs + 5 messages per rolling 30 days) and Member/Pro fair-use
// rate caps (admin-configurable via SettingsService).
//
// One row per user per UTC day. Bumped synchronously on message
// send + photo identification. Queries aggregate over date ranges
// to enforce caps + drive the admin usage dashboard.
model AskGgUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          DateTime // truncated to date (00:00 UTC) on write
  messageCount Int      @default(0)
  photoIdCount Int      @default(0)
  costUsdCents Int      @default(0)

  @@unique([userId, day])
  @@index([day])
}

// =====================================================================
// Reloading manuals — Phase D PDF-RAG source-of-truth
// =====================================================================
// Operator uploads commercial reloading manuals (Hodgdon Annual,
// Lyman Handbook, Hornady, Accurate, Vihtavuori, IMR, Alliant). The
// pipeline extracts each page's text on upload so we can full-text
// search across all manuals at query time.
//
// Runtime flow when a user asks a reloading question:
//   1. Claude (in Ask GG) calls tool searchReloadingManuals({query})
//      → Postgres FTS across ReloadingManualPage.extractedText
//      → returns top hits {manualId, pageNumber, snippet}
//   2. Claude picks the best hit, calls fetchManualPages({manualId,
//      pages: [N-1, N, N+1]}) → pdf-lib slices those pages from the
//      stored PDF → returned as a base64 document content block
//   3. Claude reads the actual page in its next turn, composes a
//      natural-language answer with explicit citation:
//      "Per Hodgdon Annual Manual (p.145): max load of 168gr SMK with
//       H4350 is XX.Xgr at YYYY fps. Start at ZZ.Zgr and work up."
//
// Numbers ALWAYS come from a verified manual; never from training
// data. The "verification" is implicit — Claude reads the original
// page on every query, not a transcribed copy.

enum ReloadingManualStatus {
  PROCESSING // upload finished, pdf-parse running
  ACTIVE     // text extracted + indexed, queryable by Ask GG
  ARCHIVED   // hidden from new queries (replaced by newer edition)
  FAILED     // pdf-parse threw; admin can retry or delete
}

model ReloadingManual {
  id              String                @id @default(cuid())
  manufacturer    String                // "Hodgdon" / "Vihtavuori" / etc.
  title           String                // "Annual Manual" / "Reloading Handbook"
  edition         String?               // "2024" / "49th Edition" — optional
  // Relative path under RELOADING_STORAGE_DIR (env, default
  // ./uploads/reloading-manuals). Filename is a random hex string so
  // a directory listing leak doesn't reveal which manuals we hold.
  // PDFs are read by the backend (pdf-lib slicing for Ask GG) and
  // served through the authenticated download route — never exposed
  // via a public URL.
  storedPath      String                @unique
  fileSizeBytes   Int
  pageCount       Int                   @default(0)
  status          ReloadingManualStatus @default(PROCESSING)
  // Admin who triggered the inbox scan that ingested this manual.
  // FK to AdminUser (separate table from regular User) — admin JWT
  // payloads carry AdminUser.id as `sub`, not a User.id.
  uploadedByAdminId String
  uploadedByAdmin   AdminUser           @relation("ReloadingUploader", fields: [uploadedByAdminId], references: [id])
  errorMessage    String?               // populated when status = FAILED
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  pages           ReloadingManualPage[]

  @@index([status, manufacturer])
}

// NOTE on the FTS index — there is a Postgres `textTsv tsvector`
// GENERATED ALWAYS AS column + GIN index on this table that we
// manage OUTSIDE Prisma (see ReloadingService.onModuleInit). We don't
// declare it here because Prisma fights GENERATED columns: declaring
// it as Unsupported still triggers ALTER attempts that Postgres
// rejects, and not declaring it triggers DROP attempts on `db push`.
//
// Operational rule: if `prisma db push` warns about dropping `textTsv`,
// it's safe to accept the drop — onModuleInit re-adds the column +
// index at next backend restart, and Postgres immediately re-populates
// the GENERATED tsvector from the existing `extractedText` values.
// No data loss, no manual reindex.
model ReloadingManualPage {
  id            String          @id @default(cuid())
  manualId      String
  manual        ReloadingManual @relation(fields: [manualId], references: [id], onDelete: Cascade)
  pageNumber    Int             // 1-indexed; matches printed manual pagination
  extractedText String          @db.Text
  createdAt     DateTime        @default(now())

  @@unique([manualId, pageNumber])
  @@index([manualId, pageNumber])
}

// ─── Hunt Ballistics — RangeEstimate ─────────────────────────────────
// One row per AI camera-ranging request from the Hunt Ballistics iOS
// app (POST /hunt-ballistics/estimate-range). Persisted for the future
// map-plot feature: the user will see where shots were taken from +
// where the target was, computed from shooter GPS + compass heading +
// AI range.
//
// PRIVACY: we do NOT store the photo itself, only its metadata + the
// AI result. If we later want to re-train against ground-truth ranges,
// we'd add a separate opt-in mechanism (with explicit user consent
// per submission).
//
// IDENTITY: Hunt Ballistics uses anonymous per-device UUIDs (X-Device-Id
// header), not Clerk. There's no FK to User here on purpose — the iOS
// app is a different product surface from the gun-galore marketplace.
// =====================================================================
// HUNT BALLISTICS — INFO CENTRE (Phase 2.5)
// =====================================================================
// In-app knowledge base. The operator curates a library of hunting
// reference PDFs (species guides, cartridge data, regulations, theory
// books) outside this server — PDFs live on the operator's local
// machine for copyright + privacy reasons. We persist only the
// extracted text per page, plus an optional rendered page image when
// the visual layout matters (diagrams, tables).
//
// Mirrors the ReloadingManual pattern (Postgres FTS via tsvector +
// GIN index, websearch_to_tsquery) but DELIBERATELY does NOT store
// the source PDF — never serve the operator's copyrighted reference
// material from our infrastructure.
//
// Runtime flow:
//   1. Operator drops PDFs locally; Claude Code reads them via the
//      Read tool (Max-plan covered), extracts text per page, optional
//      page renders, POSTs to /admin/hunt-pdfs/import.
//   2. App searches via /info-centre/search?q=... — text snippets
//      with PDF title + page number + ts_rank ordering.
//   3. App reads via /info-centre/pdf/:id/page/:n — page text +
//      optional rendered image.

enum HuntPdfCategory {
  SPECIES_GUIDE        // field guides for SA / African wildlife
  CARTRIDGE_DATA       // ammo data sheets, factory load tables
  REGULATIONS          // hunting regs per province / country
  BALLISTICS_THEORY    // wind, drag, exterior ballistics theory
  HUNTING_TECHNIQUE    // stalking, calling, field-care
  FLORA_REFERENCE      // SA vegetation references (Trees of S Africa, etc.)
  GENERAL              // catch-all for anything else
}

enum HuntPdfStatus {
  DRAFT      // imported but not visible to users yet
  ACTIVE     // searchable + readable in the iOS app
  ARCHIVED   // hidden from new queries (older edition, superseded)
}

model HuntPdf {
  id           String           @id @default(cuid())
  title        String           // "Trees of Southern Africa"
  author       String?          // "van Wyk & van Wyk" — optional
  edition      String?          // "3rd Edition (2018)" — optional
  publisher    String?          // "Struik Nature" — optional
  publishedYear Int?            // 2018
  category     HuntPdfCategory  @default(GENERAL)
  language     String           @default("en")   // BCP47: en, af, en+af
  pageCount    Int              @default(0)
  status       HuntPdfStatus    @default(DRAFT)
  // Short description shown in browse + search result cards.
  blurb        String?          @db.Text
  // Display order within a category — lower sorts first. Defaults to 100
  // so the operator can prepend a "featured" entry by setting it to 0-50.
  sortOrder    Int              @default(100)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  pages        HuntPdfPage[]

  @@index([status, category, sortOrder])
}

// NOTE on the FTS index — same pattern as ReloadingManualPage. A
// Postgres `textTsv tsvector` GENERATED ALWAYS AS column + GIN index
// is added by HuntPdfService.onModuleInit and NOT declared here
// because Prisma fights GENERATED columns. If `prisma db push` warns
// about dropping `textTsv`, it's safe to accept — onModuleInit
// re-adds the column + index at next backend restart.
model HuntPdfPage {
  id           String   @id @default(cuid())
  pdfId        String
  pdf          HuntPdf  @relation(fields: [pdfId], references: [id], onDelete: Cascade)
  pageNumber   Int      // 1-indexed; matches printed pagination
  text         String   @db.Text
  // Optional rendered page as base64 PNG. Only populated for pages
  // where visual layout matters (diagrams, anatomy plates, tables).
  // Most pages are text-only; this stays null and saves storage.
  imageBase64  String?  @db.Text
  // Mime type of imageBase64 when present — default png.
  imageMime    String?
  createdAt    DateTime @default(now())

  @@unique([pdfId, pageNumber])
  @@index([pdfId, pageNumber])
}

model RangeEstimate {
  id               String   @id @default(cuid())

  // Identity — anonymous per-device UUID from the iOS app
  deviceId         String

  // Geo at capture time — for the future map-plot feature
  lat              Float?   // GPS latitude (-90..90), null if location denied
  lng              Float?   // GPS longitude (-180..180)
  headingDeg       Float?   // compass bearing 0..360 (direction phone was pointing)
  tiltDeg          Float?   // inclinometer pitch -89..89 (negative = downhill)

  // AI result
  rangeM           Float    // estimated range in metres (already rounded server-side)
  confidence       Float    // 0..1 self-assessed by Claude
  species          String?  // identified subject if Claude is sure
  notes            String?  @db.Text  // Claude's reasoning trace
  modelUsed        String   // 'sonnet' | 'opus' — Opus = fallback fired

  // Audit + cost tracking
  biomeId          String?  // matched SA biome id (sa-biomes.ts), null if outside coverage
  regionCode       String?  // ISO 3166-1 alpha-2 (usually 'ZA')
  costUsd          Decimal? @db.Decimal(10, 6)   // total across all passes
  promptTokens     Int?     // sum of input tokens (Sonnet + Opus if escalated)
  completionTokens Int?     // sum of output tokens

  createdAt        DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([biomeId, createdAt])
}
