// Gun Galore — Prisma schema (Prisma 7).
// URL is in prisma.config.ts (Prisma 7 requirement — not in schema).
// Run:  npx prisma migrate dev --name <description>
// See CLAUDE.md for the full data model built up phase by phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  // Legacy tier — kept so existing rows don't break. Treat as
  // MONITORING_ADMIN going forward (read-only).
  ADMIN
  // Top tier — can create other admins, modify KYC overrides, etc.
  // Maps to the user-facing "Full admin" label in the UI.
  SUPERADMIN
  // Read-only tier — sees the dashboard, listings, transactions, KYC
  // credit balance, but can't take destructive actions. Maps to the
  // user-facing "Monitoring admin" label. (Currently not enforced on
  // individual endpoints yet — that gate work is tracked separately.)
  MONITORING_ADMIN
}

enum OfferStatus {
  PENDING // awaiting seller response (48h TTL)
  COUNTERED // seller made a counter-offer; buyer must respond within 24h
  ACCEPTED // seller accepted original offer
  REJECTED // seller declined
  WITHDRAWN // buyer withdrew before seller responded
  EXPIRED // TTL elapsed without response
  CONVERTED // transaction created from this offer
}

enum ListingType {
  BUY_NOW
  TAKE_A_SHOT
  AUCTION
  SWOP
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAYMENT_PENDING // reserved while buyer completes Peach checkout
  SOLD
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  HELD // payment received, funds held until delivery confirmed
  PENDING_ADMIN_VERIFICATION
  RELEASED // payout sent to seller
  DISPUTED
  REFUNDED
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum SellerTier {
  NEW
  ESTABLISHED
  TRUSTED
  TOP_SELLER
  DEALER
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
  // Claude-vision flow: automated verdict was inconclusive (score band or a
  // soft cross-check mismatch) — a human admin must approve/reject from the
  // user dossier. Payout gates check `!== VERIFIED`, so this blocks payout
  // with no gate changes. Terminal for the wizard (no user action needed).
  UNDER_REVIEW
}

enum ClaudeDecision {
  APPROVE
  AUTO_FIX_AND_APPROVE
  REJECT
  HUMAN_REVIEW
}

enum ShippingMethod {
  PUDO // Pudo locker-to-locker (non-firearm)
  TCG // The Courier Guy door-to-door (non-firearm)
  DEALER_TRANSFER // Routed through a SAPS-licensed dealer (firearm — buyer picks dealer at checkout)
  PRIVATE_ARRANGE // Buyer + seller arrange in-person legal transfer (firearm — pair go to a dealer themselves)
  COLLECTION // Buyer collects in person from the seller — no courier, no rate. Forced for collectionOnly categories (trailers, oversized/dangerous goods). Funds stay HELD until the buyer confirms collection (payment protection); contact details are revealed post-payment so they can coordinate the meet.
  ON_SITE_SERVICE // Future-dated on-site SERVICE (hunting package / range day). No courier, no rate, no parcel — the buyer attends on a scheduled event date. Funds stay HELD until the buyer confirms the experience happened. Deliberately matches NONE of the courier-cron shippingMethod filters (PUDO/TCG/DEALER_TRANSFER/COLLECTION) so experience bookings are invisible to every dispatch/auto-refund sweep.
}

enum ShippingStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTH_WEST
  NORTHERN_CAPE
  WESTERN_CAPE
}

// Hunting-package / experience kind. Extensible later (dangerous game, bird,
// bow, fishing charter…). RANGE_DAY carries the lowest legal risk (no game /
// permit / TOPS exposure) and is the recommended launch lead.
enum ExperienceType {
  RANGE_DAY
  PLAINS_GAME_HUNT
}

// Pre-purchase product-only Q&A on a listing. There is NO buyer/seller
// messaging on Gun Galore — the only sanctioned pre-sale dialog is this
// structured, Claude-moderated Q&A on the listing page itself.
enum ListingQuestionStatus {
  PENDING_MODERATION // submitted, awaiting Claude pass 1 (moderation)
  REJECTED_BY_MODERATION // Claude rejected (off-topic / contact details / negotiation)
  AWAITING_SELLER_ANSWER // moderation passed, no prior Q matched — seller notified
  AUTO_ANSWERED // Claude found a recent matching prior Q + reused the seller's answer
  ANSWERED_BY_SELLER // seller answered manually via the dashboard
  HIDDEN // admin or seller hid this Q&A row from the public panel
}

// Featured-slot system (paid placement on the left rail). 10 slots
// rotate via per-slot auctions. See FeaturedSlot model below.
enum FeaturedSlotStatus {
  VACANT // no occupant + no active auction (cold start only)
  AUCTION_RUNNING // pre-auction is open, no current occupant yet
  BIND_WINDOW // auction closed, winner has 15 min to pick a listing
  OCCUPIED // listing bound, featured live until featuredUntil
}

enum FeaturedAuctionStatus {
  OPEN // accepting bids
  CLOSED_AWARDED // closed with a winner
  CLOSED_NO_BIDS // closed with zero bids — slot reopens an ad-hoc auction
  CANCELLED_BY_ADMIN // admin killed the auction
}

// Why the auction was opened — affects duration (24h scheduled vs 2h ad-hoc).
enum FeaturedAuctionKind {
  SCHEDULED // opens 24h before the predecessor's featuredUntil
  AD_HOC // listing sold mid-feature OR cold-start vacancy
}

enum FeaturedBidStatus {
  ACTIVE // outstanding, may still win
  WON // this bid won its auction (Peach charge pending)
  LOST // outbid before auction close
  WITHDRAWN // bidder pulled before auction close (if allowed)
  REFUNDED // won + paid + later refunded (e.g. admin force-evict)
}

// Five tiers map a bid amount to a featured duration. The amounts +
// durations are CONFIGURABLE via FeaturedSlotConfig — these enum
// names are stable label-free discriminators (display labels come
// from the config row, not the enum, so re-pricing doesn't require
// a schema migration).
enum FeaturedTier {
  T1
  T2
  T3
  T4
  T5
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                String     @id @default(cuid())
  clerkId           String     @unique
  email             String     @unique
  // MarketingCampaign.key this user arrived on, captured at sign-up. The
  // campaigns page could previously only show banner impressions ("hits"),
  // so a paid SMS blast could not be judged on whether anyone actually
  // JOINED — the only question that matters when you pay per message.
  // Set once at provisioning and never overwritten (first-touch attribution).
  campaignKey       String?
  // Public-facing handle. Lowercased + unique. Optional until first set so we
  // can backfill existing Clerk-only users without breaking them.
  username          String?    @unique
  phone             String?
  // Phone-verification state. We send a 4-digit OTP via SMSPortal when the
  // seller changes their phone; phoneVerified flips to true once they
  // submit the matching code. phoneOtpHash stores a sha256 of the
  // active code so the raw number never sits on disk.
  phoneVerified     Boolean    @default(false)
  phoneOtpHash      String?
  phoneOtpExpiresAt DateTime?
  /// Wrong guesses against the CURRENT code. A 4-digit code is 10,000
  /// possibilities and the window is ten minutes, so without a cap the only
  /// thing standing between an attacker and somebody's phone number is the
  /// global 60/min IP bucket — which rotating IPs walk straight through.
  /// Five misses burns the code; they must request a new one.
  phoneOtpAttempts  Int        @default(0)
  firstName         String?
  lastName          String?
  avatarUrl         String?
  // Personal / shipping address — distinct from per-listing pickup
  // address on `Listing`. Edited from /profile/edit.
  addrBuilding      String?
  addrStreet        String?
  addrAddress2      String?
  addrSuburb        String?
  addrCity          String?
  addrPostalCode    String?
  addrProvince      Province?
  addrLat           Float?
  addrLng           Float?
  sellerTier        SellerTier @default(NEW)
  trustScore        Int        @default(0)
  averageRating     Float?
  kycStatus         KycStatus  @default(NONE)
  kycVerifiedAt     DateTime?
  kycDocumentUrl    String? // Cloudinary URL of uploaded ID document (LEGACY — old manual flow)

  // ─────────────── VerifyNow KYC flow ───────────────
  // Triggered automatically when the first buyer kicks off a purchase
  // on one of this seller's listings. The seller is then prompted via
  // SMS + email + in-app banner to complete VerifyNow (SA ID lookup +
  // selfie face-match). Manual KYC entry from /profile has been removed.
  //
  // kycRequiredAt = when the first sale forced verification. Once set,
  // the in-app banner stays visible until kycStatus === VERIFIED.
  kycRequiredAt             DateTime?
  // POPIA consent must be explicit before any Home Affairs lookup. Set
  // when the seller ticks the consent box on /kyc/verify.
  kycConsentGivenAt         DateTime?
  // Home Affairs SA ID lookup passed (firstName/lastName already
  // populated from that response). Selfie still pending.
  kycIdVerifiedAt           DateTime?
  // Total face-match attempts. ≥3 fails → AdminAlert is raised and
  // the seller is told to contact support.
  kycAttempts               Int       @default(0)
  kycFaceMatchScore         Float?
  kycFaceMatchStatus        String?
  kycVerifyNowTransactionId String?
  // SHA-256 hash of the SA ID number (salted with ID_HASH_SECRET).
  // Stored ONLY as a hash so the raw 13-digit ID never lands on disk
  // — POPIA-friendly + lets us detect "this ID is already in use" by
  // hash collision check before calling VerifyNow. Unique at the DB
  // level so a duplicate registration physically can't land.
  kycIdHash                 String?   @unique
  // SA ID number stored AES-GCM encrypted at rest. Set when the
  // seller completes their profile (modal pops up after their first
  // listing publishes) or at the Claude-flow Details step. RETAINED
  // after KYC passes under the firearms-transfer regulatory-compliance
  // basis (FCA s125 / SAP 534): KycService/Saps534Service decrypt it to
  // prefill Section C of the SAP 534 on a later firearm sale, and the
  // Claude verdict step decrypts it for the identity cross-check.
  // Encryption key derives from ID_HASH_SECRET via HKDF in
  // backend/src/common/id-crypto.ts.
  idNumberEncrypted         String?

  // ─────────────── Claude-vision KYC flow (kyc_claude_flow_enabled) ───────────────
  // Cheap path: seller uploads their ID document + takes a live selfie;
  // Claude vision face-matches + OCRs; VerifyNow only does the 1-credit
  // "SA ID (Basic)" record check. Anti-forgery = server-side cross-checks
  // (entered DOB vs ID-number digits vs document OCR vs Home Affairs record).
  // Date of birth EXACTLY as the seller typed it ('YYYY-MM-DD'). Deliberately
  // NOT validated against the ID number at capture — the silent mismatch is
  // the faker catch-out, applied only at verdict time.
  dateOfBirth       String?
  // Cloudinary URLs — RETAINED post-verification (operator decision
  // 2026-07-17: FICA-style audit trail, same posture as stamped SAP 534s).
  kycIdDocumentUrl  String?
  kycSelfieUrl      String?
  // Full Claude findings JSON (+ merged crossCheck hard/soft fails) so the
  // admin dossier can re-render the reasoning without another vision call.
  kycClaudeFindings Json?
  // SA ID (Basic) result persisted at the Details step so the verdict step
  // can cross-check names/DOB without burning a second VerifyNow credit.
  kycHaCheckJson    Json?
  // Which pipeline verified/attempted this user: 'VERIFYNOW' | 'CLAUDE'.
  kycMethod         String?
  // 'STANDARD' (< anchored threshold) | 'ANCHORED' (official DHA photo was
  // pulled and matched). Resolved server-side by max listing/sale value —
  // invisible to the seller. Silent upgrade re-runs anchored scan on the
  // stored selfie when a VERIFIED STANDARD seller crosses the threshold.
  kycTier           String?
  // Human decision on UNDER_REVIEW (admin dossier Approve/Reject).
  kycReviewedById   String?
  kycReviewedAt     DateTime?
  kycReviewNote     String?

  // ── Sign-up consent (POPIA accountability) ─────────────────────────
  // Captured at account creation (email + OAuth paths) and recorded via
  // POST /users/consent. Set-once timestamps — the original consent moment
  // is never overwritten. ageAffirmedAt = the 18+ self-affirmation (required
  // to create an account); the legally load-bearing firearm-eligibility gate
  // still lives at firearm checkout (firearmAttestation18Plus).
  termsAcceptedAt      DateTime?
  privacyConsentAt     DateTime?
  ageAffirmedAt        DateTime?
  consentPolicyVersion String?
  // Separate, explicit marketing opt-in (POPIA direct-marketing consent).
  // Distinct from transactional notifications; null = not opted in.
  marketingConsentAt   DateTime?

  totalSales Int       @default(0)
  isBanned   Boolean   @default(false)
  bannedAt   DateTime?

  // Seller "Complete profile" gate — set when the seller submits the
  // post-first-publish profile modal (name/surname/username/phone/
  // address/ID/banking). Read on payout to ensure we have everything
  // required to disburse funds. Sellers can keep listing more items
  // without re-doing this; payout is what actually blocks until set.
  profileCompletedAt DateTime?

  // Banking — collected on the profile modal, validated against
  // Peach AVS (Account Verification Service) on save. All fields
  // null until the seller fills them in. We DON'T encrypt these at
  // rest; SA bank account numbers aren't classed as PII under POPIA
  // the same way an ID number is, and we need the plaintext to run
  // future payouts via Peach.
  bankName           String?
  bankAccountHolder  String?
  bankAccountNumber  String?
  bankBranchCode     String?
  bankAccountType    String? // "cheque" | "savings" | "transmission"
  // Stamp set when Peach AVS returns "match" on the bank details.
  // We re-run AVS on every save (per operator decision) so this
  // always reflects the most recent confirmation.
  bankVerifiedAt     DateTime?
  // Last Peach AVS outcome, for audit if a payout fails and we need to
  // trace why: "PASS:<code>" / "MISMATCH:<code>:<flags>" / "FAILED:<code>".
  bankAvsResult      String?
  // Pending/last Peach BANV request id — the verification webhook and the
  // admin re-check both match the user on this.
  bankVerificationId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auction system — non-payment strikes
  auctionStrikes Int       @default(0)
  lastStrikeAt   DateTime?

  // Dispatch SLA strikes — incremented when the 7d auto-refund cron
  // fires on a courier-shipped order this seller failed to dispatch
  // within the window. Three strikes are the operator threshold for
  // a manual review / suspension. Lives separately from auction
  // strikes because the rules + consequences are different.
  dispatchStrikes     Int       @default(0)
  // Seller reject strikes — penalty-bearing rejections (offers + sales)
  // per the reject-reason policy. At 3 the seller is BANNED FROM LISTING
  // (sellingBannedAt): no new listings, active listings cancelled; buying
  // is unaffected. Lifted only by admin clear-reject-strikes.
  sellerRejectStrikes Int       @default(0)
  sellingBannedAt     DateTime?

  listings                Listing[]
  buyerTransactions       Transaction[]            @relation("BuyerTransactions")
  sellerTransactions      Transaction[]            @relation("SellerTransactions")
  ratingsGiven            Rating[]                 @relation("RatingsGiven")
  ratingsReceived         Rating[]                 @relation("RatingsReceived")
  offersPlaced            Offer[]                  @relation("BuyerOffers")
  bidsPlaced              Bid[]                    @relation("BidderBids")
  highBidOnListings       Listing[]                @relation("CurrentHighBidder")
  contactDetailRejections ContactDetailRejection[]
  watchlist               AuctionWatch[]

  // Q&A on listings — back-relations for "questions I've asked" and
  // "questions I've answered" (the latter is virtually always the
  // seller of the listing the question is on).
  askedListingQuestions    ListingQuestion[] @relation("AskedQuestions")
  answeredListingQuestions ListingQuestion[] @relation("AnsweredQuestions")

  // Featured slot system — back-relations.
  // `featuredSlotBids` is every bid this user has ever placed on a
  // featured slot auction (active, won, or lost). `featuredSlots` is
  // the (zero or more) slots this user currently occupies — populated
  // when their bid won + they bound a listing to it + the slot's
  // `featuredUntil` is still in the future.
  featuredSlotBids FeaturedSlotBid[] @relation("FeaturedSlotBidder")
  featuredSlots    FeaturedSlot[]    @relation("FeaturedSlotOccupant")

  // ── Zoho Books linkage ────────────────────────────────────────────
  // The user's Contact record in Zoho Books. Created lazily the first
  // time we need to invoice them (e.g. on their first sale that hits
  // verification APPROVED). Once created, reused for every subsequent
  // invoice/sales receipt so we don't duplicate contacts in Books.
  // Null = not yet synced; presence = ready to invoice without a
  // round-trip to create the contact.
  zohoContactId String?

  // ── ActionToken back-relation ────────────────────────────────────
  // SMS-link action tokens that authorise this user (e.g. tokens that
  // let them accept an offer / pay for a sale / raise a bid without
  // needing a Clerk session). Cascade-deleted when the user is deleted.
  actionTokensAuthorised ActionToken[] @relation("ActionTokensAuthorised")

  // ── Notification inbox back-relation ─────────────────────────────
  // In-app inbox rows. Written by NotificationsService.persist() in
  // addition to every email/SMS dispatch. Cascade-deleted with the user.
  notifications Notification[]

  // ── Notification channel preferences ─────────────────────────────
  // Per-channel mute (default ON = the historical behaviour). Email and
  // SMS are enforced centrally in NotificationsService.send / sendSms.
  // The in-app inbox is always written; web-push opt-out is per-device
  // via PushSubscription.category.
  notifyEmailEnabled    Boolean @default(true)
  notifySmsEnabled      Boolean @default(true)
  // ⚠️ Default TRUE on purpose — and the default is NOT what keeps this
  // channel quiet. The toggle ships greyed out ("coming soon") while we
  // build sender trust with Meta on shipping messages alone, so a member
  // who defaulted to false could never switch themselves back on. The
  // global `whatsapp_enabled` Setting (default false) is the kill switch;
  // flip this default and everyone is silently muted the day it is thrown.
  notifyWhatsappEnabled Boolean @default(true)

  // ── Seller default parcel size (Phase 6 P6.3) ────────────────────
  // Pre-fills the parcel dimensions on the sell form so a seller who
  // ships similar-sized items doesn't re-enter them each time. Listings
  // still store their own dims (these are just defaults).
  defaultWeightGrams Int?
  defaultLengthCm    Int?
  defaultWidthCm     Int?
  defaultHeightCm    Int?

  // ── Saved delivery addresses (address book) ──────────────────────
  // Multiple reusable addresses. The legacy single address on the
  // addr* fields above stays as the fallback default at checkout.
  savedAddresses Address[] @relation("SavedAddresses")

  // ── Support tickets (Phase 7 P7.2) ───────────────────────────────
  supportTickets SupportTicket[] @relation("UserSupportTickets")
  // ── Formal complaints (CPA/TPPP complaints register) ─────────────
  complaints     Complaint[]     @relation("UserComplaints")
  // ── Login / activity insights ────────────────────────────────────
  lastLoginAt    DateTime?
  loginEvents    LoginEvent[]

  // ── Multi-item orders (Phase 8b) ─────────────────────────────────
  orders Order[] @relation("BuyerOrders")

  // ── Swop/Trade back-relations (SWOP) ─────────────────────────────
  swapProposalsMade     SwapProposal[] @relation("SwapProposalsMade")
  swapProposalsReceived SwapProposal[] @relation("SwapProposalsReceived")
  swapsInitiated        Swap[]         @relation("SwapsInitiated")
  swapsReceived         Swap[]         @relation("SwapsReceived")
  prizeDrawsWon         PrizeDraw[]

  // ── Wishlist back-relation ───────────────────────────────────────
  // Saved listings the user wants to come back to. See WatchedListing.
  // Distinct from AuctionWatch (which is bidding-specific notification
  // opt-in); wishlist is the general "save for later" pattern.
  wishlistEntries WatchedListing[]

  // ── Saved-search back-relation (P5.1 retention) ──────────────────
  // Persisted browse filters that alert the user when a NEW matching
  // ACTIVE listing is published. See SavedSearch.
  savedSearches SavedSearch[]

  // ── Push notification back-relation ──────────────────────────────
  // Browser/PWA push subscription endpoints. One row per device a user
  // has opted in on (iPhone PWA + Android Chrome = two rows). Fired
  // by PushService.sendToUser when NotificationsService.persist
  // writes a non-dismissible (action-required) inbox row.
  pushSubscriptions PushSubscription[]

  // ── Ask GG subscription tier ─────────────────────────────────────
  // Orthogonal to SellerTier. SellerTier reflects marketplace
  // reputation (NEW → DEALER); SubscriptionTier reflects the AI
  // assistant subscription (FREE / MEMBER / PRO). A user can be
  // both DEALER + PRO, or NEW + FREE, etc.
  //
  // FREE = default. MEMBER + PRO are paid via Peach recurring
  // billing (see Subscription model). Admin can grant MEMBER/PRO
  // manually for testing / comp accounts (recorded in
  // AdminAuditEvent like any tier change).
  subscriptionTier      SubscriptionTier @default(FREE)
  // Peach card-vault ID. Created lazily on first paid subscription;
  // reused for every subsequent recurring charge. Mirrors the
  // zohoContactId pattern. NULL until the subscription billing
  // rail goes live (operator-side blocker — separate work).
  peachCustomerId       String?          @unique
  // Verified-expert badge (Pro tier). Awarded by admin after the
  // user has 5+ verified KB submissions. Visible site-wide next to
  // their username on listings + KB entries + Q&A answers.
  isVerifiedExpert      Boolean          @default(false)
  verifiedExpertAt      DateTime?
  expertBadgeReason     String?
  // Lifetime counters for FREE-tier caps. Free users get 5 messages
  // + 5 photo IDs per rolling 30 days; the AskGgUsage daily rollup
  // is the source of truth for windows, but these lifetime counts
  // make it cheap to render "you've used N total" in the UI without
  // a daily-rollup aggregation query.
  askGgLifetimeMessages Int              @default(0)
  askGgLifetimePhotoIds Int              @default(0)

  // Back-relations (Ask GG subscription + assistant)
  subscription       Subscription?
  askGgConversations AskGgConversation[]
  askGgKbEntries     AskGgKbEntry[]      @relation("KbAuthor")
  askGgUsage         AskGgUsage[]

  // Firearm-licence motivations (Phase 1 — see LICENCE-SERVICES-AND-FEED.md).
  motivations Motivation[] @relation("UserMotivations")
  credentials Credential[] @relation("UserCredentials")

  // Campaign attribution rollup: groupBy(campaignKey) on the admin page.
  @@index([campaignKey])
}

// =====================================================================
// In-app Notifications inbox
// =====================================================================
// Persistent feed of events for the user — the source of truth behind
// the bell icon in the bottom tab bar + the /notifications inbox page.
// Mirrors every email/SMS dispatched by NotificationsService.
//
// "Resolved" semantics: a notification stays in the inbox (and counts
// toward the bell badge) until either:
//   * The linked entity transitions to a terminal state and
//     NotificationsService.resolveByEntity() stamps resolvedAt
//     (e.g. seller accepts an offer → the seller's "offer received"
//     notification auto-resolves), OR
//   * The user explicitly dismisses an informational notification
//     via the × button (only allowed when dismissible = true).
//
// Opening the inbox or tapping a row does NOT clear anything — that
// was the explicit user-spec'd behaviour. The badge only drops when
// the user actually acts on the underlying entity.
enum NotificationCategory {
  BUYER // events relevant to the user as a buyer
  SELLER // events relevant to the user as a seller
  ACCOUNT // KYC / AVS / broadcasts / admin messages
}

model Notification {
  id       String               @id @default(cuid())
  userId   String
  category NotificationCategory
  // Discriminator for the event (e.g. 'offer_received', 'bid_outbid').
  // Free-form string so we can add new event types without a migration.
  type     String

  title   String
  body    String
  url     String? // deep-link path (e.g. /transactions/abc)
  iconKey String? // UI icon hint (offer | bid | sold | ...)

  // Linkage to the underlying entity. resolveByEntity() in the service
  // looks up unresolved rows by (linkedType, linkedId) and stamps
  // resolvedAt on them when the entity transitions.
  linkedType String? // 'offer' | 'transaction' | 'bid' | 'listing'
  linkedId   String?

  // Resolution state.
  resolvedAt DateTime?
  resolvedBy String? // 'user_action' | 'dismissed' | 'auto_expired'

  // True for informational notifications the user can swipe/tap to
  // dismiss. False for action-required ones — those can ONLY clear
  // via resolveByEntity when the underlying entity transitions.
  dismissible Boolean @default(false)

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Bell-badge / active-feed query: WHERE userId=? AND resolvedAt IS NULL
  @@index([userId, resolvedAt, createdAt(sort: Desc)])
  // resolveByEntity lookup
  @@index([linkedType, linkedId, resolvedAt])
}

model Category {
  id                           String     @id @default(cuid())
  name                         String
  slug                         String     @unique
  parentId                     String?
  parent                       Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children                     Category[] @relation("SubCategories")
  // True when this category contains items legally classified as firearms
  // (the Firearms parent + all its children, plus Barrels under Gun Smithing).
  isFirearm                    Boolean    @default(false)
  // Whether this category is visible to a SIGNED-OUT visitor (and therefore
  // to crawlers). Regulated and weapon-adjacent trees — firearms, gun-smithing
  // parts, reloading components/equipment, air rifles, self-defence and
  // shooting accessories — stay members-only; camping, fishing, optics,
  // clothing and the rest of the outdoor catalogue are public.
  //
  // DEFAULT FALSE IS DELIBERATE. This is an allowlist, not a blocklist: a
  // category added later is invisible until someone marks it public, so the
  // failure mode is "we forgot to show the tents", never "we leaked the
  // rifles". Never flip this default.
  publicVisible                Boolean    @default(false)
  // Subset of isFirearm — these MUST ship via licensed-dealer transfer.
  // SAPS regulation: firearms + barrels cannot move between individuals
  // without dealer paperwork.
  requiresLicence              Boolean    @default(false)
  // Whether this category appears on the used marketplace (Sell form +
  // marketplace filters). False for live-ammo categories.
  availableSecondhand          Boolean    @default(true)
  // Whether this category appears on the dealer New Store (M3 phase).
  availableNewStore            Boolean    @default(false)
  // Cross-sell: may THIS category's listings be shown as a "you might also
  // need" suggestion? Default true; set false for prohibited/sensitive
  // categories (e.g. Ammo). Generic gate governing every category incl.
  // future ones, so the cross-sell engine needs no per-category code.
  crossSellEligible            Boolean    @default(true)
  // Collection-only categories (trailers, off-road caravans, oversized /
  // dangerous goods that no courier will carry). Listings inherit this at
  // create time → their only shipping method is COLLECTION, no courier
  // rate is quoted, and funds stay HELD until the buyer confirms
  // collection. Mirrors how isFirearm drives DEALER_TRANSFER.
  collectionOnly               Boolean    @default(false)
  // Registered-goods categories (trailers, off-road caravans) where the
  // seller must attest they hold valid NaTIS registration / roadworthy
  // papers and will hand them over at collection. POPIA note: we NEVER
  // collect or display the actual documents — only a boolean attestation.
  requiresPapers               Boolean    @default(false)
  // P5.4 — electronics/appliance categories (camp fridges, GPS, trail cams,
  // fish finders, e-bikes, drones) that show the OPTIONAL "tested & working"
  // seller-attestation checkbox on the sell form. Data-driven so the operator
  // can toggle categories without a code change. Mirrors collectionOnly /
  // requiresPapers gating.
  showTestedWorkingAttestation Boolean    @default(false)
  // Hunting-package / experience categories ("Hunting Packages & Experiences").
  // Snapshotted to Listing.isExperience at create (like isFirearm /
  // collectionOnly). Drives the on-site-service fulfilment path: no courier /
  // parcel, Buy Now or Auction only, funds held until the buyer confirms the
  // experience happened, and every listing routed to PENDING_REVIEW.
  isExperience                 Boolean    @default(false)
  isActive                     Boolean    @default(true)
  sortOrder                    Int        @default(0)
  createdAt                    DateTime   @default(now())

  listings Listing[]

  // Cross-sell complementary relationships (directional). Admin-managed.
  crossSellFrom CategoryRelation[] @relation("CrossSellFrom")
  crossSellTo   CategoryRelation[] @relation("CrossSellTo")

  // P4 — per-category attribute DEFINITIONS (fridge litres, rod class, size…).
  // A listing inherits its category's attributes + all ancestor categories'.
  attributes CategoryAttribute[]
}

// P4 — per-category attribute system. CategoryAttribute rows DEFINE what
// structured, filterable specs a category carries (e.g. "fridge_litres",
// "rod_class"); a Listing stores its VALUES in the Listing.attributes JSONB
// blob keyed by CategoryAttribute.key. JSONB-over-EAV per the audit: values
// are read/written as one document, and Meilisearch gets a flat `attr_<key>`
// field per filterable attribute (filterableAttributes derived from these
// rows at boot + reindex when keys change). A listing's EFFECTIVE attributes =
// its (leaf) category's rows + all ancestor categories' rows, deduped by key
// (nearest ancestor wins).
enum AttributeType {
  NUMBER // numeric (litres, Ah, lbs, mm) — range-filterable
  SELECT // one of a fixed option set (chemistry, size, discipline)
  TEXT // free text (rarely filterable)
  BOOLEAN // yes/no (new-with-tags, waterproof)
}

model CategoryAttribute {
  id         String        @id @default(cuid())
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Machine key, snake_case, stable — used as the Listing.attributes JSON key
  // AND the Meili facet field `attr_<key>`. Unique per category.
  key        String
  label      String // human label shown in the sell form + filters
  type       AttributeType
  unit       String? // "L", "Ah", "cm", "lbs" — display only
  options    String[]      @default([]) // for SELECT — allowed values, in order
  required   Boolean       @default(false) // seller must supply at listing time
  filterable Boolean       @default(true) // exposed as a Meili facet + browse filter
  sortOrder  Int           @default(0)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
}

// Directional category complement for marketplace cross-sell. One row =
// "when a buyer is on a listing/search in the FROM category, also suggest
// listings from the TO category." requireExactMatch narrows the suggestion
// by a hard compatibility attribute (calibre) — true for reloading (a .308
// die ≠ 9mm), false for soft pairings (rod → line). Fully data-driven so a
// new category lights up cross-sell with no code change.
model CategoryRelation {
  id                String   @id @default(cuid())
  fromCategoryId    String
  fromCategory      Category @relation("CrossSellFrom", fields: [fromCategoryId], references: [id], onDelete: Cascade)
  toCategoryId      String
  toCategory        Category @relation("CrossSellTo", fields: [toCategoryId], references: [id], onDelete: Cascade)
  sortOrder         Int      @default(0)
  requireExactMatch Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([fromCategoryId, toCategoryId])
  @@index([fromCategoryId])
}

// Cross-sell demand signal: one row per (fromCategory, normalised calibre)
// where a buyer's cross-sell lookup returned NO eligible complements.
// Incremented on each miss; surfaced in the admin "unmet demand" report so
// the operator knows what stock to recruit (the supply side of the
// flywheel). No FK to Category — a loose link the report joins by id, so a
// deactivated category never cascade-deletes the signal.
model CrossSellMiss {
  id             String   @id @default(cuid())
  fromCategoryId String
  calibre        String
  count          Int      @default(1)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([fromCategoryId, calibre])
  @@index([count])
}

model Listing {
  id              String  @id @default(cuid())
  // Human-trackable reference shown to buyers + sellers (e.g. UM000123,
  // AU000045, TS000007). Prefix encodes listingType:
  //   UM = Used marketplace (BUY_NOW)
  //   AU = Auction          (AUCTION)
  //   TS = Take a Shot      (TAKE_A_SHOT)
  // Assigned at create time via ReferenceCounter — see
  // listings/reference.helper.ts. Nullable so legacy rows can be
  // back-filled in a separate pass without blocking the migration.
  referenceNumber String? @unique

  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title                  String
  description            String
  // ZAR cents. THE PRICE THE BUYER SEES AND PAYS. Null for TAKE_A_SHOT.
  //
  // For BUY_NOW this is a MARKED-UP figure (operator 2026-08-15): the seller
  // names what they want to receive in sellerAskCents, and our commission plus
  // the Peach fee are built on top to produce this. Everything downstream —
  // cards, search, the PDP, cart, checkout — keeps reading `price` and needs no
  // change, because this has always been "the buyer-facing price" and still is.
  //
  // For AUCTION / SWOP it is the plain starting price: a bid discovers the
  // price, so there is nothing to mark up, and the commission is deducted from
  // the seller as it always was.
  price                  Int?
  // ZAR cents the SELLER receives on a BUY_NOW sale — what they typed in the
  // sell form. Null on auctions, swaps, take-a-shot, and on any listing created
  // before the markup model.
  //
  // Stored rather than derived because reversing the markup is not reliably
  // invertible: the commission is banded, floored at R30 and can carry a Top
  // Seller discount. Recomputing FORWARD from this always reproduces the number
  // the seller was shown, which is the one that matters if it is ever disputed.
  sellerAskCents         Int?
  // UX-7 — optional compare-at / "was" price (ZAR cents). DISPLAY-ONLY:
  // rendered as a strikethrough + "% off" chip on cards + the PDP. It NEVER
  // enters fee/checkout math (fee.calculator.ts must never read it). Guarded
  // in create()/update(): BUY_NOW only, must exceed price, capped at 4× price
  // (CPA s41 anti-anchoring); the displayed discount is further capped at 70%.
  compareAtPriceZarCents Int?
  listingType            ListingType
  status                 ListingStatus @default(DRAFT)
  condition              Condition
  // DERIVED from pickupProvince server-side — never trusted from the client on
  // its own. The two used to be independent, and this one is also stamped onto
  // the courier collection address, so a divergence sent a courier to the wrong
  // province with the right street.
  province               Province

  // The province of the seller's pickup address; `province` above is derived
  // from it. Nullable only for rows created before this column existed.
  pickupProvince Province?
  // PUBLIC, COARSE vicinity — town/city only, derived from pickupCity at write
  // time and normalised. This is the ONLY sub-province location a buyer ever
  // sees, and it is what makes "you knew where it was before you paid" true.
  //
  // Never the street, unit, building or suburb: in a small town, suburb + town
  // narrows a residential address to a handful of properties. pickupSuburb is
  // on PUBLIC_LISTING_SELECT's explicit NEVER list and there is a regression
  // test holding it there — this column exists so that stays true while buyers
  // still learn which town they would be driving to.
  publicLocality String?   @db.VarChar(80)

  isFirearm               Boolean   @default(false)
  // Snapshotted from Category.publicVisible at create time. Denormalised for
  // exactly the reason isDealListing is: every public-discovery query filters
  // on it, and the Meilisearch document can only carry scalars — a join to
  // Category is not available inside a Meili filter clause.
  //
  // Kept in sync by (a) create/update when the category changes, and (b) the
  // admin category-visibility resync. Default false = a row that somehow
  // misses the snapshot is hidden, not leaked.
  publicVisible           Boolean   @default(false)
  // Snapshotted from Category.collectionOnly at create time (like
  // isFirearm). When true the only shipping method is COLLECTION — no
  // courier rate is quoted and the buyer collects in person.
  collectionOnly          Boolean   @default(false)
  // Snapshotted from Category.requiresPapers at create time. When true
  // the seller attested (at listing) + the buyer acknowledges (at
  // checkout) that valid NaTIS registration / roadworthy papers change
  // hands at collection. Boolean attestation only — no documents stored.
  requiresPapers          Boolean   @default(false)
  // Set when a requiresPapers seller ticks the papers attestation at
  // listing creation. Durable evidence they affirmed holding the papers.
  papersAttestedAt        DateTime?
  // P5.4 — set when the seller ticks the OPTIONAL "tested & working" claim
  // (categories flagged Category.showTestedWorkingAttestation, e.g. camp
  // fridges / GPS / trail cams). The SELLER'S own attestation, never a GG
  // certification (CPA s41). Snapshotted into the dispute record if the buyer
  // later disputes.
  testedWorkingAttestedAt DateTime?

  // ----- Hunting Packages / Experiences (on-site SERVICE, no shipping) -----
  // Snapshotted from Category.isExperience at create time (like isFirearm).
  // When true the listing is a future-dated ON-SITE service: fulfilment is
  // ShippingMethod.ON_SITE_SERVICE (no courier / no parcel), it may ONLY be
  // BUY_NOW or AUCTION, it never carries inventory, and funds stay HELD until
  // the buyer confirms the experience happened. Listing is open self-serve
  // (any KYC-verified member) so every experience routes to PENDING_REVIEW
  // and an admin reviews the supplier docs before it goes live.
  isExperience               Boolean         @default(false)
  experienceType             ExperienceType?
  eventStartDate             DateTime? // the scheduled date, or window start
  eventEndDate               DateTime? // null = single day; set = multi-day window
  eventProvince              Province?
  locationText               String? // property / area, free text (no exact address publicly)
  capacitySlots              Int? // hunters / guests the package accommodates
  durationText               String? // "3 nights / 2 hunting days"
  speciesList                String[]        @default([]) // for PLAINS_GAME_HUNT
  whatsIncluded              String? // accommodation, PH/guide, field prep…
  rifleProvided              Boolean         @default(false) // rifle provided vs bring-own
  // Supplier (outfitter) attestations + registration/insurance capture. We
  // store the registration NUMBER + Cloudinary doc URLs only; the docs are
  // Claude-vision reviewed like the SAP-534 dealer-verification flow.
  supplierRegistrationNumber String?
  supplierRegistrationDocUrl String?
  supplierInsuranceUrl       String?
  supplierAttestedAt         DateTime?
  supplierDocReviewStatus    String? // PENDING_CLAUDE | PENDING_ADMIN_REVIEW | APPROVED | REJECTED
  supplierDocReviewScore     Float?
  supplierDocReviewFindings  Json?
  supplierDocReviewedAt      DateTime?

  make    String?
  model   String?
  calibre String?

  // P4 — structured per-category attribute VALUES, keyed by
  // CategoryAttribute.key (e.g. { "fridge_litres": 40, "battery_chemistry":
  // "LiFePO4", "new_with_tags": true }). JSONB; validated at create/update
  // against the category's EFFECTIVE attribute definitions (leaf + ancestors).
  // Mirrored into Meili as flat `attr_<key>` fields for faceting.
  attributes Json?

  // ----- Firearm/barrel licence + serial capture (SAP 534 workflow) -----
  // Only populated for isFirearm / licence-controlled listings. Collected
  // in the Sell form and cross-checked by Claude vision at create time:
  //   - serialNumber: seller-typed; must match the serial photo AND the
  //     serial printed on the licence.
  //   - serialPhotoUrl / licencePhotoUrl: Cloudinary URLs of the proof
  //     photos (serial stamp on the firearm/barrel, and the licence doc).
  //   - licenceHolderName: name vision read off the licence (must match
  //     the seller).
  //   - licenceExpiresAt: expiry date vision read off the licence. Drives
  //     the listing gate (expired/≤30d blocked, 31–90d warn) and the daily
  //     auto-delist cron (set EXPIRED once ≤30d out).
  serialNumber          String?
  serialPhotoUrl        String?
  licencePhotoUrl       String?
  licenceHolderName     String?
  licenceExpiresAt      DateTime?
  // Set once when the 31–90-day "licence expiring" warning is sent, so the
  // daily expiry cron warns only once (then delists at ≤30 days).
  licenceExpiryWarnedAt DateTime?
  // Firearm "type" (e.g. Pistol/Rifle/Shotgun) — left blank on the
  // prefilled SAP 534 and read back from the completed, dealer-stamped
  // form at dealer-verification time.
  firearmType           String?

  // Parcel weight + dimensions captured by the seller in the Sell form.
  // Required for non-firearm listings (Pudo + TCG need them to quote
  // rates). Firearm listings can leave them null because DEALER_TRANSFER
  // and PRIVATE_ARRANGE don't use the courier API. Pudo's largest L2L
  // locker box is 60×41×69 cm at 20 kg — anything beyond that forces
  // TCG door-to-door (the Sell form hides the PUDO option when over).
  weightGrams Int?
  lengthCm    Int?
  widthCm     Int?
  heightCm    Int?

  // Inventory / quantity (Phase 8a). trackInventory is the stable flag
  // that switches a listing into multi-unit mode: when FALSE (the default
  // for every existing listing, all firearms, and auctions) the listing is
  // a single item using the legacy ACTIVE→PAYMENT_PENDING→SOLD status
  // machine, UNCHANGED. When TRUE (a seller opts a BUY_NOW non-firearm
  // listing into stock), purchases decrement quantityAvailable via an
  // atomic counter and the listing only flips SOLD when it hits 0.
  // quantityReserved = units currently in in-flight (pending-payment)
  // checkouts. quantityAvailable = remaining sellable units.
  trackInventory    Boolean @default(false)
  quantityAvailable Int     @default(1)
  quantityReserved  Int     @default(0)

  autoAcceptThreshold  Int? // ZAR cents; Take a Shot only
  // Offers at or below this are instantly declined without bothering the
  // seller (the lowball filter — mirror of autoAcceptThreshold). Hidden
  // seller threshold; never exposed publicly or to buyers.
  autoDeclineThreshold Int? // ZAR cents; Take a Shot only

  // ----- SWOP-specific fields -----
  // Honest-value anchor for a swap listing (SWOP is price-less). Drives the
  // value-based swap service fee, is shown to the counterparty during
  // negotiation, and caps dispute compensation for THIS item's sender —
  // over-declaring costs fees, under-declaring costs protection.
  declaredValueCents Int? // ZAR cents; required for SWOP at create/update

  // ----- AUCTION-specific fields -----
  // price (above) = starting bid for AUCTION listings
  reservePrice    Int? // optional hidden reserve; never exposed publicly
  // Optional Buy Now price on an auction — only honoured while bidCount == 0.
  //
  // ⚠️ STORED AND VALIDATED, BUT NOT YET PURCHASABLE. Nothing in the checkout
  // path reads this: transactions.service resolves an auction price from
  // currentBid (a win) and everything else from Listing.price. Whoever wires
  // the actual buy-now flow inherits this rule —
  //
  // OPERATOR 2026-08-15: BUY NOW ON AN AUCTION FOLLOWS THE AUCTION RULES.
  // It is NOT marked up like a BUY_NOW listing. Commission comes OUT of the
  // seller, and the buyer pays the gateway fee as a "Transaction fee".
  // Concretely: leave sellerAskCents null, keep isMarkedUpBuyNow false, and
  // force passFeeToBuyer true — the same branch an auction win takes.
  buyNowPrice     Int?
  isFeatured      Boolean   @default(false) // R150 paid placement
  currentBid      Int? // current visible high bid in ZAR cents
  currentBidderId String? // current high bidder
  currentBidder   User?     @relation("CurrentHighBidder", fields: [currentBidderId], references: [id])
  bidCount        Int       @default(0)
  reserveMet      Boolean   @default(false)
  startTime       DateTime?
  endTime         DateTime? // may be extended by snipe protection
  durationDays    Int? // 3 / 5 / 7 / 14 — snapshot of seller's choice
  endedAt         DateTime? // when the end-cron processed this auction

  // LOCKED per CLAUDE.md — seller always absorbs the processing fee.
  // Field is kept for backwards compatibility with old rows but is no
  // longer surfaced in the Sell form.
  passFeeToBuyer Boolean @default(false)

  // Seller-offered shipping methods. For non-firearm listings this is
  // some non-empty subset of [PUDO, TCG]. For firearm / barrel listings
  // it's a subset of [DEALER_TRANSFER, PRIVATE_ARRANGE]. DEALER_TRANSFER
  // is MANDATORY for firearm listings — the seller can additionally
  // offer PRIVATE_ARRANGE, but they cannot list a firearm without
  // dealer-stock as an option. ListingsService.create + update enforce
  // this. The buyer picks ONE of these at checkout and that pick lands
  // on Transaction.shippingMethod.
  shippingMethods ShippingMethod[] @default([])

  // Seller's consent to share their phone + email with the BUYER of a
  // PRIVATE_ARRANGE firearm sale (so the pair can coordinate the dealer
  // meet). Captured at listing create/edit: offering PRIVATE_ARRANGE
  // REQUIRES this consent (listings.service rejects PRIVATE_ARRANGE
  // without it). The Shipping module / transaction page only reveal the
  // seller's contact when this is set. Null = never consented → contact
  // stays hidden.
  privateArrangeConsentAt DateTime?

  // Optional seller-supplied hint of where they intend to dealer-stock
  // a firearm (e.g. "Pretoria Arms, Centurion"). Only meaningful when
  // the listing is a firearm + offers DEALER_TRANSFER. Shown to buyers
  // on the listing detail page so a buyer near that dealer can see
  // they'd have less driving post-purchase. Free text, max 200 chars,
  // not validated against a dealer registry — purely informational.
  // Seller is NOT bound to this dealer (the actual stocking dealer is
  // captured at dealer-verification upload time).
  //
  // MANDATORY for firearm/barrel listings (2026-07-13): the three parts
  // below are all required at create/edit; plannedDealerLocation is the
  // server-composed display string ("<name> — <area>, <province>") that
  // the listing detail page renders. Null for non-firearm listings.
  plannedDealerLocation String?
  plannedDealerName     String?
  plannedDealerProvince String?
  plannedDealerArea     String?

  // Seller pickup address (where Pudo/TCG collect from, or where the
  // private/dealer-transfer hand-off originates). Captured at listing
  // time. Auto-filled from Google Places autocomplete when available.
  pickupBuilding   String?
  pickupStreet     String?
  pickupAddress2   String?
  pickupSuburb     String?
  pickupCity       String?
  pickupPostalCode String?
  pickupLat        Float?
  pickupLng        Float?

  // Seller's preferred Pudo locker (set when shippingMethods includes
  // PUDO). Auto-suggested from pickupLat/pickupLng → nearest 3 lockers,
  // or overridden by the seller from a Meilisearch lookup.
  pickupPudoLockerId String?

  claudeDecision            ClaudeDecision?
  claudeConfidence          Float?
  claudeReasons             String[]
  claudeReviewedAt          DateTime?
  claudeOriginalDescription String?
  claudeAutoFixApplied      Boolean         @default(false)

  adminReviewedById   String?
  adminReviewedAt     DateTime?
  adminOverrideReason String?

  expiresAt DateTime?
  soldAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // P5.1 — when this listing FIRST became discoverable (entered ACTIVE),
  // stamped once at create (if published straight to ACTIVE) or on the admin
  // approval that lifts it out of PENDING_REVIEW. The saved-search matcher keys
  // "new since I last looked" on this, NOT createdAt — a listing created 10:00
  // but human-approved 14:00 must alert as new at 14:00, not be silently missed
  // because the cursor already passed its createdAt. Set-once (never bumped on
  // edits/reversals) so an item already surfaced isn't re-alerted.
  listedAt DateTime?

  // P5.2 — last time we fired a "price dropped" alert to this listing's
  // wishlisters. Throttles repeated small price edits to at most one alert per
  // window so a seller nudging the price down can't spam every watcher's inbox.
  priceDropNotifiedAt DateTime?

  // Set once when the auction ending-soon sweep alerts this listing's
  // wishlisters that a saved auction closes within the window. IS NULL fires
  // it once per auction; mirrors the priceDropNotifiedAt throttle stamp.
  endingSoonNotifiedAt DateTime?

  // Set once when the pay-window reminder nudges an auction winner (PAYMENT_
  // PENDING with expiresAt within 6h and no checkout started) before the
  // sweepUnpaidWins strike. finalizeAuction stamps a fresh expiresAt so this
  // resets naturally on relist/re-finalise. Claimed via CAS so a double-send
  // can't race the every-minute sweep.
  winnerRemindedAt DateTime?

  // Stale-listing lifecycle (non-auction, non-deal). lastRenewedAt seeds from
  // createdAt (backfilled at migration, now() for new rows) and advances ONLY
  // on an explicit seller "still for sale" renew — NEVER on unrelated writes
  // (offer counters, moderation edits touch updatedAt, which would silently
  // keep dead listings alive forever). renewalNudgedAt guards the 75d "is this
  // still for sale?" one-shot nudge and is cleared by a renew so the next
  // 90-day cycle can nudge again; at 90d the daily cron expires the listing.
  lastRenewedAt   DateTime  @default(now())
  renewalNudgedAt DateTime?

  // Daily Deals (DD-1) — true when this listing is a first-party house DEAL
  // (owned by the "Gun Galore" house seller, overlaid by a Deal row). Deal
  // listings are DELIBERATELY EXCLUDED from every public marketplace surface
  // (browse, search, brands, category counts, sitemap, price comps,
  // saved-search alerts) via `isDealListing: false` on those queries — they
  // only appear on the dedicated /deals surface. See DAILY-DEALS-PLAN.md.
  isDealListing Boolean @default(false)

  images               ListingImage[]
  transactions         Transaction[]
  orderLineItems       OrderLineItem[]
  offers               Offer[]
  bids                 Bid[]
  watchers             AuctionWatch[]
  swapProposals        SwapProposal[]    @relation("SwapProposalTarget")
  swapProposalsOffered SwapProposal[]    @relation("SwapProposalOffered")
  // Users who saved this listing to their wishlist. Distinct from
  // `watchers` (auction-bidding opt-in). Used for the heart-icon
  // state across browse grids + /wishlist page + future "X people
  // saved this" social-proof signal.
  wishlistedBy         WatchedListing[]
  questions            ListingQuestion[]
  // Featured-slot back-relation. When a seller wins a featured slot
  // auction + binds this listing to it, the slot's
  // `currentListingId` points here. Optional 1:1 (a listing is in
  // ≤1 slot at a time, a slot has ≤1 listing).
  featuredInSlot       FeaturedSlot?     @relation("FeaturedSlotListing")

  // Daily Deals (DD-1) — 1:1 overlay carrying the deal economics + schedule.
  // Present only when isDealListing = true.
  deal Deal? @relation("DealListing")

  @@index([status, listingType])
  @@index([categoryId])
  @@index([sellerId])
  @@index([endTime])
  // P5.1 saved-search matcher hot path: ACTIVE listings newly listed since a
  // cursor (WHERE status='ACTIVE' AND listedAt > cursor).
  @@index([status, listedAt])
  // Daily Deals — every public listing query filters `isDealListing: false`.
  @@index([isDealListing])
  // Signed-out discovery — every anonymous browse adds `publicVisible: true`
  // on top of the status filter, so index the pair.
  @@index([status, publicVisible])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Daily Deals (OneDayOnly-style first-party deals) — DD-1
// ---------------------------------------------------------------------------
// Lifecycle of a single deal. DD-1 stops at DRAFT/SCHEDULED authoring; the
// LIVE/EXTENDED/ENDED/SOLD_OUT transitions are driven by the DD-4 drop cron.
enum DealStatus {
  DRAFT // admin building it
  SCHEDULED // queued for a future drop (startsAt set)
  LIVE // on sale now (in the current drop)
  EXTENDED // ran past its window — surfaces in "Extra Time"
  ENDED // window closed, not sold out
  SOLD_OUT // stock hit 0
  CANCELLED // pulled by admin
}

// A first-party Daily Deal — a thin economics + schedule overlay on top of a
// BUY_NOW Listing owned by the house seller (isDealListing = true). The
// Listing is the single source of truth for checkout (price, stock, images,
// shipping); the Deal row carries the internal cost, the "was" anchor, the
// drop schedule, and the fair-share cap. Buyers ride the normal cart / EFT /
// courier rails; DD-2 adds the first-party money branches. See
// DAILY-DEALS-PLAN.md §2.2.
model Deal {
  id        String  @id @default(cuid())
  listingId String  @unique
  listing   Listing @relation("DealListing", fields: [listingId], references: [id], onDelete: Cascade)

  status DealStatus @default(DRAFT)

  // Economics (ZAR cents). The deal SELL price lives on Listing.price (the
  // checkout source of truth); these are the overlay's own fields.
  costPriceCents Int // internal — per-unit supplier cost (never public)
  wasPriceCents  Int // RRP anchor, shown struck-through (also mirrored to Listing.compareAtPriceZarCents)

  // Schedule. A drop = every deal sharing a dropDate/startsAt going live together.
  startsAt      DateTime?
  endsAt        DateTime?
  extendedUntil DateTime? // set when a winner is pushed into Extra Time
  dropDate      DateTime? // groups deals into one drop (calendar / pipeline)
  liveAt        DateTime? // stamped when it actually went LIVE
  endedAt       DateTime?
  soldOutAt     DateTime?

  heroRank       Int @default(0) // ordering within the drop grid (higher = more prominent)
  initialStock   Int // snapshot of stock at go-live → sell-through %
  perCustomerCap Int @default(10) // fair-share cap (units per buyer per deal)

  // Per-deal delivery promise (the JIT supply model makes this honest).
  shipsInDaysMin Int @default(3)
  shipsInDaysMax Int @default(7)

  // Supplier bookkeeping (internal — never public).
  supplierName String?
  supplierRef  String?

  // JIT supplier-fulfilment (DD-F): the structured supplier + its purchase order.
  // Kept alongside the legacy free-text supplierName/supplierRef above.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  purchaseOrder DealPurchaseOrder?

  createdByAdminId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, startsAt])
  @@index([dropDate])
  @@index([supplierId])
}

// A JIT fulfilment supplier for Daily Deals (DD-F). GG is the first-party
// seller; on a house-deal sale we raise a Zoho Purchase Order to the supplier
// and The Courier Guy collects the stock from THIS warehouse. Supplier, cost,
// and PO data are strictly internal — never exposed on any public surface.
model Supplier {
  id            String  @id @default(cuid())
  name          String
  contactPerson String
  email         String
  phone         String
  vatNumber     String?
  regNumber     String?

  // Collection warehouse — where The Courier Guy collects from.
  warehouseStreet     String
  warehouseSuburb     String
  warehouseCity       String
  warehouseProvince   Province
  warehousePostalCode String
  warehouseLat        Float?
  warehouseLng        Float?

  notes String?

  // Zoho Books vendor sync (one Books object = one dedicated id column).
  zohoVendorId          String?
  zohoSyncStatus        String?
  zohoSyncError         String?
  zohoSyncLastAttemptAt DateTime?

  active           Boolean  @default(true)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deals Deal[]
}

// The purchase order raised against a Supplier when a house deal sells. One
// PO per Deal (dealId unique). Zoho Books PO id lives in its own column for
// idempotency; email send is gated behind the deal_po_email_enabled flag.
model DealPurchaseOrder {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  unitsOrdered  Int
  unitCostCents Int
  totalCents    Int

  status DealPoStatus @default(DRAFT)

  // Zoho Books purchase-order sync (one Books object = one dedicated id column).
  zohoPurchaseOrderId   String?
  zohoSyncStatus        String?
  zohoSyncError         String?
  zohoSyncLastAttemptAt DateTime?

  placedAt     DateTime?
  emailedAt    DateTime?
  stockReadyAt DateTime?

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum DealPoStatus {
  DRAFT // row created, not yet placed with Zoho
  PLACED // Zoho PO created
  EMAILED // PO emailed to the supplier
  CANCELLED // pulled
}

model Dealer {
  id            String    @id @default(cuid())
  name          String
  licenceNumber String    @unique
  address       String
  // Address components are nullable so an AUTO_VERIFICATION entry (harvested
  // from an approved firearm dealer-transfer, which may only carry a raw OCR
  // address) can be stored. Curated MANUAL entries keep all four — the admin
  // form still requires them. An admin fills any gaps during review.
  suburb        String?
  city          String?
  province      Province?
  postalCode    String?
  lat           Float?
  lng           Float?
  phone         String?
  email         String?
  // Offered to buyers at checkout. AUTO entries land isActive=false so OCR
  // alone can never route a live firearm transfer through an unvetted dealer.
  isActive      Boolean   @default(true)
  // Provenance. MANUAL = admin-curated (trusted, verified by default).
  // AUTO_VERIFICATION = auto-added the moment a dealer's SAP 534 passed
  // verification; lands inactive + unverified for admin review.
  source        String    @default("MANUAL")
  // Has an admin eyeballed this entry? MANUAL rows are verified on creation;
  // AUTO rows start false and flip true when an admin reviews & activates.
  isVerified    Boolean   @default(true)
  // The full address string as OCR'd off the SAP 534 (AUTO entries only) —
  // kept raw for admin reference while they normalise it into the structured
  // suburb/city/province/postalCode fields.
  rawAddress    String?
  // When we first / most recently saw this dealer on an approved transfer.
  firstSeenAt   DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions Transaction[]

  @@index([province])
  @@index([isActive])
  @@index([source])
}

model Transaction {
  id String @id @default(cuid())

  // Cart / multi-item order (Phase 8b). Null for every single-item
  // checkout (the entire Phase 1–7 flow). When set, this transaction is
  // one line of a multi-item Order; the Order owns the single payment
  // capture and the buyer-facing rollup, while this row stays exactly a
  // one-listing sub-order (so all dispatch / payout / SAPS / Zoho logic is
  // unchanged). One Transaction per line item.
  orderId  String?
  order    Order?         @relation(fields: [orderId], references: [id])
  // Inverse of OrderLineItem.transaction (1:1) — the cart line this fills.
  lineItem OrderLineItem? @relation("OrderLineTransaction")

  // Parties
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("SellerTransactions", fields: [sellerId], references: [id])

  // Units purchased (Phase 8a). 1 for every legacy/single-item sale.
  // For an inventory-tracked listing, listingPrice below is the LINE TOTAL
  // (unit price × quantity) so all downstream money math is unchanged.
  quantity Int @default(1)

  // Pricing — all ZAR cents, snapshot at point of sale
  listingPrice             Int // snapshot of listing.price × quantity
  commissionZar            Int
  processingFee            Int // Peach fee (3.5% + R1.50 fixed, ×1.15 VAT)
  // Shipping cost the buyer paid, sourced from a live Pudo / TCG rate
  // quote at checkout. Zero for firearm listings (DEALER_TRANSFER and
  // PRIVATE_ARRANGE don't use the courier API). Stored separately from
  // buyerTotal so we can show the breakdown later + remit to the
  // courier without re-computing.
  shippingCost             Int     @default(0)
  // P6.4 — flat GG handling margin per waybill created (R15). Buyer-paid,
  // GG-RETAINED (never remitted to the carrier), stored SEPARATELY from
  // shippingCost so the carrier remittance stays the pure rate. Zero for
  // firearm (DEALER_TRANSFER / PRIVATE_ARRANGE), collection, and consolidated
  // sibling lines — none of those create their own waybill.
  shippingHandlingCents    Int     @default(0)
  // Service level snapshot — "L2LXS - ECO" / "D2DM - ECO" etc. Comes
  // straight from Pudo's response so we can pass it back into the
  // shipment-create call without re-fetching the quote.
  shippingServiceCode      String?
  // Bob Go only — the rest of the chosen rate's identity. Bob Go's
  // POST /shipments needs provider_slug and service_level_code alongside
  // service_code, and BOTH vary per rate inside one quote response (a sandbox
  // reply carried provider "sandbox" on the door rate and "demo" on the
  // pickup-point rate). Pudo and TCG each had a single provider, so the
  // service code alone was a sufficient snapshot for them — it is not here.
  // Null on every legacy-carrier row and on non-courier sales.
  shippingProviderSlug     String?
  shippingServiceLevelCode String?
  passFeeToBuyer           Boolean // snapshot of listing.passFeeToBuyer
  buyerTotal               Int // what buyer is charged by Peach
  sellerPayout             Int // what seller receives after deductions

  // Fraud-risk signals (Phase 3b). Computed AFTER payment capture
  // (fire-and-forget in markPaid) — log-only, never blocks payment.
  // 0–100 score + the triggered flag keys; surfaced to admin for review.
  riskScore Int      @default(0)
  riskFlags String[] @default([])

  // Partial-refund accounting (Phase 4). Cumulative amount actually
  // refunded to the buyer (ZAR cents). 0 = none; == buyerTotal when fully
  // refunded (at which point paymentStatus flips to REFUNDED). Lets admin
  // issue several partial refunds without ever exceeding buyerTotal.
  refundedAmount Int       @default(0)
  lastRefundAt   DateTime?

  // P0.3 — on the MANUAL rail every admin refund operation (partial or
  // final) mints a SYNTHETIC child transaction (paymentStatus REFUNDED,
  // buyerTotal = that slice, sellerPayout 0) so each slice flows through
  // the FNB refund batch with its own payoutBatchId/paidOutAt lifecycle.
  // refundOfId links the child to the original sale; a parent that has
  // children never enters the refund queue itself (the children carry the
  // money). Card-gateway mode reverses on the card instead — no children.
  refundOfId     String?
  refundOf       Transaction?  @relation("RefundChildren", fields: [refundOfId], references: [id])
  refundChildren Transaction[] @relation("RefundChildren")

  // Buyer-initiated cancellation (Phase 4 P4.2). Set when the buyer
  // cancels a paid-but-undispatched courier order; the cancel path
  // full-refunds + reactivates the listing. Distinct from rejectedAt
  // (seller declined) so admin/trust-safety can tell the two apart.
  cancelledByBuyerAt DateTime?
  cancelledReason    String?

  // Payment
  paymentStatus    PaymentStatus @default(HELD)
  peachCheckoutId  String?
  // Peach requires an 8-16 char merchantTransactionId; our cuid is 25, so
  // we mint a short unique ref at checkout create and match webhooks by it
  // as a fallback to peachCheckoutId.
  peachMerchantRef String?       @unique
  // Peach Payouts payoutId (client-minted UUIDv4, stored BEFORE the API
  // call so the payout-status webhook can always be matched back).
  peachPayoutId    String?       @unique
  // @unique: a gateway payment id can settle exactly ONE transaction.
  // Defence-in-depth against replaying one Peach success against multiple
  // orders — the second markPaid hits a unique violation. NULLs are
  // exempt (Postgres) so unpaid rows are fine. Replaces the old
  // non-unique @@index([peachPaymentId]).
  peachPaymentId   String?       @unique
  peachResultCode  String?
  paidAt           DateTime?
  releasedAt       DateTime?

  // Payout settlement. The outbound payout to the seller (RELEASED) or refund
  // to the buyer (REFUNDED) is stamped paidOutAt when settled. A row is "due"
  // while paidOutAt is null (and it isn't on a payout hold). The manual-EFT FNB
  // bulk-payment batch (PayoutBatch) has been removed; a future paygate settles
  // these rows directly via paidOutAt.
  paidOutAt DateTime?

  // M26 (FLOW-F4) — admin payout-HOLD lever. A RELEASED (or otherwise-due) row
  // with payoutHeldAt set is excluded from getPayoutsDue/collectDue and never
  // enters an FNB batch until an admin clears the hold. The only control point
  // between PRIVATE_ARRANGE's immediate HELD->RELEASED flip (no delivery gate)
  // and the daily bulk-payment sweep, so a fraud allegation raised after
  // release can still stop the cash leaving GG's account. Reason + admin id
  // captured for the audit log.
  payoutHeldAt     DateTime?
  payoutHoldReason String?
  payoutHeldById   String?

  // Shipping
  shippingMethod    ShippingMethod?
  shippingStatus    ShippingStatus?
  trackingReference String?
  dispatchedAt      DateTime?
  deliveredAt       DateTime?

  // Estimated delivery (Phase 5 P5.1). Computed at dispatch from the
  // courier's transit window — best-effort "expected by", never a
  // guarantee. Null for PRIVATE_ARRANGE / DEALER_TRANSFER (no carrier
  // transit the platform can estimate).
  estimatedDeliveryAt DateTime?

  // Proof of delivery (Phase 5 P5.3). podReference is auto-captured from
  // the carrier's delivery event (locker/terminal + time) — carriers don't
  // expose a signature/photo, so this is the best automatic artefact.
  // podProofUrl is an OPTIONAL buyer/seller-uploaded photo kept as dispute
  // EVIDENCE; neither gates payout (that stays on the buyer's confirmDelivery).
  podReference String?
  podProofUrl  String?

  // Pudo locker-to-locker
  pudoDropoffLockerId String? // seller's drop-off locker (set at dispatch)
  pudoPickupLockerId  String? // buyer's chosen pickup locker
  pudoTrackingCode    String?

  // TCG door delivery
  deliveryAddress Json? // { building?, streetAddress, address2?, suburb, city, province, postalCode, lat?, lng? } — contactName + contactPhone resolved from User at shipment-creation time
  tcgWaybill      String?

  // Platform-arranged shipment booking (P5.2). When the seller ACCEPTS a
  // courier sale we book the real shipment with the carrier (Pudo L2L /
  // TCG D2D) and stamp the result here. trackingReference (above) holds the
  // carrier waybill. carrierShipmentId is the ShipLogic id used to fetch
  // the label PDF + cancel. carrierDropoffPin is the Pudo locker drop PIN
  // (null for TCG door-to-door). shipmentBookingStartedAt is an idempotency
  // claim set BEFORE the (wallet-billed) carrier call so a retry/race can
  // never double-book; shipmentBookedAt marks a confirmed booking.
  carrierShipmentId         String?
  carrierDropoffPin         String?
  // WHICH API actually booked this shipment: "PUDO", "TCG" or "BOBGO".
  //
  // Not derivable from shippingMethod any more. Bob Go sits behind BOTH enum
  // slots (its pickup-point rates serve PUDO, its door rates serve TCG), so the
  // method now describes the SHAPE of the delivery, not the company holding the
  // parcel. Every post-booking operation — waybill PDF, cancel, tracking poll,
  // webhook match — must route on THIS, or it will call the wrong carrier's API
  // with an id that carrier has never heard of.
  //
  // It also makes the bobgo_enabled flag genuinely reversible: flip it off
  // mid-flight and shipments already with Bob Go keep being tracked and
  // cancelled through Bob Go, while new sales go back to Pudo/TCG. Without the
  // column, flipping the flag orphans every parcel in the network.
  //
  // Null on historical rows, which all predate Bob Go and are therefore
  // Pudo/TCG — readers must treat null as "derive from shippingMethod".
  // ── Failed shipment + rebook (operator 2026-08-13) ──
  //
  // When a courier collection or delivery fails, the reason is recorded from a
  // fixed ticklist (common/shipment-failure-policy.ts) and the seller may
  // rebook. Where the failure was the SELLER's error — most often a parcel
  // measured smaller than it really is — the wasted courier charge is theirs.
  //
  // failedShipmentChargeCents ACCUMULATES across failures and is subtracted
  // where payouts are computed. It is deliberately NOT applied by mutating
  // sellerPayout: that column is a point-of-sale snapshot of what was agreed
  // and must stay one, so the deduction shows up as its own explainable line
  // rather than silently rewriting the sale.
  shipmentFailureReason     String?
  shipmentFailureNote       String?
  shipmentFailureAt         DateTime?
  failedShipmentChargeCents Int       @default(0)
  // How many times this sale has been re-booked with a carrier. A rising count
  // is the signal that something is wrong with the listing's measurements
  // rather than with any one collection.
  shipmentRebookCount       Int       @default(0)
  carrierProvider           String?
  shipmentBookingStartedAt  DateTime?
  shipmentBookedAt          DateTime?

  // P6.2 — per-seller shipping consolidation. When a buyer buys 2+ items from
  // the SAME seller via the SAME courier method to the SAME destination, they
  // ship as ONE physical parcel / ONE waybill. The FIRST line of the group is
  // the "carrier": it holds the COMBINED shippingCost, the booked shipment and
  // the waybill/PIN/tracking. Every OTHER line points at it via shipsWithId,
  // carries shippingCost 0, is skipped by the booking + dispatch crons, and
  // mirrors the carrier's shippingStatus/dispatchedAt/deliveredAt (propagated
  // on carrier update). Only PUDO/TCG lines consolidate; firearm + collection
  // never enter a cart, so they never carry this. A refund SET NULLs the FK.
  shipsWithId String?
  shipsWith   Transaction?  @relation("ConsolidatedShipment", fields: [shipsWithId], references: [id])
  shippedWith Transaction[] @relation("ConsolidatedShipment")

  // Swop/Trade leg (SWOP). A swap is ONE Swap parent fanning out to TWO
  // Transaction legs (one per shipping direction); seller = the party
  // shipping this leg, buyer = the recipient. Leg money fields stay ZERO —
  // cash + GG fees are captured once on the Swap parent. swapRole marks
  // which item this leg ships.
  swapId   String?
  swap     Swap?     @relation("SwapLegs", fields: [swapId], references: [id])
  swapRole SwapRole?

  // SWOP proof-of-possession (anti-phantom-item). On a swap leg the SENDER
  // photographs the item they're shipping next to a slip bearing this
  // GG-generated per-leg code; Claude vision confirms the code is legible +
  // matches AND the item matches the listing. Funding can't be set up (so no
  // EFT / no shipping) until BOTH legs are APPROVED. Code minted at swap
  // creation so it can't be pre-staged; not unique (scoped to the leg).
  swapProofCode       String?
  swapProofPhotoUrl   String?
  swapProofStatus     String? // null | PENDING_REVIEW | APPROVED | REJECTED
  swapProofScore      Float?
  swapProofFindings   Json?
  swapProofVerifiedAt DateTime?

  // Firearm dealer transfer
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  // KYC gate — populated when seller passes KYC after payment received
  sellerKycClearedAt DateTime?

  // Dispatch SLA — set the first (and only) time the 48h nudge cron
  // sends a "please dispatch" reminder to the seller. Idempotency
  // guard so the cron doesn't spam them every 10 min after the
  // window passes.
  dispatchNudgedAt DateTime?

  // P5.3 — set once when the stuck-funds cron alerts the admin that this
  // courier order was delivered (carrier DELIVERED) but the buyer never
  // confirmed receipt and funds are still HELD. IS NULL filter in the cron
  // makes the admin alert fire exactly once per stuck tx. Operator decision:
  // NO auto-release — the admin reviews + manually releases via the dossier.
  // Mirrors licenceExpiryWarnedAt / dispatchNudgedAt.
  adminAlertedForStuckFundsAt DateTime?

  // Set once when the 48h courier confirm-receipt nudge fires (delivered
  // >=48h ago, buyer never confirmed, still HELD). Sits UNDER the 72h
  // adminAlertedForStuckFundsAt backstop — a gentle self-heal reminder to
  // the forgetful buyer before a human has to chase them. Courier legs only
  // (PUDO/TCG); COLLECTION has its own collectionConfirmNudgedAt path.
  buyerConfirmNudgedAt DateTime?

  // Set once when the in-transit stall sweep alerts the admin that a
  // dispatched courier parcel has had no tracking progress for >7d (carrier
  // lost it, or the Pudo/TCG poll silently returning nothing). Distinct from
  // adminAlertedForStuckFundsAt (which needs deliveredAt); this catches a
  // parcel wedged BEFORE delivery. IS NULL fires it once per stalled parcel.
  adminAlertedForTransitStallAt DateTime?

  // FLOW-F4 (H12/H15) — set once when the DEALER_TRANSFER stall sweep raises
  // the urgent admin alert for a firearm order whose seller accepted but never
  // completed the dealer transfer (dispatchDeadlineAt + grace passed, still
  // HELD, dealer-verify not APPROVED). DT has no auto-refund by design (dealer
  // logistics run long + firearm-specific judgment), so this is the ONLY
  // backstop. IS NULL filter makes the alert fire exactly once per stalled DT.
  adminAlertedForDtStallAt DateTime?

  // FLOW-F6 (H6) — COLLECTION (in-person pickup) stall backstop stamps. A
  // collection order has no dispatch step and is excluded from every courier
  // and DEALER_TRANSFER sweep, so a paid + accepted + never-collected order had
  // no backstop at all. Set once each by sweepStalledCollection: the first when
  // the buyer gets the one-shot "please confirm your collection" nudge, the
  // second when the urgent admin alert fires after the grace window. IS NULL
  // filters make each fire exactly once. NO auto-refund on this path (operator
  // policy — a human resolves from the dossier). Mirrors dispatchNudgedAt /
  // adminAlertedForDtStallAt.
  collectionConfirmNudgedAt        DateTime?
  adminAlertedForCollectionStallAt DateTime?

  // ── Seller accept flow (TOK-7) ───────────────────────────────────
  // Two-step seller workflow: after the buyer pays, the seller has 48h
  // to ACCEPT the transaction (one-tap via SMS), then 5 days from accept
  // to DISPATCH. Without acceptedAt being set the buyer sits in
  // "Awaiting seller accept" status on their order page.
  //
  // Migration: every transaction with paidAt set at deployment time
  // gets `acceptedAt = paidAt` backfilled so the new acceptance gate
  // doesn't suddenly trap legacy in-flight orders.
  //
  // accept/dispatch deadlines are stored so the UI countdown chips
  // can use a single field instead of recomputing paidAt+48h on every
  // render, and the cron can do an indexed scan on the deadline column.
  acceptedAt           DateTime?
  acceptDeadlineAt     DateTime? // = paidAt + 48h, set when payment captured
  // Mid-window "24h left to accept" reminder to the seller — stamped by the
  // accept sweep so it fires exactly once per sale.
  acceptReminderSentAt DateTime?
  dispatchDeadlineAt   DateTime? // = acceptedAt + 5d, set when seller accepts

  // Seller rejection of the sale — instead of accepting, seller can
  // reject. Triggers Peach refund + buyer notification. rejectedReason
  // surfaces in the buyer's notification and in the admin audit log.
  rejectedAt     DateTime?
  rejectedReason String?

  // Set when the 48h-no-accept cron escalates the order to the admin
  // queue (operator-confirmed 2026-05-27: no auto-refund on this
  // timeout, admin manually decides). Idempotency guard against the
  // cron raising the same flag every 10 min.
  acceptEscalatedAt DateTime?

  // PRIVATE_ARRANGE explicit consent. The buyer ticked two checkboxes
  // and typed "I UNDERSTAND" at checkout to acknowledge that payment
  // protection ends at payment capture — the seller is paid
  // immediately and contact details are revealed to both parties so
  // they can coordinate the dealer meet. Without this column being
  // set, the immediate-payout branch in markPaid() refuses to fire
  // (defence in depth against a buyer hitting the API without going
  // through the consent screen).
  privateArrangeAcceptedAt DateTime?

  // M33 — set when the buyer ticks the 18+/SAPS-competency attestation at
  // checkout on an isFirearm listing. The hard gate lives in
  // transactions.service (reserveAndCreateLine); this column is the durable
  // record of it. It was a log line for a while, which is not evidence you can
  // produce to a regulator — a firearm sale has to be provable from the row.
  firearmAttestationAcceptedAt DateTime?

  // Set when a buyer ticks the collection papers acknowledgement at
  // checkout on a requiresPapers (trailer / caravan) listing — durable
  // evidence they affirmed they'll collect in person and receive the
  // registration / roadworthy papers at handover. Same boolean-gate →
  // *At-evidence pattern as the firearm attestation above.
  collectionPapersAckAt DateTime?

  // UNCONDITIONAL buyer acknowledgement, ticked before payment on EVERY
  // purchase: they have seen where the item is, and accept that location and
  // travel distance are not refund grounds. Same boolean-gate → *At-evidence
  // pattern as the two attestations above — the hard gate is in
  // reserveAndCreateLine; these three columns are what you produce in a
  // dispute.
  //
  // CPA s49 is the reason this is a tick and not a line in the Terms: a term
  // limiting a consumer's rights has to be in plain language, the consumer's
  // attention has to be drawn to it specifically, and they have to assent.
  buyerTermsAckAt      DateTime?
  // SERVER-derived version of the wording shown. Deliberately not the
  // User.consentPolicyVersion pattern, which is client-supplied and
  // overwritable — a version the client can choose is not evidence.
  buyerTermsAckVersion String?   @db.VarChar(40)
  // The exact vicinity string rendered above the tick, e.g. "Centurion,
  // Gauteng". SNAPSHOTTED because Listing.publicLocality stays editable after
  // the sale, so a join proves what the listing says today, not what the buyer
  // was shown. A bare timestamp proves a box was ticked, not what it said.
  buyerLocationShown   String?   @db.VarChar(120)

  // ─── Hunting Packages / Experiences (EXP-E1 checkout → HELD) ─────────
  // An experience is a future-dated ON-SITE service (ShippingMethod.
  // ON_SITE_SERVICE): no courier, no parcel, delivered on eventDate at a
  // venue. The buyer books a specific date the outfitter offered (must
  // fall inside listing.eventStartDate..eventEndDate) for a party of
  // partySize (≤ listing.capacitySlots). Full value is HELD until the
  // buyer confirms the experience happened (release is a later phase).
  eventDate    DateTime? // the specific date booked (within the listing window)
  eventEndDate DateTime? // copy of listing.eventEndDate for a multi-day window
  partySize    Int? // hunters / guests on this booking (≥1, ≤ capacitySlots)

  // Buyer attestation evidence stamps — mirror the firearm 18+ boolean →
  // hard server check → *At evidence column pattern (transactions.service
  // reserveAndCreateLine). All five are HARD-required true at experience
  // checkout; each *At is durable proof the buyer affirmed at booking time
  // (CPA disclosure + dispute defence).
  experienceAttested18PlusAt       DateTime? // (1) 18+
  experienceLicenceOrSupervisionAt DateTime? // (2) firearm licence/competency OR outfitter-supervised
  experienceIntermediaryAckAt      DateTime? // (3) GG is a payment-protection intermediary; outfitter is the supplier
  experienceCancellationAcceptedAt DateTime? // (4) accept CPA-s17 cancellation policy
  experienceRisksAcceptedAt        DateTime? // (5) accept hunting risks

  // ─── Experience booking lifecycle (added inert in E1; driven later) ──
  // Populated by E2 (accept + completion release), E3 (cancellation) and E4
  // (SLA cron + dispute). Added now so the E1 additive migration carries the
  // whole column set and later phases need no further Transaction migration.
  bookingConfirmedAt                DateTime? // outfitter accepted the booking
  bookingDeclinedAt                 DateTime? // outfitter declined → full refund
  bookingDeclinedReason             String?
  bookingConfirmDeadlineAt          DateTime? // = paidAt + 48h; outfitter-accept window
  bookingConfirmNudgedAt            DateTime? // SLA one-shot: "please confirm this booking"
  bookingConfirmEscalatedAt         DateTime? // SLA one-shot: unconfirmed past deadline → admin
  eventCompletedConfirmedAt         DateTime? // buyer confirmed the experience happened → release
  eventPreReminderSentAt            DateTime? // SLA one-shot: ~3d-out reminder
  eventCompletionNudgedAt           DateTime? // SLA one-shot: post-event "confirm it happened"
  adminAlertedForEventUnconfirmedAt DateTime? // SLA one-shot: still HELD after event+grace → admin
  cpaCancelTier                     String? // which CPA-s17 cancellation tier was applied
  cpaAdminFeeCents                  Int? // GG-retained admin fee slice on a 60+ day cancel

  // ─── Dealer-stock-in verification (firearm DEALER_TRANSFER only) ──
  // When the firearm is delivered to the chosen SAPS-licensed dealer,
  // the seller uploads 3 photos (SAPS 534 form, last line of dealer's
  // stock register, firearm with serial visible). Claude vision scans
  // them against a rubric and writes the result here. Payout release
  // for firearm DEALER_TRANSFER transactions is gated on
  // dealerVerificationStatus = 'APPROVED'.
  //
  // Status lifecycle:
  //   null               — not applicable (non-firearm, or PRIVATE_ARRANGE)
  //   PENDING_UPLOAD     — seller hasn't submitted photos yet
  //   PENDING_CLAUDE     — photos uploaded, Claude scan in progress
  //   PENDING_ADMIN_REVIEW — Claude returned 50-79% confidence, admin must review
  //   APPROVED           — auto (≥80% all criteria) or admin override
  //   REJECTED           — auto (<50% on any criterion) or admin reject; seller must reshoot
  //
  // The Cloudinary URLs are nullable so admin can render whichever
  // ones uploaded successfully (one-or-two-failed retry path).
  saps534PhotoUrl            String?
  stockRegisterPhotoUrl      String?
  firearmSerialPhotoUrl      String?
  dealerVerificationStatus   String?
  // 0..100, weighted average of per-criterion confidence scores.
  dealerVerificationScore    Float?
  // Full structured JSON returned by Claude — per-criterion scores +
  // extracted values + issues list. Stored verbatim for audit + so
  // the admin panel can re-render Claude's reasoning without a re-run.
  dealerVerificationFindings Json?
  dealerVerifiedAt           DateTime?
  // Reshoot cap — incremented on every dealer-verification upload attempt
  // (each burns a Claude vision call + 3 Cloudinary uploads). Past a cap the
  // upload is blocked and the tx is escalated to a human review queue instead
  // of letting a persistently-bad (or hostile) seller loop forever.
  dealerVerifyAttempts       Int       @default(0)
  // Stock-register entry number the dealer (or seller) types in, for
  // SAPS audit cross-reference. Optional — not always available at
  // upload time.
  dealerStockRegisterRef     String?

  // ── Stocked-at dealer contact (sent to buyer on payout release) ──
  // When verification approves, Gun Galore's job ends. We notify the
  // buyer of WHERE the firearm is — the dealer the seller dropped it
  // at — so the buyer can arrange their own inter-dealer transfer or
  // collection. Captured on the seller's verification upload form
  // alongside the 3 photos; surfaced on the buyer's transaction page
  // and in the payout-released notification email/SMS.
  stockedAtDealerName    String?
  stockedAtDealerAddress String?
  stockedAtDealerPhone   String?

  // ── Zoho Books linkage ────────────────────────────────────────────
  // Documents created in Books for this transaction:
  //   - zohoCommissionInvoiceId: Gun Galore → Seller invoice for the
  //     platform commission. Created on verification APPROVED.
  //   - zohoCommissionPaymentId: the payment record that marks the
  //     invoice paid. Created when the seller payout fires.
  //   - zohoCreditNoteId: only set on refund — credit note against
  //     the original commission invoice.
  //
  // zohoSyncStatus tracks the most recent attempt:
  //   - null / 'IDLE': nothing has tried to sync yet
  //   - 'PENDING': sync attempt in flight
  //   - 'OK': latest attempt succeeded
  //   - 'FAILED': latest attempt failed (see zohoSyncError + zohoSyncLastAttemptAt)
  //   - 'SKIPPED': feature flag was off when the event fired
  zohoCommissionInvoiceId String?
  zohoCommissionPaymentId String?
  zohoCreditNoteId        String?
  // ── Daily Deals first-party Zoho (DD-2) ─────────────────────────────
  // A house deal (Listing.isDealListing) is a FIRST-PARTY sale: GG is the
  // seller, so there is no commission invoice + payout. Instead a
  // full-amount Sales Receipt is posted to the BUYER at RELEASED, and a
  // Credit Note against it on a post-release refund. These IDs are kept
  // SEPARATE from zohoCommissionInvoiceId/zohoCreditNoteId on purpose — a
  // Sales Receipt is a different Books object type, so mixing the ids
  // would make markCommissionInvoicePaid do a wrong-type /invoices lookup.
  zohoDealReceiptId       String?
  zohoDealCreditNoteId    String?
  zohoSyncStatus          String?
  zohoSyncError           String?
  zohoSyncLastAttemptAt   DateTime?

  // ── Manual EFT payment (PAYMENT_MODE=manual) ────────────────────────
  // While there is no live card gateway, buyers pay GG by EFT using
  // `orderReference` as their bank reference. The site matches FNB
  // inContact alerts (provisional) + the daily FNB statement
  // (authoritative) against this reference + the exact amount. Distinct
  // from the listing's own reference number; unique per order.
  orderReference    String?   @unique
  // EFT lifecycle: manualDetectedAt = an inContact alert matched
  // (provisional, seller NOT yet notified); manualVerifiedAt = the FNB
  // statement confirmed it (authoritative → markPaid runs).
  manualDetectedAt  DateTime?
  manualVerifiedAt  DateTime?
  // 24-hour pay-by deadline shown to the buyer. The item stays reserved
  // for the committed buyer for the full window (long enough that the
  // daily statement reconciliation runs at least once while it's still
  // theirs); the freeze-expiry cron only releases the listing back to
  // ACTIVE if NOTHING has been detected/paid by then.
  manualPayByAt     DateTime?
  // Set when the freeze-expiry cron soft-cancels an un-paid manual order
  // (releases the listing but KEEPS this row so a LATE statement payment
  // for orderReference can still be matched → surfaced as "paid after
  // expiry" for admin refund/re-fulfil instead of being lost).
  manualCancelledAt DateTime?
  // Payment-reminder idempotency guards: a "12 hours left" and a
  // "1 hour left" SMS nudge across the 24h window.
  manualWarn12hAt   DateTime?
  manualWarn1hAt    DateTime?

  // Admin
  adminNote         String?
  adminReviewedById String?
  adminReviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages            Message[]
  trackingEvents      TrackingEvent[]
  complaints          Complaint[]
  rating              Rating?
  confirmedDeliveryAt DateTime?
  // peachPaymentId now has a @unique on the field (creates its own index).

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([paymentStatus])
  @@index([manualPayByAt])
  // Payout due-queue: RELEASED/REFUNDED rows not yet paid out.
  @@index([paymentStatus, paidOutAt])
  // P0.3 — refund children lookup (parent → its synthetic refund slices).
  @@index([refundOfId])
  // P6.2 — consolidated-shipment group lookup (carrier → its sibling lines).
  @@index([shipsWithId])
  // EXP-E1 — experience booking sweeps: the SLA cron scans HELD
  // ON_SITE_SERVICE rows by event date (nudge/reminder/escalate windows).
  @@index([shippingMethod, paymentStatus, eventDate])
}

// Append-only timeline of shipping + payment milestones per Transaction.
// Powers the buyer/seller-facing tracking UI on /transactions/[id].
//
// Two writers:
//   1. Internal flow — we record a row at each state change we own
//      (paid, dispatched, delivered confirmed, payout released). These
//      rows have source=INTERNAL.
//   2. Polling cron — every 10 min the cron asks Pudo (and later TCG)
//      for the parcel's tracking_events, maps carrier statuses to our
//      internal status via status-map.ts, then appends any events we
//      haven't seen yet. These rows have source=PUDO or source=TCG.
//
// Idempotency: the @@unique([transactionId, status, occurredAt]) tuple
// stops the cron from inserting the same carrier event twice if it
// re-appears in a later poll. occurredAt is the carrier's timestamp
// (or now() for internal events); recordedAt is when our system first
// observed it. status uses the collapsed internal vocabulary from
// status-map.ts (PUDO_PIN_ISSUED, PARCEL_DROPPED_OFF, AT_LOCKER, etc).
model TrackingEvent {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Collapsed internal vocabulary (see status-map.ts). Free string so
  // we don't have to migrate the schema each time a new carrier status
  // gets added to the map.
  status    String
  // Raw carrier value before mapping ("ARRIVED_AT_LOCKER" / "Out For
  // Delivery" / etc). Null for INTERNAL-sourced events.
  rawStatus String?
  // INTERNAL | PUDO | TCG — who reported this event.
  source    String
  // Human-readable line shown on the timeline. Optional; the UI falls
  // back to a per-status default when null.
  message   String?

  // When the event happened from the carrier's perspective (or our
  // system's clock for INTERNAL events). Used for sort order on the
  // timeline + as part of the idempotency key.
  occurredAt DateTime
  // When our system first wrote this row.
  recordedAt DateTime @default(now())

  @@unique([transactionId, status, occurredAt])
  @@index([transactionId])
}

// Self-improving FAQ panel that sits on every listing's detail page.
// Replaces buyer/seller messaging entirely — see CLAUDE.md and the
// design note in chat history. Two Claude passes per question:
//
//   Pass 1 (Haiku — moderation): is this a product-info question?
//     Reject anything off-topic, contact-detail-leaking, or trying to
//     negotiate price (price moves through the Offer system, not
//     Q&A). Rejected rows stay in the table for audit but never go
//     public.
//
//   Pass 2 (Sonnet — semantic dedup): if pass 1 passed, look at all
//     prior ANSWERED_BY_SELLER rows for this listing within the last
//     30 days. If one semantically matches, auto-publish the answer
//     using the seller's prior reply (rewritten in fresh voice) and
//     set autoAnsweredFromQuestionId for traceability. If no match,
//     status → AWAITING_SELLER_ANSWER and the seller is notified.
//
// Sellers can flag an AI answer as "not right" → invalidates the
// source Q so it won't auto-answer again, and the seller writes a
// fresh manual reply. Buyers can flag any public row → admin review.
model ListingQuestion {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId   String
  asker     User    @relation("AskedQuestions", fields: [askerId], references: [id])

  question String

  // Claude pass 1 — moderation. APPROVE / REJECT and the public-facing
  // reason ("Keep it to product details", etc).
  questionDecision String? // 'APPROVE' | 'REJECT'
  questionReason   String?

  status ListingQuestionStatus @default(PENDING_MODERATION)

  // Answer fields — populated when a seller answers manually OR when
  // Claude auto-answers from a prior Q. answeredByUserId is null in
  // the auto-answer case (the asker still attributes it to "Gun
  // Galore AI" in the UI).
  answer           String?
  answeredByUserId String?
  answeredByUser   User?     @relation("AnsweredQuestions", fields: [answeredByUserId], references: [id])
  answeredAt       DateTime?

  // When the answer came from Claude pass 2 — this points at the
  // source ListingQuestion whose seller-written answer we re-used.
  // Lets us surface "based on a prior question" in the UI + lets the
  // seller invalidate the source if the AI got it wrong.
  autoAnsweredFromQuestionId String?
  autoAnsweredFrom           ListingQuestion?  @relation("AutoAnswerSource", fields: [autoAnsweredFromQuestionId], references: [id])
  autoAnswers                ListingQuestion[] @relation("AutoAnswerSource")

  // Seller pressed "this isn't right" on an AI-published answer →
  // we set invalidatedAt on the SOURCE Q (the one Claude reused),
  // which excludes it from future dedup matches. The bad AI answer
  // gets status=HIDDEN until the seller writes a fresh reply.
  invalidatedAt DateTime?

  // Public-panel state + abuse signal.
  reportedCount Int     @default(0)
  isPublic      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, status])
  @@index([askerId])
  @@index([answeredByUserId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  firstName    String?
  lastName     String?
  // Optional link to the Clerk user record (mirrored into our User
  // table). When set, outbound alerts (SMS + email) are pulled from
  // User.phone / User.email so we never duplicate contact info between
  // tables. Nullable so the seed superadmin (and any legacy admin
  // created before Clerk-linkage) keeps working with email+password.
  clerkId      String?   @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Back-relation for AdminAuditEvent.adminUser (every audit row is
  // attributed to the admin who triggered it).
  auditEvents              AdminAuditEvent[]
  // Back-relation for ReloadingManual.uploadedByAdmin — admin who
  // ingested a reloading manual via the inbox-scan flow.
  reloadingManualsUploaded ReloadingManual[] @relation("ReloadingUploader")
}

// Cross-resource audit trail for every destructive admin action.
// Each row is one admin operation: who did it, when, on what, what
// changed (oldValue → newValue), and the reason they typed at the
// time. Read-only from the UI; only inserted by AdminAuditService.
// Domain-specific audit tables (FeaturedSlotAuditEvent) stay as-is for
// module-specific event types; this table captures the
// broad ops surface — user bans / tier changes / KYC overrides /
// transaction refunds / etc.
model AdminAuditEvent {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id])
  // Free-form action verb — e.g. "USER_BAN", "USER_UNBAN",
  // "USER_TIER_CHANGE", "USER_KYC_OVERRIDE", "TRANSACTION_REFUND",
  // "LISTING_FORCE_HIDE". String not enum so new actions don't need
  // schema migrations.
  action       String
  // Resource being acted upon — usually a User.id, Transaction.id,
  // Listing.id. Nullable for actions that don't have a single target.
  resourceType String? // 'User' | 'Transaction' | 'Listing' | ...
  resourceId   String?
  // Snapshot of what changed. Both nullable so single-direction
  // events (e.g. force-hide a listing) can record just newValue.
  oldValue     String? // JSON-stringified
  newValue     String? // JSON-stringified
  // Reason the admin typed in the confirmation dialog. NOT nullable
  // for any USER_* / TRANSACTION_* / LISTING_* action; the service
  // enforces this at insert time.
  reason       String
  createdAt    DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// Free-form audit channel for ops to see and act on. Currently raised
// by the KYC service when a seller fails face-match 3+ times in a row —
// the next step is for an admin to call them or override the decision
// manually. `type` is a free string (e.g. "KYC_REPEATED_FAILURE") so
// new categories can be added without a schema change. `referenceId`
// is whatever the row is about (usually a User.id).
model AdminAlert {
  id          String    @id @default(cuid())
  type        String
  referenceId String?
  context     String?
  urgent      Boolean   @default(false)
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([resolved])
}

// Persisted record of every contact-detail filter block. Powers:
//   - command-center "fee bypass attempts (7d)" attention card
//   - /admin/trust-safety queue (grouped by user, with sample text)
//   - repeat-offender detection (≥N rejections in window → ban candidate)
//
// Stored even when we don't know the user (e.g. failed clerkId lookup)
// — userId nullable, sampleText capped at 200 chars to avoid storing
// the whole flagged note when a buyer pastes a long block.
//
// `channel` is a free string (offer-note, counter-note, rating-comment,
// future: message-content) so new wire-in sites don't need a migration.
// `category` mirrors the ContactDetailFilterService RejectCategory
// enum: phone | email | url | social-platform | off-platform-coordination | address.
model ContactDetailRejection {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel    String
  category   String
  sampleText String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([category])
}

model Rating {
  id                String      @id @default(cuid())
  transactionId     String      @unique
  transaction       Transaction @relation(fields: [transactionId], references: [id])
  raterId           String
  rater             User        @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedId           String
  rated             User        @relation("RatingsReceived", fields: [ratedId], references: [id])
  stars             Int // 1–5
  comment           String?
  // Seller reply (one public response per review — industry standard).
  sellerResponse    String?
  sellerRespondedAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  @@index([ratedId])
}

model Message {
  id              String      @id @default(cuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  senderClerkId   String
  content         String
  originalContent String? // populated when content was auto-stripped by moderation
  wasModerated    Boolean     @default(false)
  readAt          DateTime?
  createdAt       DateTime    @default(now())

  @@index([transactionId, createdAt])
}

model Offer {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User    @relation("BuyerOffers", fields: [buyerId], references: [id])

  offerAmount   Int // ZAR cents — buyer's initial offer
  counterAmount Int? // ZAR cents — seller's counter (one only)
  buyerNote     String?
  sellerNote    String?
  status        OfferStatus @default(PENDING)
  // How many offers this buyer has made on this listing across the row's
  // lifetime. Re-offers after a REJECTED/WITHDRAWN/EXPIRED close UPDATE
  // this same row back to PENDING (preserving the audit identity) and
  // bump the count; capped at 5 so a buyer can't pester a seller
  // indefinitely (eBay-style attempt limit).
  attemptCount  Int         @default(1)

  // Snapshot: offer met the listing's auto-accept threshold at submit time.
  // Auto-accept no longer accepts instantly (operator 2026-07-23) — the
  // seller always confirms; this flag drives the louder notification and
  // the OFFER_TOO_LOW rejection penalty.
  metAutoAccept Boolean @default(false)
  // Seller rejection: structured reason (ticklist) + optional note.
  rejectReason  String?
  rejectNote    String?

  // buyer has 24h to respond to a counter
  expiresAt DateTime

  // Set once when the offer-expiry cron sends the seller a "your offer is
  // about to lapse" reminder (PENDING offers with expiresAt within 12h).
  // IS NULL filter fires the reminder exactly once per offer; re-offers
  // that reopen this row back to PENDING clear it so the fresh window can
  // be reminded again. Mirrors acceptReminderSentAt on Transaction.
  sellerRemindedAt DateTime?

  // Set once when the ACCEPTED-offer pay-window reminder nudges the buyer
  // (expiresAt within 6h, still ACCEPTED, no checkout) before the unpaid
  // lapse strikes them. Cleared on re-offer. Mirrors winnerRemindedAt.
  buyerPayRemindedAt DateTime?

  // link to transaction once CONVERTED
  transactionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId]) // one active offer per buyer per listing
  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Auction system — Bid + AuctionWatch
// ---------------------------------------------------------------------------

model Bid {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User    @relation("BidderBids", fields: [bidderId], references: [id])

  // Public visible bid amount in ZAR cents (what other users see in history).
  // The bidder's true max (proxy) is held separately and never exposed.
  amount    Int
  maxAmount Int // private — auto-bid ceiling

  // Snapshot of whether THIS bid won the auction once it ended.
  // Set by the end-auctions cron; null while auction is live.
  isWinner Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([bidderId])
}

model AuctionWatch {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
  @@index([userId])
}

// User ↔ Listing wishlist join. One row per saved listing. Cascade-
// deletes both sides so a removed user / listing cleans up without a
// background job. The compound unique stops accidental duplicates
// (the wishlist service relies on this for upsert semantics). The
// (userId, createdAt) index supports the "newest first" ordering on
// /wishlist without a sort.
//
// Naming: kept as "WatchedListing" rather than "WishlistEntry" so
// that future "X people watching this" social-proof rollups can
// .count() on the same table directly without renaming.
model WatchedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
}

// P5.1 — Saved search. A user persists their current browse filters and
// gets an in-app + push alert when a NEW ACTIVE listing matching them is
// published. THE retention mechanism for a thin-supply marketplace: it
// converts a failed "no Hilux canopy today" search into a return visit
// when one lists.
//
// Filter fields mirror the browse contract (BrowseListingsDto / the
// browseViaPrisma where-builder) so the matcher cron rehydrates the exact
// same query. Enum-ish fields (listingType/condition/province) are stored
// as validated strings — the matcher passes them straight into the same
// Prisma where the browse uses. `attrs` (per-category attribute filters)
// is captured for round-tripping the search URL but is NOT applied by the
// matcher (Meili-only in browse — documented limitation; a saved search
// with attrs simply over-matches on that dimension).
//
// `fingerprint` is a canonical hash of the filter set → the @@unique lets
// "Save this search" be idempotent (re-saving the same filters updates the
// row instead of duplicating). `notifyEnabled` is the per-search POPIA
// pause/opt-out. `lastNotifiedAt` is the notify cursor: the matcher only
// considers listings created after it (first run falls back to createdAt
// so a brand-new search never blasts the entire back-catalogue).
model SavedSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional friendly name; the UI falls back to a generated label.
  label String?

  // ── Captured browse filters (mirror BrowseListingsDto) ──
  q            String? // free-text term (matcher approximates via title/description contains)
  categoryId   String?
  categorySlug String?
  listingType  String? // BUY_NOW | AUCTION | TAKE_A_SHOT | SWOP
  condition    String?
  province     String?
  make         String? // matched EXACTLY against Listing.make
  minPrice     Int? // ZAR cents
  maxPrice     Int? // ZAR cents
  sort         String?
  attrs        String? // URL-encoded JSON; round-trips the URL, NOT applied by the matcher

  fingerprint    String // canonical hash of the filter set (idempotent save)
  notifyEnabled  Boolean   @default(true)
  lastNotifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId, createdAt(sort: Desc)])
  @@index([notifyEnabled])
}

// Browser / installed-PWA push subscription. Created when the user
// taps "Enable push notifications" → the browser calls
// pushManager.subscribe() and returns an endpoint URL + two crypto
// keys. We store one row per device per user.
//
// `endpoint` is globally unique (a per-device URL on the push
// gateway — FCM for Android Chrome / Mozilla autopush for Firefox /
// APNS for iOS Safari). Used as the upsert key so a single device
// can only have one active subscription per user.
//
// `category` array lets users mute one notification category without
// muting all of them (e.g., disable ACCOUNT push but keep BUYER /
// SELLER). Default = all three categories enabled.
//
// `lastUsedAt` is bumped each time we successfully push to this
// endpoint. A weekly cron prunes subscriptions where lastUsedAt is
// > 90 days old (the device probably uninstalled the PWA / cleared
// SW). Cascade-deletes with the user.
model PushSubscription {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String                 @unique
  p256dh     String
  auth       String
  userAgent  String?
  category   NotificationCategory[] @default([BUYER, SELLER, ACCOUNT])
  createdAt  DateTime               @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// Single-row settings table for feature flags + global config.
// Looked up by key. Values are strings (parse as needed).
// PAYMENT_MODE = 'manual' (FNB EFT) | 'paygate' (Stitch, dormant) lives here.
// Raw Bob Go webhook payloads, kept verbatim.
//
// Bob Go's status vocabulary is only partly known — we have observed
// pending-rates, success, no-rates and pending-collection, and nothing else.
// status-map.ts maps carrier statuses by SUBSTRING, which is how an unseen
// "ready_for_pickup" would be read as "out for delivery" and "expired" as a
// terminal delivery failure. Rather than guess the rest, the webhook receiver
// stores every payload whole and refuses to apply statuses it does not know.
// This table is the evidence the map gets widened from.
//
// Stored whole (Json, not parsed columns) precisely because the value is in the
// fields we did NOT know to ask for. Prunable — it is an observation log, not
// money state, and nothing reads it on a hot path.
model BobGoWebhookEvent {
  id         String   @id @default(cuid())
  topic      String
  // WHICHEVER identifier the topic carried. Most topics send the numeric
  // shipment id ("16626"); `tracking/updated` sends the TRACKING REFERENCE
  // ("UASSW3HJ") in the same `id` field. Verified: one booking produced four
  // events keyed on the number and one keyed on the reference. So a query for
  // a numeric id will NOT return that shipment's tracking rows — look them up
  // by trackingReference too. Nullable: an unrecognised topic may carry
  // neither, and a payload we cannot attribute is still worth keeping.
  shipmentId String?
  payload    Json
  createdAt  DateTime @default(now())

  @@index([shipmentId])
  @@index([topic, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// The manual-EFT reconciliation models (ManualPayment inContact/statement
// audit rows, StatementUpload upload history) and their enums have been
// removed with the manual-EFT payment rail. The money-state (Transaction /
// Order / OrderLineItem) is rail-agnostic and unchanged.

// Atomic counter for per-prefix reference numbers (UM / AU / TS).
// Used by ListingsService to allocate the next number at create time.
// Increment is done via Prisma's atomic { increment: 1 }
// inside an upsert so concurrent creates don't collide on the same
// number. One row per prefix; created on first allocation.
model ReferenceCounter {
  prefix    String   @id // 'UM' | 'AU' | 'TS' | 'RA'
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Failed notification emails awaiting retry. A Resend outage previously
// LOST the email (logged only); now send() enqueues here and a 10-min cron
// re-attempts with backoff (max 5 tries, then an AdminAlert + drop). Rows
// are deleted on success — this table should normally be empty.
model EmailOutbox {
  id            String   @id @default(cuid())
  toAddress     String
  subject       String
  html          String
  attempts      Int      @default(0)
  nextAttemptAt DateTime
  lastError     String?
  createdAt     DateTime @default(now())

  @@index([nextAttemptAt])
}

// SMS marketing campaigns — a short key carried in outbound SMS links
// (gungalore.co.za/?c=KEY). Arriving with an ACTIVE key shows the welcome
// banner overlay once per browser session; plain visits never see it.
// hits counts banner-shown arrivals = per-blast click attribution.
model MarketingCampaign {
  id        String    @id @default(cuid())
  key       String    @unique // short URL token, e.g. "j26"
  name      String // internal label, e.g. "July 2026 launch SMS"
  headline  String? // banner headline override; null = default copy
  active    Boolean   @default(true)
  hits      Int       @default(0)
  lastHitAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Load Lab cartridge reference specs — standardised chamber/pressure data
// derived from our GRT (Gordon's Reloading Tool) extraction, matched to the
// Load Lab cartridgeKey. REFERENCE dimensions (SAAMI/CIP standardised),
// NOT load recipes: max pressure, case length, overall length, case
// capacity + a link to the official CIP/SAAMI datasheet. Every row was
// adversarially match-verified before seeding; wildcats without a real
// standard are labelled as such. Static data — refreshed by re-running the
// seed loader, never written at runtime.
model CartridgeSpec {
  cartridgeKey         String   @id // joins ManualLoad.cartridgeKey
  displayName          String
  grtName              String // the reference cartridge name matched
  standard             String // 'CIP' | 'SAAMI' | 'WILDCAT' | 'OTHER'
  origin               String? // country of origin (US, DE, GB, …)
  cartridgeType        String? // GRT ciptype, e.g. "1 rimless"
  year                 Int? // standardisation / introduction year
  caseLengthMm         Float? // L3
  maxCartridgeLengthMm Float? // L6 (max overall length)
  maxPressureBar       Int? // Pmax
  maxPressurePsi       Int? // Pmax converted (bar × 14.5038)
  caseCapacityGrH2O    Float? // V — case capacity in grains of water
  officialPdfUrl       String? // CIP TDCC / SAAMI datasheet link
  updatedAt            DateTime @updatedAt
}

// Outbound SMS audit log — every send (whether real, stubbed, or
// failed) writes a row here. We use it for debugging delivery issues
// and to prove a verification code was actually dispatched. Each row
// is tied to a free-text reference (e.g. "phone-change-USERID") so we
// can group all attempts for a single flow.
model SmsLog {
  id        String   @id @default(cuid())
  to        String // E.164-normalised destination ("+27...")
  message   String
  reference String?
  status    String // 'SENT' | 'FAILED' | 'STUB'
  messageId String? // SMSPortal's id, when available
  error     String?
  createdAt DateTime @default(now())

  // Retry bookkeeping. SMS was one-shot (a FAILED row was dead) while email
  // has an outbox+retry. attempts counts sends of THIS message (initial = 1).
  // retryable is opt-in per send — PIN/waybill/refund notices set it true;
  // time-sensitive OTP codes (phone-change) NEVER retry (a code redelivered
  // 20min later is expired + confusing). nextRetryAt is the due time the retry
  // cron scans; nulled when SENT or attempts exhausted.
  attempts    Int       @default(1)
  retryable   Boolean   @default(false)
  nextRetryAt DateTime?

  @@index([reference])
  @@index([createdAt])
  // Retry cron hot path: FAILED + retryable + due.
  @@index([status, nextRetryAt])
}

// ---------------------------------------------------------------------------
// Featured-slot system (paid left-rail placement)
//
// 10 hard-allocated slots rotate via per-slot auctions. Each slot has:
//   - A current occupant (a listing + seller + featuredUntil) when filled
//   - A pre-auction that opens 24h before the occupant's featuredUntil,
//     closes at featuredUntil sharp, winner takes over with zero gap
//   - An ad-hoc 2h auction if the slot frees unexpectedly (occupant's
//     listing sold mid-feature, or admin force-evicted)
//
// Seller flow: bid first → win → 15-min bind window to pick an active
// listing → Peach charged → listing goes featured for the tier duration.
// Losers walk away (no rollover). One seller can hold multiple slots.
// ---------------------------------------------------------------------------

model FeaturedSlot {
  id String @id @default(cuid())

  // 1-10. Hard-allocated at seed. The rail's vertical order matches this.
  slotNumber Int @unique

  status FeaturedSlotStatus @default(VACANT)

  // The listing currently displayed in this slot (null when VACANT or
  // AUCTION_RUNNING or BIND_WINDOW with the winner not yet bound).
  currentListingId String?  @unique
  currentListing   Listing? @relation("FeaturedSlotListing", fields: [currentListingId], references: [id])

  // Quick-lookup denormalisation — the seller who owns the current
  // listing. Also used to enforce "can't bid on a slot you own".
  currentSellerId String?
  currentSeller   User?   @relation("FeaturedSlotOccupant", fields: [currentSellerId], references: [id])

  // When the current occupant's featured time ends. Cron tick promotes
  // the next auction's winner at this exact moment.
  featuredUntil DateTime?

  // Auction tracking. `currentAuctionId` is the auction that's either
  // OPEN now (pre-auction or ad-hoc) or recently closed and in the
  // BIND_WINDOW phase. Cron creates new auctions as slots free up.
  currentAuctionId String?                  @unique
  currentAuction   FeaturedAuction?         @relation("SlotCurrentAuction", fields: [currentAuctionId], references: [id])
  auctions         FeaturedAuction[]        @relation("SlotAuctions")
  events           FeaturedSlotAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featuredUntil])
}

model FeaturedAuction {
  id String @id @default(cuid())

  slotId String
  slot   FeaturedSlot @relation("SlotAuctions", fields: [slotId], references: [id], onDelete: Cascade)

  // The back-relation for FeaturedSlot.currentAuction (1:1 to a single
  // auction at any time). Listed without fields so Prisma can wire it.
  slotAsCurrent FeaturedSlot? @relation("SlotCurrentAuction")

  kind   FeaturedAuctionKind
  status FeaturedAuctionStatus @default(OPEN)

  // The auction OPENS the moment the slot becomes vacant (closesAt
  // null = waiting for first bid). On the first bid, the bid handler
  // sets closesAt = now + bidWindowSec (24h by default). Subsequent
  // bids during the window do NOT reset it — the winner is whoever
  // has the highest bid when the timer hits zero.
  openedAt DateTime  @default(now())
  closesAt DateTime?
  closedAt DateTime?

  // Snapshot of the winning bid once closed. Null while OPEN.
  winningBidId String?          @unique
  winningBid   FeaturedSlotBid? @relation("AuctionWinningBid", fields: [winningBidId], references: [id])

  bids FeaturedSlotBid[] @relation("AuctionBids")

  @@index([slotId, status])
  @@index([closesAt])
}

model FeaturedSlotBid {
  id String @id @default(cuid())

  auctionId String
  auction   FeaturedAuction @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)

  bidderId String
  bidder   User   @relation("FeaturedSlotBidder", fields: [bidderId], references: [id])

  // ZAR cents. Backend snaps to nearest tier on submit. This is the
  // FACE bid — what the bidder is "saying" they'd pay, and what the
  // leaderboard uses for ranking. The actual cents collected is
  // `chargedAmountCents` (set at charge time).
  amountCents Int
  tier        FeaturedTier

  // Buy-Now purchase (skip-the-auction premium). When true this row is
  // NOT an auction bid — the seller paid a fixed 2× the tier's base price
  // to claim the slot outright + immediately, bypassing the auction. The
  // `tier` still drives the featured DURATION; `amountCents` holds the 2×
  // base (pre-discount) and `chargedAmountCents` the cash collected. Lets
  // revenue reports + /my/bids distinguish outright purchases from bids.
  isBuyNow Boolean @default(false)

  // Phase E2 — Ask GG subscription perk (OD1 locked).
  //   FREE   → 0  (full price)
  //   MEMBER → 25 (25% off the slot fee)
  //   PRO    → 50 (50% off the slot fee)
  // Snapshotted on the bid at bid time so the discount can't be
  // gamed by upgrading right before settlement OR penalised by a
  // downgrade between bid + bind. Charged cents = floor(
  // amountCents * (100 - discountPercent) / 100).
  discountPercent    Int  @default(0)
  // Actual ZAR cents charged. Null until the bid wins + binds.
  // Once set, Zoho receipt + admin revenue reports use this value
  // (NOT amountCents) so the books match the cash that landed.
  chargedAmountCents Int?

  // ── P1.2 — manual-EFT slot-fee payment lane ──────────────────────
  // On bind-request the winner gets an FS reference + a pay-by
  // deadline; the reconciler completes the bind on payment match.
  // pendingListingId remembers WHICH listing to feature once paid.
  orderReference    String?   @unique
  pendingListingId  String?
  paymentPayByAt    DateTime?
  paymentDetectedAt DateTime?

  status FeaturedBidStatus @default(ACTIVE)

  // Set when the bid wins + Peach is charged (= COMMITTED). Lets admin
  // refund cleanly via the Peach payment ID.
  peachPaymentId String?
  paidAt         DateTime?

  // If the winner doesn't bind a listing within the 15-min bind window
  // we cascade to the next-highest bid. `cascadedFromId` records the
  // forfeited bid we replaced. Read-only audit trail.
  cascadedFromId String?          @unique
  cascadedFrom   FeaturedSlotBid? @relation("BidCascade", fields: [cascadedFromId], references: [id])
  cascadedTo     FeaturedSlotBid? @relation("BidCascade")

  // Back-relation for FeaturedAuction.winningBid.
  wonAuction FeaturedAuction? @relation("AuctionWinningBid")

  // ── Zoho Books linkage ────────────────────────────────────────────
  // Featured-slot fee invoice (Gun Galore → winning bidder) created
  // when the bid wins + Peach captures payment. Only set on winning
  // bids that actually paid (status = COMMITTED + paidAt set).
  zohoInvoiceId         String?
  zohoSyncStatus        String?
  zohoSyncError         String?
  zohoSyncLastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId, amountCents])
  @@index([bidderId, status])
}

// Operator-editable configuration so tier prices + durations + bid floor
// can change WITHOUT a code deploy. Singleton row (id="default" always).
// Admin Settings tab writes through.
model FeaturedSlotConfig {
  id String @id @default("default")

  // Number of slots — default 10. Changing this needs a follow-up
  // migration to add/remove FeaturedSlot rows; UI gates the change
  // behind a confirm dialog.
  slotCount Int @default(10)

  // Bid floor in ZAR cents. Default 10000 (R100).
  bidFloorCents Int @default(10000)

  // Tier amounts in ZAR cents + duration in seconds. Five tiers, all
  // editable. Defaults match the agreed table:
  //   T1 R100 = 86400s   (1d)
  //   T2 R200 = 172800s  (2d)
  //   T3 R300 = 432000s  (5d)
  //   T4 R400 = 604800s  (7d)
  //   T5 R500 = 1209600s (14d)
  t1AmountCents Int @default(10000)
  t1DurationSec Int @default(86400)
  t2AmountCents Int @default(20000)
  t2DurationSec Int @default(172800)
  t3AmountCents Int @default(30000)
  t3DurationSec Int @default(432000)
  t4AmountCents Int @default(40000)
  t4DurationSec Int @default(604800)
  t5AmountCents Int @default(50000)
  t5DurationSec Int @default(1209600)

  // How long the auction stays open AFTER the first bid lands. The
  // auction itself opens the moment the slot becomes vacant, but
  // sits at closesAt=null (waiting for a first bid). When the first
  // bid lands, closesAt is set to now + bidWindowSec. Subsequent
  // bids during the window don't reset it.
  bidWindowSec Int @default(86400) // 24h

  // 15-min bind window the winner has to pick a listing.
  bindWindowSec Int @default(900)

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
}

// Admin can permanently bar a user from bidding on featured slots
// (e.g. spam, payment-default repeat offender, abuse). Separate from
// the listing-side `isBanned` flag so featured-slot bans don't kill
// the user's whole account.
model FeaturedSlotBidderBan {
  id              String   @id @default(cuid())
  userId          String   @unique
  reason          String
  bannedByAdminId String
  createdAt       DateTime @default(now())
}

// Audit log — every featured-slot event. Lets the operator answer
// "who got that slot at 14:32 yesterday and how much did they pay?"
// without leaving the admin panel.
//
// Event types (free-text for forward-compat):
//   AUCTION_OPENED, BID_PLACED, AUCTION_CLOSED, BIND_WINDOW_OPENED,
//   LISTING_BOUND, BIND_WINDOW_EXPIRED, CASCADED_TO_RUNNER_UP,
//   FEATURED_LIVE, FEATURED_EXPIRED, LISTING_SOLD_FREES_SLOT,
//   FORCE_EVICTED, MANUALLY_AWARDED, REFUND_ISSUED, CONFIG_CHANGED,
//   BIDDER_BANNED, BIDDER_UNBANNED
model FeaturedSlotAuditEvent {
  id     String        @id @default(cuid())
  slotId String?
  slot   FeaturedSlot? @relation(fields: [slotId], references: [id])

  eventType   String
  payloadJson String? // JSON-encoded payload; freeform per eventType

  // Who fired this. EITHER a user (bidder action) OR an admin
  // (override action). System cron events have both null.
  actorUserId  String?
  actorAdminId String?

  createdAt DateTime @default(now())

  @@index([slotId, createdAt])
  @@index([eventType, createdAt])
}

// =====================================================================
// ActionToken — single-use, scoped tokens for SMS-link action pages
// =====================================================================
// Powers the /a/<token> pages: a buyer or seller gets an SMS with a
// short link, taps it, and lands on a public page (no sign-in) that
// lets them do exactly ONE thing — accept an offer, place a bid, pay
// for an item they won, etc.
//
// Security model:
//   - Token is 16 bytes of cryptographic random (128-bit), base64url
//     encoded (~22 chars in the URL).
//   - Each token is scoped to ONE action on ONE entity. An "accept
//     offer" token can ONLY accept that one offer — it can't reject
//     it, can't access other offers, can't read profile, can't act on
//     other transactions.
//   - One-time consume for mutating actions. Tokens for read-only or
//     multi-load surfaces (e.g. CHECKOUT, where the user loads the
//     page, fills in shipping, then submits payment) stay valid until
//     the "terminal" action consumes them — for checkout that's the
//     POST /transactions call.
//   - Expiry = the underlying decision window. Offers expire in 24h
//     so offer-decision tokens expire then too. Auction-bid tokens
//     expire at the auction's endTime (auto-extends on snipe).
//   - Brute-force lock: invalidAttempts >= 5 → token permanently dead
//     even if not yet used. Prevents guessing valid tokens.
//
// Purposes:
//   OFFER_DECISION   — seller decides on a fresh offer (accept/reject/counter)
//   COUNTER_DECISION — buyer decides on seller's counter (accept/reject/counter-back)
//   AUCTION_BID      — buyer raises bid after being outbid (single or auto-bid)
//   CHECKOUT         — buyer pays for accepted offer / auction win / BUY_NOW
//                      (wider read scope: loads user address/phone for pre-fill)
model ActionToken {
  id    String @id @default(cuid())
  token String @unique // base64url(16 bytes random) — ~22 chars

  // What this token authorises. See enum comment above for valid values.
  // Plain string (not Prisma enum) so we can add purposes without a
  // schema migration each time.
  purpose String

  // What the token acts on. targetType is a model name in lowercase:
  // 'offer' | 'listing' | 'transaction'. targetId is that record's id.
  targetType String
  targetId   String

  // Who the token authorises — when consumed, the underlying service
  // call runs AS this user. Always a real Gun Galore user; never an
  // anonymous session.
  authorisedUserId String
  authorisedUser   User   @relation("ActionTokensAuthorised", fields: [authorisedUserId], references: [id], onDelete: Cascade)

  // Optional metadata for the action — e.g. for CHECKOUT we might
  // store the listing's price snapshot at SMS send time so a price
  // change between SMS and click can be detected. Free-form JSON.
  metadataJson String?

  expiresAt DateTime
  usedAt    DateTime?

  // Failed resolution attempts — incremented on invalid/expired/locked
  // POST attempts. Once >= 5 the token is permanently dead (even if
  // it hadn't been used yet). Stops guess attacks.
  invalidAttempts Int @default(0)

  // Audit linkage — once the token is consumed, store the IP +
  // user-agent of the consuming request for the admin audit trail.
  consumedFromIp        String?
  consumedFromUserAgent String?

  createdAt DateTime @default(now())

  @@index([authorisedUserId, expiresAt])
  @@index([targetType, targetId])
  @@index([expiresAt])
}

// =====================================================================
// External-service credit monitoring
// =====================================================================
// Gun Galore depends on several paid external services (SMSPortal for
// OTPs, VerifyNow for KYC, Cloudinary for media, Anthropic for the
// listing-review agent, Pudo for shipping). Each of those bills against
// a per-account credit/balance pool — if any of them runs dry mid-flow
// the user-facing experience silently breaks (OTP never arrives, KYC
// hangs, image upload returns a 4xx, etc).
//
// The cron in TasksService.pollCreditBalances() polls every service
// every 15 minutes and stores one row here per service per poll. The
// /admin/credits page reads this table to render the live grid + the
// 30-day trend chart per service. Threshold-breach alerts are driven
// by the CreditThreshold table below and dedup'd by lastWarn/Alarm
// timestamps so we don't spam the operator.
//
// `balance` is the primary numeric metric — credits remaining (SMS,
// KYC), rand remaining (VerifyNow ZAR balance), credit units
// (Cloudinary), USD spend over the trailing 24h (Anthropic — note this
// is SPEND not BALANCE, so the threshold logic is inverted). `unit`
// stores the human-readable unit string. Service-specific extras
// (storage GB, transformations used, etc) go in `metadata` so we can
// add new dimensions without a schema migration.
//
// `error` is populated when the fetch fails — the row still gets
// written so the admin trend chart shows a gap rather than a silent
// drop. `balance` is NULL on error.
model CreditSnapshot {
  id        String   @id @default(cuid())
  // Service identifier — matches the `service` column in CreditThreshold.
  // String (not enum) so adding a new service doesn't need a migration.
  // Known values: 'smsportal' | 'verifynow' | 'cloudinary' | 'anthropic' | 'pudo'
  service   String
  balance   Float? // primary numeric metric; NULL when the fetch failed
  unit      String? // 'sms' | 'lookup' | 'ZAR' | 'USD' | 'credits' | 'GB'
  metadata  Json? // service-specific extras (raw response, storage, etc)
  fetchedAt DateTime @default(now())
  error     String? // populated when the fetch failed — for debugging

  // Compound index supports the per-service trend chart query
  // (WHERE service = X ORDER BY fetchedAt DESC LIMIT ...).
  @@index([service, fetchedAt])
}

// Operator-configurable thresholds per service. The poll cron checks
// each snapshot against the threshold for that service: if balance
// drops below warnThreshold the operator gets an email; below
// alarmThreshold both email + SMS fire. Both alerts dedup on a 6h
// window via lastWarnAlertAt / lastAlarmAlertAt so a balance hovering
// just under the threshold doesn't spam.
//
// `enabled = false` short-circuits the check entirely — useful when
// the operator knows credits are temporarily low and doesn't want to
// be paged about it.
model CreditThreshold {
  id               String    @id @default(cuid())
  service          String    @unique // FK by convention to CreditSnapshot.service
  warnThreshold    Float? // amber alert — email only
  alarmThreshold   Float? // red alert — email + SMS
  lastWarnAlertAt  DateTime? // dedup so warn doesn't fire more than once per 6h
  lastAlarmAlertAt DateTime? // dedup so alarm doesn't fire more than once per 6h
  enabled          Boolean   @default(true)
  updatedAt        DateTime  @updatedAt
}

// =====================================================================
// Ask GG — AI assistant subscription
// =====================================================================
// Sister product to the M1-M5 marketplace. Paid AI chat assistant
// with photo identification, knowledge base, reloading-data lookups,
// ballistic calculators, renewal reminders. See the Ask GG plan
// file at C:\Users\gerha\.claude\plans\zesty-forging-stardust.md
// for the full spec + phasing.
//
// Phase A (current) scope:
//   - SubscriptionTier on User (FREE / MEMBER / PRO)
//   - Subscription + SubscriptionCharge models (billing rail, only
//     wires up once Peach card-tokenisation lands)
//   - Conversations + messages + per-message cost tracking
//   - KB entries + per-day usage rollup
// Models exist now even where their full lifecycle (billing,
// KB-verification, embedding search) is built in later drops —
// keeps the schema migrations single + future-proof.

enum SubscriptionTier {
  FREE
  MEMBER
  PRO
}

enum SubscriptionPaymentStatus {
  ACTIVE // current period valid, will auto-renew at currentPeriodEnd
  PAST_DUE // last charge failed; in retry window
  SUSPENDED // 3rd retry failed; tier downgraded to FREE pending payment update
  CANCELLED // user-initiated cancel; remains valid until currentPeriodEnd
}

enum AskGgConversationOutcome {
  UNRESOLVED // default; user hasn't responded to the "did this solve it?" prompt
  RESOLVED // user marked the conversation as helpful — eligible for KB
  ABANDONED // user marked unhelpful or never returned
}

enum AskGgKbStatus {
  DRAFT // auto-created from a RESOLVED conversation, awaiting admin review
  SUBMITTED // user-edited a draft and re-submitted for admin attention
  VERIFIED // admin approved — surfaces in search results first
  ARCHIVED // soft-deleted; admin can resurrect
}

// Subscription billing record. ONE row per User; the user's tier
// lives on User.subscriptionTier as the hot-path read. This model
// tracks the recurring-billing lifecycle (period boundaries, retry
// state, Peach customer linkage).
//
// During Phase A (pre-Peach-tokenisation) the row is created only
// by admin grants (subscriptionTier change in /admin/users/[id]
// writes both User.subscriptionTier AND this row). When Peach
// recurring billing lands, POST /subscriptions creates this row
// post-checkout and the daily billing cron advances the period.
model Subscription {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               SubscriptionTier
  status             SubscriptionPaymentStatus @default(ACTIVE)
  billingCycle       String // 'monthly' | 'annual' | 'comp' (admin grant, no billing)
  amountCents        Int // ZAR cents per cycle. 0 for comp accounts.
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean                   @default(false)
  // P1.1 — prepaid manual-EFT rail: idempotency stamp for the
  // "renews in 3 days" reminder (cleared when a new period activates).
  renewalReminderAt  DateTime?
  // Peach vault ID for recurring charges. NULL for comp accounts +
  // pre-Peach-tokenisation grants. Mirrored from User.peachCustomerId
  // at signup so the cron doesn't need to JOIN.
  peachCustomerId    String?
  // Zoho Books customer ID for invoice / receipt linkage. Lazy-
  // created on first successful charge. Same pattern as
  // User.zohoContactId for marketplace transactions.
  zohoCustomerId     String?
  lastChargeAt       DateTime?
  failedChargeCount  Int                       @default(0)
  // Optional fields surfaced in Pro-tier business receipts (Phase E).
  businessName       String?
  vatNumber          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  charges            SubscriptionCharge[]

  // Index supports the daily billing cron:
  // "WHERE status = ACTIVE AND currentPeriodEnd <= now AND
  //  cancelAtPeriodEnd = false"
  @@index([status, currentPeriodEnd])
}

// One row per recurring charge attempt (success or failure). Drives
// the billing-history page on /subscriptions + admin spend audit.
// ── PRO prize draw (promotional competition) ─────────────────────────
// A physical prize bought by GG, displayed for the whole cycle, drawn
// among paid-up PRO members (comp/admin-granted accounts excluded). The
// prize budget is ADVISORY ONLY (computed in admin from a % of recent
// subscription revenue) — no money moves through this module. Winners
// may exchange any prize for an alternative of equal value (this is
// also how a licence-bearing prize is handled when the winner cannot
// or prefers not to accept it). Public copy never names prize
// categories — the actual prize of the running cycle is displayed.
enum PrizeDrawStatus {
  LIVE // on display, drawAt scheduled
  DRAWN // winner picked, awaiting fulfilment
  FULFILLED // prize handed over / exchanged
  CANCELLED // withdrawn before the draw (admin, reason kept)
}

model PrizeDraw {
  id              String          @id @default(cuid())
  title           String
  description     String
  prizeValueCents Int // actual value of the purchased prize
  imageUrls       String[]
  status          PrizeDrawStatus @default(LIVE)
  displayStartAt  DateTime        @default(now())
  drawAt          DateTime
  drawnAt         DateTime?
  winnerUserId    String?
  winner          User?           @relation(fields: [winnerUserId], references: [id], onDelete: SetNull)
  entrantCount    Int             @default(0)
  // Draw audit: { entrantsHash, algorithm, timestamp } — CPA record-keeping.
  drawAudit       Json?
  fulfilledAt     DateTime?
  fulfilmentNote  String? // e.g. "exchanged for equal-value alternative"
  cancelledReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, drawAt])
}

model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         String // 'PENDING' | 'SUCCEEDED' | 'FAILED' | 'REFUNDED'
  peachPaymentId String?
  zohoReceiptId  String?
  errorMessage   String?
  attemptCount   Int          @default(1)
  chargedAt      DateTime     @default(now())

  // ── P1.1 — prepaid manual-EFT purchase lane ──────────────────────
  // A PENDING charge is an OPEN EFT request: the member pays this
  // reference (SB prefix) and the reconciler activates the tier on
  // match. payByAt bounds how long the reference stays payable;
  // tierPurchased/periodDays snapshot what the payment buys (the
  // user may be upgrading, so it can differ from subscription.tier).
  orderReference String?           @unique
  payByAt        DateTime?
  tierPurchased  SubscriptionTier?
  periodDays     Int               @default(31)
  detectedAt     DateTime? // provisional inContact detection stamp

  @@index([subscriptionId, chargedAt(sort: Desc)])
  @@index([status, payByAt])
}

// A single Ask GG chat thread. Most users will have many.
//
// `title` is the first user message truncated to 80 chars (auto-set
// on create; never edited). Conversation history page renders by
// title for fast scanning.
//
// `outcome` flips when the user responds to the post-assistant
// "did this solve it?" prompt. RESOLVED conversations become
// AskGgKbEntry DRAFT rows automatically (Phase C wiring).
//
// `resolvedByMatch` is set when the conversation was answered by
// surfacing a KB hit (no Claude call fired). Powers the per-day
// cost dashboard's "KB-vs-Claude split" chart.
model AskGgConversation {
  id              String                   @id @default(cuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  outcome         AskGgConversationOutcome @default(UNRESOLVED)
  resolvedAt      DateTime?
  resolvedByMatch String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  messages        AskGgMessage[]
  kbEntry         AskGgKbEntry?

  @@index([userId, updatedAt(sort: Desc)])
}

// One row per message in a conversation. Both user + assistant turns
// land here so the full history is replayable.
//
// `imageUrls` is populated for vision messages (Phase B). Up to 5
// Cloudinary URLs per message, matching MAX_VISION_PHOTOS in the
// existing listing-moderation pattern.
//
// Token + cost columns make per-user spend visibility cheap —
// something the existing Claude services (moderation, dealer
// verification) don't track today.
model AskGgMessage {
  id               String            @id @default(cuid())
  conversationId   String
  conversation     AskGgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String // 'user' | 'assistant' | 'system'
  content          String
  imageUrls        String[]
  model            String? // 'claude-sonnet-4-6', 'claude-haiku-4-5-…', for cost audit
  promptTokens     Int?
  completionTokens Int?
  costUsd          Float?
  // Citations: Json array of reloading-manual fetches Claude did
  // while answering. Each entry: { manualId, manufacturer, title,
  // edition, pages }. Rendered as chips below the assistant message
  // so the user can verify against the source PDF.
  citations        Json?
  // P2.2 — live marketplace listings the answer surfaced via
  // searchMarketplace / getComplements. Json array of compact cards
  // ({ id, title, priceCents, imageUrl, categoryName, … }) rendered as
  // tappable listing cards below the assistant message.
  listingCards     Json?
  // Ask GG Everywhere (site-wide widget) — the raw client-supplied page
  // context sent with a USER turn ({ path, listingId?, transactionId?,
  // orderId?, categorySlug? }). Stored for audit + so preflight can
  // rebuild the server-verified context block for the latest message.
  // Enrichment always re-runs fresh server-side; this is never trusted.
  pageContext      Json?
  // Support-ticket DRAFT surfaced on an ASSISTANT turn (draftSupportTicket
  // tool). Writes nothing — the frontend renders it as a prefilled card
  // and the ticket is only created when the USER taps "Create ticket"
  // (their own session → POST /support).
  ticketDraft      Json?
  // W6 two-lane quota — which meter this USER turn was billed to:
  // 'SUPPORT' (free site/account help, per-day abuse cap) or 'ADVICE'
  // (outdoor/reloading, tier caps). Null = assistant rows + pre-W6
  // history (counted as ADVICE by the meters).
  lane             String?
  createdAt        DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// Knowledge base entry. Created automatically when a conversation
// is marked RESOLVED (Phase C wiring); curated + verified by admin.
// VERIFIED entries surface first in the search-first flow so future
// users with similar questions get cached answers instead of fresh
// Claude calls — cost per question decreases as the KB matures.
//
// `embedding` is a pgvector column for cosine-similarity search
// (Phase C). NULL for now; backfilled when embeddings infrastructure
// lands.
model AskGgKbEntry {
  id                   String             @id @default(cuid())
  sourceConversationId String?            @unique
  sourceConversation   AskGgConversation? @relation(fields: [sourceConversationId], references: [id])
  // Ask GG Everywhere — stable key for SEEDED platform Help-Centre entries
  // (prisma/seed-data/help-centre.ts, upserted by `npm run seed:help`).
  // Null = organic conversation-derived entry (never touched by the seeder).
  sourceKey            String?            @unique
  authorId             String
  author               User               @relation("KbAuthor", fields: [authorId], references: [id])
  title                String
  question             String
  answer               String
  category             String?
  tags                 String[]
  status               AskGgKbStatus      @default(DRAFT)
  verifiedById         String?
  verifiedAt           DateTime?
  usefulCount          Int                @default(0)
  surfacedCount        Int                @default(0)
  embedding            Bytes?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, verifiedAt(sort: Desc)])
  @@index([category])
}

// GG site-guide (G5) — admin-editable OVERRIDE of a curated page-guide
// playbook. The static GUIDES catalog (backend/src/ask-gg/guide-content.ts)
// stays the shipped baseline/fallback; a row here OVERLAYS it for one guide
// `key`. Only PUBLISHED rows are served to users; DRAFT is admin preview only.
// Delete the row to revert to the shipped default. `updatedBy` is the admin's
// JWT sub (a plain id, mirroring AdminAuditEvent.adminUserId — no FK so the
// User model stays untouched). Live state (auction bid line) and the personal
// overlay are computed at serve time and are NOT overridable here.
model AskGgGuideOverride {
  id          String           @id @default(cuid())
  key         String           @unique // matches a GUIDES key (home, listing-auction, dashboard, …)
  title       String
  intro       String?
  points      String[] // the bullet-point playbook
  ctas        Json? // GuideCta[] { label, href?, ask? }
  status      AskGgGuideStatus @default(DRAFT)
  updatedBy   String? // admin JWT sub
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
}

enum AskGgGuideStatus {
  DRAFT
  PUBLISHED
}

// Per-user-per-day usage rollup. Powers free-tier caps (5 photo
// IDs + 5 messages per rolling 30 days) and Member/Pro fair-use
// rate caps (admin-configurable via SettingsService).
//
// One row per user per UTC day. Bumped synchronously on message
// send + photo identification. Queries aggregate over date ranges
// to enforce caps + drive the admin usage dashboard.
model AskGgUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          DateTime // truncated to date (00:00 UTC) on write
  messageCount Int      @default(0)
  photoIdCount Int      @default(0)
  costUsdCents Int      @default(0)

  @@unique([userId, day])
  @@index([day])
}

// =====================================================================
// Reloading manuals — Phase D PDF-RAG source-of-truth
// =====================================================================
// Operator uploads commercial reloading manuals (Hodgdon Annual,
// Lyman Handbook, Hornady, Accurate, Vihtavuori, IMR, Alliant). The
// pipeline extracts each page's text on upload so we can full-text
// search across all manuals at query time.
//
// Runtime flow when a user asks a reloading question:
//   1. Claude (in Ask GG) calls tool searchReloadingManuals({query})
//      → Postgres FTS across ReloadingManualPage.extractedText
//      → returns top hits {manualId, pageNumber, snippet}
//   2. Claude picks the best hit, calls fetchManualPages({manualId,
//      pages: [N-1, N, N+1]}) → pdf-lib slices those pages from the
//      stored PDF → returned as a base64 document content block
//   3. Claude reads the actual page in its next turn, composes a
//      natural-language answer with explicit citation:
//      "Per Hodgdon Annual Manual (p.145): max load of 168gr SMK with
//       H4350 is XX.Xgr at YYYY fps. Start at ZZ.Zgr and work up."
//
// Numbers ALWAYS come from a verified manual; never from training
// data. The "verification" is implicit — Claude reads the original
// page on every query, not a transcribed copy.

enum ReloadingManualStatus {
  PROCESSING // upload finished, pdf-parse running
  ACTIVE // text extracted + indexed, queryable by Ask GG
  ARCHIVED // hidden from new queries (replaced by newer edition)
  FAILED // pdf-parse threw; admin can retry or delete
}

model ReloadingManual {
  id                String                @id @default(cuid())
  manufacturer      String // "Hodgdon" / "Vihtavuori" / etc.
  title             String // "Annual Manual" / "Reloading Handbook"
  edition           String? // "2024" / "49th Edition" — optional
  // Relative path under RELOADING_STORAGE_DIR (env, default
  // ./uploads/reloading-manuals). Filename is a random hex string so
  // a directory listing leak doesn't reveal which manuals we hold.
  // PDFs are read by the backend (pdf-lib slicing for Ask GG) and
  // served through the authenticated download route — never exposed
  // via a public URL.
  storedPath        String                @unique
  fileSizeBytes     Int
  pageCount         Int                   @default(0)
  status            ReloadingManualStatus @default(PROCESSING)
  // True when the page text was produced by the Anthropic OCR backfill
  // script (src/reloading/scripts/ocr-backfill.ts) rather than pdf-parse.
  // Ask GG appends a "double-check this exact figure" nudge when it
  // quotes numbers from an OCR-digitised manual.
  ocr               Boolean               @default(false)
  // Admin who triggered the inbox scan that ingested this manual.
  // FK to AdminUser (separate table from regular User) — admin JWT
  // payloads carry AdminUser.id as `sub`, not a User.id.
  uploadedByAdminId String
  uploadedByAdmin   AdminUser             @relation("ReloadingUploader", fields: [uploadedByAdminId], references: [id])
  errorMessage      String? // populated when status = FAILED
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  pages             ReloadingManualPage[]
  loads             ManualLoad[]

  @@index([status, manufacturer])
}

// NOTE on the FTS index — there is a Postgres `textTsv tsvector`
// GENERATED ALWAYS AS column + GIN index on this table that we
// manage OUTSIDE Prisma (see ReloadingService.onModuleInit). We don't
// declare it here because Prisma fights GENERATED columns: declaring
// it as Unsupported still triggers ALTER attempts that Postgres
// rejects, and not declaring it triggers DROP attempts on `db push`.
//
// Operational rule: if `prisma db push` warns about dropping `textTsv`,
// it's safe to accept the drop — onModuleInit re-adds the column +
// index at next backend restart, and Postgres immediately re-populates
// the GENERATED tsvector from the existing `extractedText` values.
// No data loss, no manual reindex.
model ReloadingManualPage {
  id            String          @id @default(cuid())
  manualId      String
  manual        ReloadingManual @relation(fields: [manualId], references: [id], onDelete: Cascade)
  pageNumber    Int // 1-indexed; matches printed manual pagination
  extractedText String          @db.Text
  createdAt     DateTime        @default(now())

  @@unique([manualId, pageNumber])
  @@index([manualId, pageNumber])
}

// ─── Recommended Loads — structured load data extracted from manuals ──
// Pre-extracted PUBLISHED load rows from the reloading manuals, so the Load
// Lab "Recommended loads" panel can serve authoritative start→max charges per
// powder by cartridge + bullet weight instantly (no per-request PDF reading).
// Populated by LoadDataExtractionService (Claude reads the manual load-table
// pages → structured rows). Manuals are AUTHORITATIVE for charges — every row
// carries its manual + page so the UI can cite it. Engine output never feeds
// this table.
model ManualLoad {
  id             String           @id @default(cuid())
  // Display cartridge name as printed, e.g. "6.5 Creedmoor".
  cartridge      String
  // Lowercase, punctuation/space-normalised key for matching (e.g. "65creedmoor").
  cartridgeKey   String
  powderMaker    String
  powderName     String
  bulletMaker    String?
  bulletName     String?
  bulletWeightGr Float
  startGr        Float
  maxGr          Float
  startVelFps    Int?
  maxVelFps      Int?
  // Published case-fill / load-density % at the start and max charge, where the
  // manual prints it (Somchem, Nosler). Null otherwise (panel estimates it).
  fillPctStart   Float?
  fillPctMax     Float?
  coalMm         Float?
  primer         String?
  caseMaker      String?
  barrelLenIn    Float?
  notes          String?          @db.Text
  // Display label of the source manual, e.g. "Somchem Reloading Data". Carried
  // directly so a locally-built seed is self-contained (no server-id lookup).
  manualLabel    String
  // Optional link to the ingested manual (for the PDF viewer); nullable so a
  // seed row works even if the manual isn't separately ingested.
  manualId       String?
  manual         ReloadingManual? @relation(fields: [manualId], references: [id], onDelete: SetNull)
  pageNumber     Int
  createdAt      DateTime         @default(now())

  // One row per distinct published load. Includes bullet maker/name + max so
  // different bullets of the SAME weight (e.g. Hornady V-MAX vs HP on one page
  // with the same powder + start charge) are kept as separate loads, not merged.
  @@unique([manualLabel, pageNumber, powderName, bulletMaker, bulletName, bulletWeightGr, startGr, maxGr], name: "dedupKey", map: "ManualLoad_dedup_key")
  @@index([cartridgeKey, bulletWeightGr])
  @@index([manualId])
}

// ─── Hunt Ballistics — RangeEstimate ─────────────────────────────────
// One row per AI camera-ranging request from the Hunt Ballistics iOS
// app (POST /hunt-ballistics/estimate-range). Persisted for the future
// map-plot feature: the user will see where shots were taken from +
// where the target was, computed from shooter GPS + compass heading +
// AI range.
//
// PRIVACY: we do NOT store the photo itself, only its metadata + the
// AI result. If we later want to re-train against ground-truth ranges,
// we'd add a separate opt-in mechanism (with explicit user consent
// per submission).
//
// IDENTITY: Hunt Ballistics uses anonymous per-device UUIDs (X-Device-Id
// header), not Clerk. There's no FK to User here on purpose — the iOS
// app is a different product surface from the gun-galore marketplace.
// =====================================================================
// HUNT BALLISTICS — INFO CENTRE (Phase 2.5)
// =====================================================================
// In-app knowledge base. The operator curates a library of hunting
// reference PDFs (species guides, cartridge data, regulations, theory
// books) outside this server — PDFs live on the operator's local
// machine for copyright + privacy reasons. We persist only the
// extracted text per page, plus an optional rendered page image when
// the visual layout matters (diagrams, tables).
//
// Mirrors the ReloadingManual pattern (Postgres FTS via tsvector +
// GIN index, websearch_to_tsquery) but DELIBERATELY does NOT store
// the source PDF — never serve the operator's copyrighted reference
// material from our infrastructure.
//
// Runtime flow:
//   1. Operator drops PDFs locally; Claude Code reads them via the
//      Read tool (Max-plan covered), extracts text per page, optional
//      page renders, POSTs to /admin/hunt-pdfs/import.
//   2. App searches via /info-centre/search?q=... — text snippets
//      with PDF title + page number + ts_rank ordering.
//   3. App reads via /info-centre/pdf/:id/page/:n — page text +
//      optional rendered image.

enum HuntPdfCategory {
  SPECIES_GUIDE // field guides for SA / African wildlife
  CARTRIDGE_DATA // ammo data sheets, factory load tables
  REGULATIONS // hunting regs per province / country
  BALLISTICS_THEORY // wind, drag, exterior ballistics theory
  HUNTING_TECHNIQUE // stalking, calling, field-care
  FLORA_REFERENCE // SA vegetation references (Trees of S Africa, etc.)
  GENERAL // catch-all for anything else
}

enum HuntPdfStatus {
  DRAFT // imported but not visible to users yet
  ACTIVE // searchable + readable in the iOS app
  ARCHIVED // hidden from new queries (older edition, superseded)
}

model HuntPdf {
  id            String          @id @default(cuid())
  title         String // "Trees of Southern Africa"
  author        String? // "van Wyk & van Wyk" — optional
  edition       String? // "3rd Edition (2018)" — optional
  publisher     String? // "Struik Nature" — optional
  publishedYear Int? // 2018
  category      HuntPdfCategory @default(GENERAL)
  language      String          @default("en") // BCP47: en, af, en+af
  pageCount     Int             @default(0)
  status        HuntPdfStatus   @default(DRAFT)
  // Short description shown in browse + search result cards.
  blurb         String?         @db.Text
  // Display order within a category — lower sorts first. Defaults to 100
  // so the operator can prepend a "featured" entry by setting it to 0-50.
  sortOrder     Int             @default(100)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  pages         HuntPdfPage[]

  @@index([status, category, sortOrder])
}

// NOTE on the FTS index — same pattern as ReloadingManualPage. A
// Postgres `textTsv tsvector` GENERATED ALWAYS AS column + GIN index
// is added by HuntPdfService.onModuleInit and NOT declared here
// because Prisma fights GENERATED columns. If `prisma db push` warns
// about dropping `textTsv`, it's safe to accept — onModuleInit
// re-adds the column + index at next backend restart.
model HuntPdfPage {
  id          String   @id @default(cuid())
  pdfId       String
  pdf         HuntPdf  @relation(fields: [pdfId], references: [id], onDelete: Cascade)
  pageNumber  Int // 1-indexed; matches printed pagination
  text        String   @db.Text
  // Optional rendered page as base64 PNG. Only populated for pages
  // where visual layout matters (diagrams, anatomy plates, tables).
  // Most pages are text-only; this stays null and saves storage.
  imageBase64 String?  @db.Text
  // Mime type of imageBase64 when present — default png.
  imageMime   String?
  createdAt   DateTime @default(now())

  @@unique([pdfId, pageNumber])
  @@index([pdfId, pageNumber])
}

model RangeEstimate {
  id String @id @default(cuid())

  // Identity — anonymous per-device UUID from the iOS app
  deviceId String

  // Geo at capture time — for the future map-plot feature
  lat        Float? // GPS latitude (-90..90), null if location denied
  lng        Float? // GPS longitude (-180..180)
  headingDeg Float? // compass bearing 0..360 (direction phone was pointing)
  tiltDeg    Float? // inclinometer pitch -89..89 (negative = downhill)

  // AI result
  rangeM     Float // estimated range in metres (already rounded server-side)
  confidence Float // 0..1 self-assessed by Claude
  species    String? // identified subject if Claude is sure
  notes      String? @db.Text // Claude's reasoning trace
  modelUsed  String // 'sonnet' | 'opus' — Opus = fallback fired

  // Audit + cost tracking
  biomeId          String? // matched SA biome id (sa-biomes.ts), null if outside coverage
  regionCode       String? // ISO 3166-1 alpha-2 (usually 'ZA')
  costUsd          Decimal? @db.Decimal(10, 6) // total across all passes
  promptTokens     Int? // sum of input tokens (Sonnet + Opus if escalated)
  completionTokens Int? // sum of output tokens

  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([biomeId, createdAt])
}

// ─── Address book (Phase 2) ──────────────────────────────────────────
// Multiple reusable delivery addresses per user. The legacy single
// address on User.addr* stays as the fallback default at checkout, so
// this is purely additive. Transaction.deliveryAddress remains an
// immutable JSON snapshot taken at checkout — it is NEVER an FK to this
// table, so deleting a saved address can't corrupt order history.
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SavedAddresses", fields: [userId], references: [id], onDelete: Cascade)

  label      String? // "Home", "Work", etc. — user-defined, optional
  building   String?
  street     String
  address2   String?
  suburb     String?
  city       String
  postalCode String
  province   Province
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

// ── Support tickets (Phase 7 P7.2) ─────────────────────────────────
// A user-initiated, non-dispute support channel (disputes stay
// per-transaction in Transaction). Threaded: a ticket has many replies
// from either the user or an admin. Status drives the admin queue.
enum SupportTicketStatus {
  OPEN // user is waiting on us
  AWAITING_USER // we replied; waiting on the user
  RESOLVED // closed by admin
  CLOSED // closed by user
}

model SupportTicket {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  // Free-string category: general | payment | shipping | account | listing | other
  category      String              @default("general")
  status        SupportTicketStatus @default(OPEN)
  // Optional link to an order the ticket is about.
  transactionId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  replies SupportTicketReply[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportTicketReply {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body          String
  // true = written by an admin; false = written by the ticket's user.
  fromAdmin     Boolean       @default(false)
  // Who wrote it — clerkId for a user reply, AdminUser.id for an admin reply.
  authorClerkId String?
  adminId       String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ── Formal complaints register (CPA / Nedbank-TPPP oversight) ────────
// Distinct from SupportTicket (the general help channel) and from the
// per-transaction raiseDispute money primitive. A Complaint owns a
// human-facing case number (CO000123), a category, an OPTIONAL linked
// order, evidence photos, an assigned owner and an outcome — this is the
// record that backs the /complaints page's "logged, assigned an owner,
// recorded with its outcome" promise. When a BUYER lodges a payout-
// affecting complaint (item not as described / damaged / not arrived) on
// a still-HELD order, the service also flips that order to DISPUTED to
// block payout — but the Complaint row is the system of record.
model Complaint {
  id              String           @id @default(cuid())
  // Human case number, e.g. CO000123 (ReferenceNumberService prefix 'CO').
  referenceNumber String           @unique
  userId          String
  user            User             @relation("UserComplaints", fields: [userId], references: [id], onDelete: Cascade)
  // BUYER | SELLER — which side of the platform the complainant is on.
  role            String           @default("BUYER")
  // ITEM_NOT_AS_DESCRIBED | DAMAGED | NOT_ARRIVED | PAYOUT | DELIVERY |
  // ACCOUNT | LISTING | OTHER
  category        String
  subject         String
  body            String
  // Optional background link to the order the complaint is about. Stored
  // as the Transaction cuid (there is no human order number); the picker
  // shows the listing reference for readability.
  transactionId   String?
  transaction     Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  // OPEN | UNDER_REVIEW | AWAITING_USER | RESOLVED | CLOSED
  status          String           @default("OPEN")
  // AdminUser.id of the operator who owns the case (the "assigned owner").
  assignedAdminId String?
  // Free-text resolution recorded when the case closes.
  outcome         String?
  // true if lodging this complaint flipped the linked order to DISPUTED.
  drovePayoutHold Boolean          @default(false)
  photos          ComplaintPhoto[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resolvedAt      DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([transactionId])
}

// Private evidence photos attached to a Complaint. Mirrors ListingImage
// (thin Cloudinary pointer). NOT run through listing moderation — evidence
// legitimately contains contact info; served access-controlled to the
// complainant + admins only.
model ComplaintPhoto {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  url         String
  publicId    String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

// ── Multi-item orders (Phase 8b) ───────────────────────────────────
// An Order is a buyer's cart checked out in one payment. It fans out into
// N Transactions (one per line item / listing) — each Transaction stays a
// single-listing sub-order so all Phase 1–7 money/dispatch/payout/SAPS/Zoho
// logic is unchanged. The Order owns the ONE payment capture (gateway-
// neutral fields below — the new paygate drops into the same seam; EFT is
// live today) and the buyer-facing rollup status. NOTE: no discount/voucher/
// store-credit fields — that scope (8c) is intentionally not built.
enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderPaymentMethod {
  MANUAL_EFT
  GATEWAY // reserved for the pending paygate; not used until approved
}

model Order {
  id      String @id @default(cuid())
  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  status        OrderStatus        @default(AWAITING_PAYMENT)
  paymentMethod OrderPaymentMethod @default(MANUAL_EFT)

  // ONE payment capture for the whole cart. orderReference = the single EFT
  // memo the buyer pays under; gateway* are the neutral seam for the future
  // paygate (NOT Stitch-specific).
  orderReference    String? @unique
  gatewayCheckoutId String?
  gatewayPaymentId  String? @unique

  // Money snapshot (ZAR cents) = sums across child transactions.
  itemsSubtotal    Int
  shippingSubtotal Int
  // P6.4 — sum of child shippingHandlingCents (the R15-per-waybill GG margin).
  // Kept as its own column so the invariant
  //   itemsSubtotal + shippingSubtotal + handlingSubtotal + processingFee == buyerTotal
  // continues to hold once a handling margin is charged.
  handlingSubtotal Int @default(0)
  processingFee    Int
  buyerTotal       Int

  // Manual-EFT lifecycle at the ORDER level (mirrors the per-Transaction
  // fields). Child transactions of an order carry NO manualPayByAt, so the
  // existing per-tx freeze sweep ignores them entirely; the order-level
  // sweep below releases ALL lines together (all-or-nothing). manualPayByAt
  // = single pay-by window; manualDetectedAt = provisional inContact hit
  // (stops the sweep); manualCancelledAt = window lapsed / soft-cancelled.
  manualPayByAt     DateTime?
  manualDetectedAt  DateTime?
  manualCancelledAt DateTime?
  // FLOW-F3 — idempotency stamps for the 12h/1h order-level pay reminders
  // (mirrors Transaction.manualWarn12hAt/manualWarn1hAt; multi-item orders
  // previously got NO reminders and were swept to CANCELLED silently).
  manualWarn12hAt   DateTime?
  manualWarn1hAt    DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions Transaction[]
  lineItems    OrderLineItem[]

  @@index([buyerId, status])
  @@index([status, createdAt])
  @@index([status, manualPayByAt])
}

model OrderLineItem {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The per-listing Transaction this line produced (set at checkout).
  transactionId String?      @unique
  transaction   Transaction? @relation("OrderLineTransaction", fields: [transactionId], references: [id])

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  sellerId  String // denormalized for grouping / per-seller views

  quantity     Int @default(1)
  unitPrice    Int // snapshot of listing.price at checkout (ZAR cents)
  lineSubtotal Int // unitPrice * quantity

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([listingId])
}

// ── Payout settlement ──────────────────────────────────────────────
// The manual-EFT FNB bulk-payment batch (PayoutBatch) and its status enum
// have been removed with the manual-EFT rail. Seller payouts / buyer refunds
// are now settled directly by stamping Transaction.paidOutAt; the owed-money
// math still lives in ManualPaymentsService.getPayoutsDue / getHeldFundsReport
// (kept, rail-agnostic). A future paygate settles the same rows.

// ── Swop / Trade (fully-managed two-way swap) ───────────────────────
// A swap = a SwapProposal negotiation (modelled on Offer) that, on accept,
// creates a Swap parent fanning out to TWO Transaction legs (one per shipping
// direction; Transaction is reused wholesale as the leg). The ONE funding
// capture + the per-party flat GG fees live on the parent; legs carry zero
// money. Mirrors the Order→Transaction fan-out + the manual-EFT lifecycle.
// GG revenue = a flat service fee per leg (courier markup / firearm handling).

enum SwapProposalStatus {
  PENDING // awaiting owner response (48h TTL)
  COUNTERED // owner countered the cash; proposer must respond (24h TTL)
  ACCEPTED // both sides agreed → Swap created
  REJECTED
  WITHDRAWN
  EXPIRED
  CONVERTED // Swap created from this proposal
}

enum SwapStatus {
  AWAITING_FUNDING // accepted; waiting on the single funding EFT
  LOCKED // funded; both legs about to be / being booked
  IN_TRANSIT // both legs booked + shipping
  AWAITING_VERIFICATION // delivered but a firearm leg still pending dealer-verify
  COMPLETED // both legs done (+ verified) → cash released → closed
  CANCELLED // pre-lock cancel / proposal or funding lapse
  DISPUTED // admin-owned: a leg failed / never shipped post-lock
}

enum SwapRole {
  INITIATOR_GIVES // leg ships the initiator's item → owner; cash from initiator
  OWNER_GIVES // leg ships the owner's item → initiator; cash from owner
}

model SwapProposal {
  id        String  @id @default(cuid())
  listingId String // the SWOP listing being proposed against
  listing   Listing @relation("SwapProposalTarget", fields: [listingId], references: [id])

  proposerId String
  proposer   User   @relation("SwapProposalsMade", fields: [proposerId], references: [id])
  ownerId    String // denormalised listing.sellerId for the unique guard + "received" query
  owner      User   @relation("SwapProposalsReceived", fields: [ownerId], references: [id])

  // v1: the proposer offers ONE existing SWOP listing they own (reuses its
  // photos + firearm/licence gating). Free-text/multi-item is a later add.
  offeredListingId String
  offeredListing   Listing @relation("SwapProposalOffered", fields: [offeredListingId], references: [id])

  // Optional cash top-up. cashAmount in ZAR cents; cashDirection = who pays.
  cashAmount           Int       @default(0)
  cashDirection        SwapRole?
  // Owner's single counter (cash only).
  counterCashAmount    Int?
  counterCashDirection SwapRole?

  proposerNote String?
  ownerNote    String?
  status       SwapProposalStatus @default(PENDING)
  expiresAt    DateTime

  swapId String? @unique
  swap   Swap?   @relation(fields: [swapId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, proposerId]) // one active proposal per proposer per listing
  @@index([listingId])
  @@index([proposerId])
  @@index([ownerId])
  @@index([status])
}

model Swap {
  id     String     @id @default(cuid())
  status SwapStatus @default(AWAITING_FUNDING)

  initiatorId String
  initiator   User   @relation("SwapsInitiated", fields: [initiatorId], references: [id])
  ownerId     String
  owner       User   @relation("SwapsReceived", fields: [ownerId], references: [id])

  // Cash top-up (ZAR cents) + who pays it. Per-party flat GG fee snapshotted
  // at lock (courier service fee / firearm handling fee).
  cashPayerId      String?
  cashAmount       Int     @default(0)
  swapFeeInitiator Int     @default(0)
  swapFeeOwner     Int     @default(0)

  // ONE funding capture for the whole swap. cashOrderReference = the single
  // EFT memo (SW prefix). gateway* = the neutral seam for the future paygate.
  cashOrderReference String? @unique
  gatewayCheckoutId  String?
  gatewayPaymentId   String? @unique

  // Manual-EFT funding lifecycle (mirrors Order.manual*). cashPayByAt is the
  // shared funding deadline for BOTH parties; cashDetectedAt/cashVerifiedAt are
  // legacy single-capture fields, superseded by the per-party blocks below and
  // left unused (kept to avoid a destructive migration).
  cashPayByAt     DateTime?
  cashDetectedAt  DateTime?
  cashVerifiedAt  DateTime?
  cashCancelledAt DateTime?

  // ── Two-sided funding (operator decision 2026-06-28) ─────────────────
  // Each party funds the leg they SEND: their parcel's live courier rate +
  // a flat R50 GG fee + any cash top-up they owe + 1.5% EFT handling. BOTH
  // must fund (verified) for the swap to LOCK; if only one funds and the
  // other lapses, the funded party is fully reimbursed. cashOrderReference /
  // the single cash* fields above are superseded by these.
  fundingSetUpAt DateTime? // set once both delivery addresses + methods captured + quoted

  initiatorFundingRef    String?   @unique // SW-…-A EFT memo
  initiatorFundingAmount Int       @default(0)
  initiatorCourierCents  Int       @default(0) // initiator's outbound-leg courier rate (remitted)
  initiatorDetectedAt    DateTime? // provisional inContact match
  initiatorVerifiedAt    DateTime? // authoritative statement match → this side funded
  initiatorRefundedAt    DateTime? // set if reimbursed on a one-sided funding failure

  ownerFundingRef    String?   @unique // SW-…-B EFT memo
  ownerFundingAmount Int       @default(0)
  ownerCourierCents  Int       @default(0)
  ownerDetectedAt    DateTime?
  ownerVerifiedAt    DateTime?
  ownerRefundedAt    DateTime?

  lockedAt         DateTime?
  // Exactly-once guard for the "swap locked" email+SMS+inbox notification.
  // The sweepStalledLockedSwaps re-drive cron re-invokes notifyLocked, so a
  // CAS on this stamp stops the notification firing twice.
  lockedNotifiedAt DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelledReason  String?

  // ── S5 settlement + verification window ──────────────────────────────
  // Both legs delivered → AWAITING_VERIFICATION with verificationDeadlineAt
  // set (a short hold so a recipient can flag "not as described" before any
  // cash moves). cashReleasedAt is the SINGLE "money has moved" idempotency
  // stamp — set on release OR refund, so settlement happens exactly once no
  // matter which path (auto-release cron / admin force-complete / admin
  // unwind) gets there first. settlementTxId links the synthetic RELEASED
  // payout tx that pays the cash recipient through the existing FNB batch.
  verificationDeadlineAt DateTime?
  cashReleasedAt         DateTime?
  settlementTxId         String?
  disputedAt             DateTime?
  disputeReason          String?
  disputeRaisedById      String?

  // P1.3 — Books linkage for the two flat leg fees GG retained (one
  // Sales Receipt per paying party, booked at completion — revenue is
  // only recognised once the swap can no longer be unwound/refunded).
  zohoInitiatorFeeReceiptId String?
  zohoOwnerFeeReceiptId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal     SwapProposal?
  transactions Transaction[] @relation("SwapLegs")

  @@index([initiatorId, status])
  @@index([ownerId, status])
  @@index([status, cashPayByAt])
}

// ─── Insights / behavioural analytics (first-party, internal) ────────
// Raw append-only behavioural events. Written fire-and-forget via a
// buffered ActivityService (never in a request transaction). Rolled up
// nightly into DailyUserStats / HourlyPlatformStats and pruned after 12
// months (privacy policy §9). userId is the resolved User.id when cheaply
// known; clerkId/deviceId hold the raw identity for hot read paths where a
// lookup would be wasteful (resolved in the rollup). No FK on userId so the
// append path stays constraint-free and can store pre-resolution rows.
model UserEvent {
  id          String   @id @default(cuid())
  userId      String?
  clerkId     String?
  deviceId    String?
  sessionId   String?
  // listing_view | search | offer_placed | bid_placed | wishlist_add |
  // cart_add | checkout_started | page_view
  eventType   String
  listingId   String?
  query       String?
  resultCount Int?
  amountCents Int?
  path        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([clerkId, createdAt])
}

// One row per Clerk login session. clerkSessionId is unique so a later
// session.ended/removed webhook can find + close the row and compute
// session length.
model LoginEvent {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clerkSessionId String    @unique
  startedAt      DateTime
  lastActiveAt   DateTime?
  endedAt        DateTime?
  endReason      String?
  createdAt      DateTime  @default(now())

  @@index([userId, startedAt])
}

// Nightly per-user rollup (kept in aggregate form beyond the raw-event
// retention window). Upserted idempotently on (day, userId).
model DailyUserStats {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  userId       String
  logins       Int      @default(0)
  pageViews    Int      @default(0)
  listingViews Int      @default(0)
  searches     Int      @default(0)
  offers       Int      @default(0)
  bids         Int      @default(0)
  events       Int      @default(0)

  @@unique([day, userId])
  @@index([day])
  @@index([userId, day])
}

// Nightly platform activity by hour-of-clock + event type (drives the
// "when are users active / when do things sell" heatmaps). Upserted on
// (hour, eventType).
model HourlyPlatformStats {
  id          String   @id @default(cuid())
  hour        DateTime
  eventType   String
  count       Int      @default(0)
  uniqueUsers Int      @default(0)

  @@unique([hour, eventType])
  @@index([hour])
}

// Weekly AI-written insights digest (Phase 4). `data` is the deterministic
// stats pack we compute ourselves (trustworthy numbers); `narrative` is
// Claude's plain-English interpretation of that pack (null if the API was
// unavailable — the pack still renders). Kept as history.
model InsightsDigest {
  id          String   @id @default(cuid())
  generatedAt DateTime @default(now())
  periodDays  Int
  data        Json
  narrative   String?
  model       String?
  createdAt   DateTime @default(now())

  @@index([generatedAt])
}

// ── Firearm-licence Motivation Writer (Phase 1) ──────────────────────
// See LICENCE-SERVICES-AND-FEED.md. The applicant's OWN facts, structured,
// encrypted at rest, rendered into a formal motivation PDF they sign and hand
// to the DFO.
//
// Real enums rather than the String-with-a-comment style used by
// Complaint.status, because both drive hard code branches: licenceType selects
// the prompt framework and the FCA sections cited, status gates whether a PDF
// can be produced at all.

enum MotivationLicenceType {
  S13_SELF_DEFENCE // s13 — self-defence
  S15_OCCASIONAL_HUNTER // s15 — occasional hunter / sport shooter
  S16_DEDICATED_HUNTER // s16 — dedicated hunter
  S16_DEDICATED_SPORT // s16 — dedicated sport shooter
  S24_RENEWAL // s24 — renewal of an existing licence
}

enum MotivationStatus {
  DRAFT // form open, nothing generated
  INTERVIEW // Boet is asking targeted follow-ups
  GENERATING // a generation pass is in flight
  QUALITY_REVIEW // generated; the second-pass gate is running
  NEEDS_MORE_INFO // gate failed; thinFields drive new follow-ups
  COMPLETED // gate passed; the PDF can be produced
  FAILED // unrecoverable — an admin owns it
  ABANDONED // user walked away, or an admin voided it
}

// The evidence bundle. Each upload becomes a lettered ANNEXURE in the finished
// pack and is cross-referenced from the body of the motivation — which is what
// turns an assertion into evidence.
//
// A motivation asserts where the firearm will be kept, and a photograph of the
// safe is the only thing that shows it. Safe storage is one of the few grounds
// a DFO inspects in person, so evidence of it is disproportionately valuable.
//
// THREE SHOTS, THREE KINDS (operator, 2026-08-19). They are separate enum
// values rather than three files of one kind because there is nowhere on this
// model to record WHICH shot a file is — no caption, no ordering column — so
// three files of one kind cannot be told apart, and a pack holding the closed
// door three times would report itself complete.
//
// SAFE_PHOTO is RETIRED, not removed: Postgres has no ALTER TYPE ... DROP
// VALUE, and rows written before 2026-08-19 carry it. It keeps a label and an
// annexure letter, it is out of the picker, and the upload endpoint refuses it
// outright — which is what makes "no new row can carry it" true rather than
// merely intended.
//
// SAFE_INSTALLATION is NOT retired. All three of the operator's shots are of
// the safe's DOOR; none of them shows it anchored to the wall, which is the
// one thing about safe storage a DFO inspects in person. Not required, still
// worth attaching, so it stays on offer.
enum MotivationUploadKind {
  IDENTITY_DOCUMENT
  COMPETENCY_CERTIFICATE
  PROFICIENCY_CERTIFICATE
  CURRENT_LICENCE
  /// The dedicated status certificate itself.
  ASSOCIATION_CARD
  /// ⚠️ THE ONE SECTION 16(2) ACTUALLY NAMES: "a sworn statement or solemn
  /// declaration from the chairperson of an accredited hunting association or
  /// sports-shooting organisation, or someone delegated in writing by him or
  /// her, stating that the applicant is a registered member". Carries an issue
  /// date and an expiry date, so it also lives in the vault as a GOOD_STANDING
  /// credential and gets chased like anything else that runs out.
  GOOD_STANDING_LETTER
  /// The association's endorsement that ONE SPECIFIC firearm — type, calibre,
  /// make, action, serial — is suitable for the discipline. ⚠️ NOT a
  /// requirement of the Act: it comes from the Hunters Forum guidelines of
  /// 2 September 2005. Associations issue it and DFOs expect it; that is why
  /// it is collected, and it is not a reason to tell a member the Act demands
  /// it.
  ASSOCIATION_ENDORSEMENT
  ADDRESS_CONFIRMATION
  EMPLOYMENT_CONFIRMATION
  // The safe, closed.
  SAFE_PHOTO_CLOSED
  // The safe, half open with the key in the door.
  SAFE_PHOTO_AJAR
  // The safe, fully open with the roll bolts visible.
  SAFE_PHOTO_BOLTS
  // Retired 2026-08-19 — superseded by the three shots above.
  SAFE_PHOTO
  // NOT retired: how the safe is anchored, which no door shot shows.
  SAFE_INSTALLATION
  CHARACTER_REFERENCE
  /// A log of hunts or competitive shoots — dates, venues, disciplines,
  /// species. Annexure "J. SHOOTING ACTIVITIES" in the packs professional
  /// writers produce, and the single best evidence that a section 15 or 16
  /// applicant actually does the thing they are applying to do. Nothing in the
  /// Act names it; associations keep these logs and DFOs read them.
  SHOOTING_ACTIVITY_LOG
  /// WHERE THE FIREARM IS COMING FROM — one annexure, two forms.
  ///
  /// Either the dealer's invoice, quote or proof that the firearm is being
  /// received from their stock, OR a letter from the CURRENT LICENCE HOLDER
  /// giving the applicant permission to apply for a licence over that firearm.
  /// One kind rather than two because a given application has exactly one
  /// answer to "whose firearm is this", and splitting it would produce an
  /// index with a permanently empty letter on it.
  FIREARM_SOURCE_PROOF
  /// The current owner's licence, for a private transfer. Pairs with a
  /// permission letter: the letter says they agree, this shows they are the
  /// person entitled to agree.
  SELLER_LICENCE
  /// Letter of appointment as executor, where the firearm is inherited —
  /// named by SAPS's own application guidance and governed by s 147/148 and
  /// reg 103.
  EXECUTOR_APPOINTMENT
  INCIDENT_REPORT
  PREVIOUS_MOTIVATION
  OTHER
}

model Motivation {
  id              String @id @default(cuid())
  // MO000123 — allocated from the atomic ReferenceCounter, printed on the PDF
  // so the applicant can quote it to support. Same posture as
  // Complaint.referenceNumber.
  referenceNumber String @unique
  userId          String
  user            User   @relation("UserMotivations", fields: [userId], references: [id], onDelete: Cascade)

  licenceType MotivationLicenceType

  // THE THROTTLE KEY — one motivation per type per application.
  // NOT nullable, and defaulted to "", deliberately: Postgres treats NULLs as
  // DISTINCT, so a nullable column would let @@unique pass every time and the
  // throttle would silently never fire. An empty string is a real value, so the
  // constraint bites on the first duplicate. An admin voiding a motivation
  // rewrites this to "voided:<id>", which releases the slot without deleting
  // the row.
  applicationRef String @default("")

  status MotivationStatus @default(DRAFT)

  // ── POPIA: encrypted at rest (AES-256-GCM, common/blob-crypto.ts) ──
  // The structured answers as ONE encrypted JSON blob. Deliberately not a Json
  // column: this is ID number, home address, security circumstances and firearm
  // serials. The trade-off is accepted because these answers are never queried
  // or indexed — only read whole, by their owner.
  answersEncrypted     String? @db.Text
  // Which version of the field registry the blob was written against, so a
  // later registry change can migrate old blobs rather than guess.
  answersSchemaVersion String? @db.VarChar(40)

  // The generated motivation body, encrypted for the same reason. The PDF
  // itself is NOT stored — it is re-rendered deterministically from this text
  // on every download, the same posture as ReceiptService.
  documentTextEncrypted String? @db.Text
  /// Background research gathered by web search before writing — the area's
  /// crime context, the firearm and cartridge background. Encrypted because it
  /// names the applicant's suburb. Written once and reused across gate cycles:
  /// the area and the firearm do not change between attempts.
  researchEncrypted     String? @db.Text
  documentVersion       Int     @default(0)
  // Versions of the attorney-reviewed PDF skeleton and disclaimer, stamped at
  // generation so documents produced under a reviewed version can be told
  // apart from ones produced after a template change.
  templateVersion       String? @db.VarChar(40)

  // ── Which template the applicant picked ────────────────────────────
  //
  // ⚠️ STORED AS PLAIN STRINGS, NOT ENUMS, and that is the deliberate choice.
  // Adding a colourway or a format is then a code deploy and a picker row,
  // never a Postgres migration — and ALTER TYPE ... ADD VALUE is one-way and
  // cannot be used in the same transaction that adds it, which has already
  // cost this codebase two-file migrations more than once. The renderer
  // validates and falls back, so an unknown value degrades to the default
  // rather than failing a download.
  //
  // NOT encrypted: a colour preference is not personal information, and
  // keeping it in the clear means the template picker can read it back
  // without decrypting the answers blob.
  templateFormat    String? @db.VarChar(20)
  templateColourway String? @db.VarChar(20)

  /// WHICH PHOTOGRAPH GOES ON THE COVER, and whether the applicant has looked
  /// at it.
  ///
  /// null   nobody has chosen — the found stock photograph is used if we hold
  ///        one, because plausiblyShows() already guarantees it is the right
  ///        make and model. See motivation-firearm-image.
  /// STOCK  they saw the stock photograph and kept it.
  /// OWN    they uploaded their own; coverPhotoKey points at it.
  /// NONE   they looked and wanted no photograph at all. ⚠️ DISTINCT FROM
  ///        null: "I do not want one" and "nobody has been asked" have to be
  ///        told apart, or a deliberate refusal is silently overridden the
  ///        next time we find an image.
  ///
  /// A VarChar rather than an enum, like templateFormat and templateColourway
  /// above: adding a value costs no migration, and every read validates.
  coverPhotoChoice  String? @db.VarChar(12)
  /// Encrypted storage key for the applicant's OWN cover photograph.
  ///
  /// ⚠️ THE ENCRYPTED TREE, NOT assets/firearms. A stock photograph of a CZ 75
  /// is a shared asset with no retention obligation; a photograph the
  /// applicant took of their own firearm is their data, may show their serial
  /// number, and belongs where the rest of their documents live.
  coverPhotoKey     String? @db.VarChar(120)
  coverPhotoMime    String? @db.VarChar(40)
  disclaimerVersion String? @db.VarChar(40)

  // ── Anti-template variation ──
  // The single biggest product risk is CFR seeing a flood of identically-shaped
  // documents. The seed is stored so a regeneration is reproducible and an
  // admin can prove WHY two documents differ; structurePlan is computed by US
  // in code (section order, heading set, opening/closing strategy, paragraph
  // targets) and Claude only phrases it. Non-PII, so plain Json.
  variantSeed          Int
  structurePlan        Json?
  // Hashed STRUCTURAL shingles — heading sequence and sentence-opener trigrams
  // with proper nouns and numbers stripped. Carries no applicant content, so it
  // stays queryable in the clear for the sameness check.
  structureFingerprint String[]

  // ── Quality gate — a thin motivation never renders ──
  qualityScore    Int?
  // Full verdict, so admin re-reads the reasoning without paying for a second
  // Claude call.
  qualityFindings Json?
  // Field KEYS only, never values — a key like "safe_storage_detail" is
  // metadata, so this is safe unencrypted and drives the follow-up interview.
  thinFields      String[]
  gateCycles      Int      @default(0)

  // ── Spend audit. Decimal, not Float — money and near-money never float. ──
  modelUsed        String?
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal? @db.Decimal(10, 6)

  // ── Commercial / beta bookkeeping ──
  // Monotonic seat number from the atomic 'MOBETA' ReferenceCounter row.
  // NULL means this was not a free-beta motivation. A seat above the cap is
  // burned rather than reissued — that is what makes the cap race-proof.
  betaSeatNo            Int?      @unique
  billedCents           Int       @default(0)
  /// When the applicant allowed us to fill the SAPS form from their All Outdoor
  /// profile. Null means they were never asked, or said no — either way we do
  /// not touch their profile data. Per motivation, not per account: agreeing
  /// once is not agreeing forever.
  profileConsentAt      DateTime?
  testimonialConsentAt  DateTime?
  // The applicant's own declaration that the facts are true and they submit it
  // as their own motivation. No PDF renders without this.
  declarationAcceptedAt DateTime?

  // ── Phase 2 seed (the application checker) ──
  outcomeAskedAt    DateTime?
  outcomeReportedAt DateTime?
  outcome           String?

  // ── Lifecycle: one stamp per terminal transition, house convention ──
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  submittedAt      DateTime?
  generatedAt      DateTime?
  qualityPassedAt  DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  failureReason    String?
  // POPIA retention. Set when the motivation completes; a weekly cron deletes
  // the row and its stored files past this date.
  retentionPurgeAt DateTime?

  messages  MotivationMessage[]
  uploads   MotivationUpload[]
  witnesses MotivationWitness[]

  // The throttle. See applicationRef for why it is NOT NULL.
  @@unique([userId, licenceType, applicationRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([retentionPurgeAt])
}

// Boet's targeted follow-up interview. Modelled on AskGgMessage including its
// per-message cost columns, but scoped to one motivation and carrying fieldKey
// so an answer writes back into a typed form field rather than living only as
// chat. Content is encrypted: the follow-ups are exactly where the
// security-circumstances narrative lands.
model MotivationMessage {
  id               String     @id @default(cuid())
  motivationId     String
  motivation       Motivation @relation(fields: [motivationId], references: [id], onDelete: Cascade)
  role             String // 'assistant' | 'user'
  contentEncrypted String     @db.Text
  // Which structured field this question targets (null for plain conversation).
  // The answer is merged into answersEncrypted under this key — this is what
  // makes the interview a form-filler rather than a transcript.
  fieldKey         String?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal?   @db.Decimal(10, 6)
  createdAt        DateTime   @default(now())

  @@index([motivationId, createdAt])
}

// Camera-scanned / uploaded source documents.
//
// STORED ON OUR OWN SERVER, ENCRYPTED (operator decision 2026-08-18). There is
// no Cloudinary URL here and there must never be one: every upload rail in this
// codebase lands on a PUBLIC secure_url, which is obscurity rather than access
// control, and these are photographs of ID books and firearm licences. The
// bytes live at SecureFileStorageService's storageKey, AES-256-GCM at rest,
// reachable only through an authenticated endpoint that checks ownership.
/// A CHARACTER WITNESS STATEMENT, completed by the witness themselves.
///
/// ⚠️ THE ONLY ROW IN THIS SYSTEM WRITTEN BY SOMEBODY WHO IS NOT A MEMBER.
/// Everything else on a motivation is the applicant's own answer about
/// themselves. This is a third party putting their name, their identity number
/// and their signature on a document that goes to the police, from a phone
/// they opened a link on. That shapes every decision below.
///
/// ⚠️ THE APPLICANT MAY DELETE IT, AND THAT IS DELIBERATE (operator, 2026-08-21:
/// "They have full right to delete it. if they delete it the spot to enter a new
/// witness name and number opens"). It is their application and nobody is
/// obliged to file an unfavourable statement — the paper flow works the same
/// way. The witness is told so on the form, in as many words, so nobody signs
/// under a false impression about what happens next.
model MotivationWitness {
  id           String     @id @default(cuid())
  motivationId String
  motivation   Motivation @relation(fields: [motivationId], references: [id], onDelete: Cascade)

  /// 1 or 2 — which of the two slots this fills. Unique per motivation, so a
  /// deleted witness genuinely frees its slot rather than accumulating rows.
  slot Int

  // ── What the applicant supplies when inviting ────────────────────
  /// As the applicant typed it. Shown to the witness so they can tell us we
  /// have the wrong person before they fill anything in.
  invitedName  String
  /// The number the link and the code are sent to.
  invitedPhone String

  /// INVITED · VERIFIED · COMPLETED. No enum: a new state costs no migration.
  status String @default("INVITED")

  // ── Proving the number belongs to the person holding the phone ───
  //
  // ⚠️ THE LINK ALONE IS NOT ENOUGH. An SMS can be forwarded, and a token in a
  // URL is a bearer credential — whoever holds it is the witness as far as the
  // server knows. The code is what ties the statement to the number the
  // applicant nominated. Mirrors the phone-change OTP on User.
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  verifiedAt   DateTime?

  // ── What the witness fills in ────────────────────────────────────
  //
  // ⚠️ ENCRYPTED, ALL OF IT. A third party's full name, identity number and
  // daytime contact number is exactly the material the rest of this module
  // encrypts, and it was given to us by somebody who is not our member and
  // cannot log in to manage it. answersEncrypted holds the lot as JSON.
  answersEncrypted String? @db.Text

  /// Their drawn signature, in the encrypted upload tree. A storage key, never
  /// a path and never bytes on this row.
  signatureKey  String? @db.VarChar(120)
  signatureMime String? @db.VarChar(40)

  /// "Bloemfontein, Free State" — the place of signature, from the phone's GPS
  /// and reverse-geocoded to a town.
  ///
  /// ⚠️ THE PLACE, NEVER THE COORDINATES. A statement needs a "signed at" line;
  /// it does not need a stranger's position to five decimal places, and storing
  /// one would be keeping something we have no use for.
  signedPlace String?   @db.VarChar(160)
  signedAt    DateTime?

  // ── The audit trail ──────────────────────────────────────────────
  /// Stamped when the link is first opened, so an applicant can see whether
  /// their witness has looked at it before chasing them.
  openedAt        DateTime?
  /// When they said no.
  ///
  /// ⚠️ RECORDED RATHER THAN DELETED, so the applicant learns they have been
  /// turned down instead of watching an invitation that never moves. Nobody is
  /// obliged to give a character statement, and somebody who declines has done
  /// nothing wrong — the row exists to stop the applicant waiting, not to mark
  /// anybody.
  declinedAt      DateTime?
  /// Kept because the DFO may ask how a statement was taken (reg 13(8)).
  submitIp        String?   @db.VarChar(64)
  submitUserAgent String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([motivationId, slot])
  @@index([motivationId])
}

model MotivationUpload {
  id           String               @id @default(cuid())
  motivationId String
  motivation   Motivation           @relation(fields: [motivationId], references: [id], onDelete: Cascade)
  kind         MotivationUploadKind

  /// OTHER CHECKLIST ROWS THIS ONE ATTACHMENT SATISFIES.
  ///
  /// ⚠️ ONE ROW PER FILE, ALWAYS. An association membership certificate is
  /// routinely both the association card AND the section 16 letter of good
  /// standing — one page saying both. The obvious fix, a second upload row
  /// pointing at the same bytes, is wrong twice over: it collides with
  /// @@unique([motivationId, sha256]), and annexureImages iterates upload ROWS,
  /// so the same page would print twice in the pack under two annexure
  /// letters. A DFO reading that sees padding, not thoroughness.
  ///
  /// So the extra roles ride on the single row, and documentStatus counts a
  /// requirement met by `kind` OR by anything in here.
  coversKinds MotivationUploadKind[] @default([])

  // Opaque key into SecureFileStorageService — `<ns>/<yyyy>/<mm>/<id>.enc`.
  // NEVER a filesystem path and never a URL. Nullable only so a row can outlive
  // its bytes after a retention purge without breaking the audit trail.
  storageKey String?
  mimeType   String
  byteSize   Int
  // SHA-256 of the PLAINTEXT bytes — spots the same document uploaded twice and
  // proves which file an extraction came from.
  sha256     String

  // What Claude vision read off the document, encrypted: it holds licence
  // numbers, the holder's name and expiry dates.
  extractionEncrypted String?
  extractionOk        Boolean  @default(false)
  // Field KEYS the extraction proposed — safe in the clear, drives the
  // "we found 6 fields, confirm them" card without decrypting anything.
  extractedFields     String[]

  createdAt DateTime  @default(now())
  // Set when the bytes are deleted (retention purge or user erasure) while the
  // row is kept. storageKey is nulled at the same time.
  purgedAt  DateTime?

  // Scoped to the motivation, not global: the same ID document legitimately
  // appears in two different people's applications, and in the same person's
  // second one. A bare index could only ever support a read-then-write dedupe,
  // which is a race — two uploads of one file both miss the read and both
  // insert, and the applicant sees the same certificate twice in the annexures.
  @@unique([motivationId, sha256])
  @@index([motivationId])
}

// ────────────────────────────────────────────────────────────────────
// THE LICENCE & COMPETENCY CENTRE.
//
// Operator, 2026-08-19: "a licence and competency centre on its own, where
// people can keep and upload their licences and competencies, so it can be
// kept book of and tracked for expiry."
//
// A member's own documents, encrypted on our disk, with the expiry date
// tracked so a renewal is never missed for want of a reminder. Renewals recur
// by statute, which is what makes this the recurring-income engine: the
// reminder lands, one tap opens a pre-filled S24 renewal motivation.
//
// ⚠️ THE SAFETY RAIL IS `confirmedAt`. Extraction PROPOSES an expiry date; the
// member confirms it; only a confirmed date is ever visible to the reminder
// cron. A misread date driving reminders is how somebody misses a real
// deadline because of us — worse than no reminder at all, and not something a
// disclaimer unwinds.
//
// ⚠️ WHAT IS IN THE CLEAR AND WHY. Only the DATES and the member's own title
// for the document. A date identifies nobody; the cron has to query on it, and
// encrypting it would mean decrypting the whole table nightly. Every
// identifying value — licence number, holder name, make, calibre, serials —
// lives inside detailsEncrypted.
//
// ⚠️ VAULT BYTES ARE DUPLICATED FROM THE WRITER, NEVER SHARED. A motivation
// upload purges on the writer's own clock; a vault document lives as long as
// the account. One row must never be able to delete the other's bytes.
// ────────────────────────────────────────────────────────────────────

enum CredentialKind {
  FIREARM_LICENCE
  COMPETENCY_CERTIFICATE

  /// WHAT AN ASSOCIATION SAYS ABOUT A MEMBER — one kind for all of it.
  ///
  /// Dedicated sport shooter, dedicated hunter, professional hunter
  /// registration and the section 16 letter of good standing were four kinds.
  /// They are one, because the paper is usually one: a SA Hunters membership
  /// certificate declares the member "in good standing", prints "Toegewyde
  /// Sportskut / Dedicated Sport Shooter" with its number, and gives a single
  /// validity window governing both.
  ///
  /// ⚠️ THE SPLIT FORCED A GUESS AND THE GUESS WAS WRONG. The classifier had
  /// to choose between hunter and sport on a certificate from a body
  /// accredited for both, and filed the operator's sport-shooter status as
  /// DEDICATED_HUNTER on the strength of "Hunters" in the letterhead — the
  /// wrong status on a section 16 application. Which discipline it is, and
  /// whether the member is in good standing, are FACTS READ OFF THE DOCUMENT
  /// (disciplineType, and the details blob), not categories to sort into.
  ///
  /// A member may hold several of these, one per association. That is the
  /// normal case, not an edge case.
  DEDICATED_DISCIPLINE

  /// ⚠️ RETIRED — kept because Postgres has no ALTER TYPE ... DROP VALUE, and
  /// existing rows were migrated to DEDICATED_DISCIPLINE. Not offered in any
  /// picker and refused by the write path. Do not reach for these: filing a
  /// status document under one of them puts it outside every query that now
  /// looks for DEDICATED_DISCIPLINE.
  DEDICATED_STATUS
  /// ⚠️ RETIRED — see DEDICATED_DISCIPLINE.
  DEDICATED_HUNTER
  /// ⚠️ RETIRED — see DEDICATED_DISCIPLINE. Professional Hunter registration
  /// is still not dedicated status and still evidences nothing under section
  /// 16; that distinction now lives in disciplineType, where it can be read
  /// rather than inferred from which pile the document landed in.
  PROFESSIONAL_HUNTER
  PROFICIENCY
  /// ⚠️ RETIRED — see DEDICATED_DISCIPLINE.
  GOOD_STANDING
  // Association membership, anything else the member wants kept with the
  // rest. Never chased, always accepted.
  OTHER
}

model Credential {
  id     String         @id @default(cuid())
  userId String
  user   User           @relation("UserCredentials", fields: [userId], references: [id], onDelete: Cascade)
  kind   CredentialKind

  /// OTHER ROLES THIS ONE DOCUMENT ALSO FILLS.
  ///
  /// ⚠️ ONE DOCUMENT, ONE ROW, SEVERAL ROLES — never a second row for the same
  /// file. A SA Hunters membership certificate declares the member "in good
  /// standing", carries the dedicated sport-shooter number, and gives ONE
  /// validity window covering both; filing it twice would satisfy two
  /// checklist rows and then print the same page twice, under two annexure
  /// letters, because annexureImages iterates upload rows. It would also
  /// collide with @@unique([userId, sha256]).
  ///
  /// `kind` stays the document's primary identity — what it IS, and what
  /// decides its default title and how it is grouped. This lists what it also
  /// COUNTS AS. Empty for the ordinary single-purpose document.
  ///
  /// Note the enum comment above: GOOD_STANDING was split out of
  /// DEDICATED_STATUS precisely because some associations issue two papers
  /// with two different windows. That case is unchanged and still correct —
  /// this is for the associations that issue one.
  ///
  /// ⚠️ ITS ORIGINAL JUSTIFICATION IS GONE. This column was added a day
  /// earlier so a membership certificate filed as DEDICATED_STATUS could also
  /// count as GOOD_STANDING. Those are now the same kind, so there is nothing
  /// left to cover between them and the migration scrubbed every such entry —
  /// a row covering its own kind would double-match one checklist row, which
  /// cleanAlsoCovers already forbids. It stays for the genuinely different
  /// case: a document that is, say, a firearm licence AND something else.
  coversKinds CredentialKind[] @default([])

  /// WHICH DISCIPLINE THIS DOCUMENT ATTESTS, in the clear.
  ///
  /// 'DEDICATED_SPORT' | 'DEDICATED_HUNTER' | 'PROFESSIONAL_HUNTER' | 'BOTH',
  /// or one of the four retired kind names for a row the migration moved.
  ///
  /// ⚠️ NOT IN detailsEncrypted, deliberately. The extraction already reads
  /// status_type off the certificate, but that lands inside an AES-GCM blob
  /// which SQL cannot see — so a migration could not have preserved which of
  /// the four kinds a row used to be, and no query can group or filter on the
  /// discipline. This column is the plaintext discriminator that makes both
  /// possible. It holds a category, never a number and never a name.
  disciplineType String?

  /// The member's own name for it — "My .308". In the clear so the list can
  /// be rendered and the reminder addressed; the UI warns against serials.
  title            String
  /// Licence number, holder, make, calibre, serials, issuer. AES-256-GCM via
  /// blob-crypto, same key and HKDF domain as the motivation uploads.
  detailsEncrypted String?

  /// IN THE CLEAR — the reminder cron queries on it. See the header.
  issuedOn    DateTime?
  expiresOn   DateTime?
  /// THE SAFETY RAIL. Null until the member has looked at the expiry date and
  /// said it is right. The reminder sweep will not see a row without it.
  confirmedAt DateTime?

  /// Opaque key into SecureFileStorageService, namespace `credentials`.
  /// Nullable so a row can outlive its bytes after an erasure.
  storageKey String?
  mimeType   String
  byteSize   Int
  /// SHA-256 of the PLAINTEXT bytes. Scoped to the member, not global — two
  /// people may legitimately hold copies of the same document.
  sha256     String

  /// ⚠️ NEVER WRITTEN FOR A CREDENTIAL. The Licence Centre puts what vision
  /// read into `detailsEncrypted` above. This column exists because the model
  /// mirrors MotivationUpload, where it IS used — and a reader that trusted
  /// the mirror decrypted null on every row for months, which is how the
  /// vault silently failed to fill anything on a motivation.
  extractionEncrypted String?
  extractionOk        Boolean  @default(false)
  /// Field KEYS in the clear; the values are in `detailsEncrypted`.
  extractedFields     String[]

  /// One nullable stamp per reminder stage, CAS-claimed before sending.
  /// ⚠️ NOT a String[] of stage names: Postgres cannot express "array does
  /// not contain X" atomically in an updateMany where-clause, so an array
  /// cannot be claimed and two overlapping sweeps would both send.
  remind180SentAt DateTime?
  remind120SentAt DateTime?
  remind100SentAt DateTime?
  remind30SentAt  DateTime?
  remindD0SentAt  DateTime?
  /// The member asked us to stop reminding about this one. Their call.
  remindersMuted  Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Set when the bytes have been removed. The row survives so a future sweep
  /// never goes looking for a file that is already gone.
  purgedAt  DateTime?

  @@unique([userId, sha256])
  @@index([userId])
  @@index([expiresOn])
  // The reminder sweep's exact predicate.
  @@index([confirmedAt, remindersMuted, expiresOn])
}
