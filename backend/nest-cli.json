{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "load-lab/internal-ballistics/grt-data/*.json",
        "outDir": "dist/src"
      },
      {
        "include": "load-lab/data/*.json",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  }
}
