# ===========================================================================
# All Outdoor (Gun Galore) — backend/.env.example
#
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# This file carries NAMES, descriptions and SAFE PLACEHOLDERS only.
#
# Read docs/ENVIRONMENT.md before you change anything here. Several of these
# fail CLOSED (the feature refuses rather than degrades) and one of them
# (ID_HASH_SECRET) permanently destroys stored data if you rotate it.
#
# Loading: src/main.ts calls dotenv.config({ override: true }) BEFORE Nest
# boots. `override: true` is deliberate — some shells export an EMPTY
# ANTHROPIC_API_KEY, and without override dotenv would leave the empty value
# in place. The .env file wins over the shell here.
#
# Boot gate: assertProductionConfig() in src/main.ts HARD-THROWS on a missing
# JWT_ADMIN_SECRET in production, and logs loud WARNs for the launch-critical
# credentials. If the process crash-loops under pm2 right after a deploy,
# read the first 30 lines of the pm2 log — it will name the variable.
# ===========================================================================


# ─── Core runtime ──────────────────────────────────────────────────────────

# development | production. Production turns on the config gate, fails the
# inbound webhooks closed, and strips localhost/LAN origins from the CORS list.
NODE_ENV=development

# HTTP port. Nest mounts everything under the global prefix /api.
PORT=3001

# Public base URL of the FRONTEND. Three jobs: the CORS allow-list in
# main.ts, and the absolute links baked into outbound email + SMS, and the
# fallback base for Peach's server-to-server callback URL. Get it wrong and
# emails send buyers to the wrong host. No trailing slash.
# Local: http://localhost:3000   Prod: https://gungalore.co.za
FRONTEND_URL=http://localhost:3000

# Public origin of THIS API, used as the Peach `notificationUrl` and as the
# base string for webhook signature verification. Only needed when Peach is
# live. Unset → derived as FRONTEND_URL + '/api'.
PUBLIC_API_URL=


# ─── Database ──────────────────────────────────────────────────────────────

# PostgreSQL 16. Prisma reads this directly.
# GOTCHA: pg_dump/pg_restore do NOT understand Prisma's `?schema=public`
# query param — strip it when you pipe this string into pg tooling.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gun_galore?schema=public


# ─── Auth: Clerk (buyers + sellers) ────────────────────────────────────────

# Server-side Clerk key. sk_test_* for the dev instance, sk_live_* for prod.
# Missing → every authenticated request 401s. There is no degraded mode.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Svix signing secret for the Clerk webhook (Clerk dashboard → Webhooks).
# FAILS CLOSED: unset or wrong → inbound user.created/updated/deleted events
# cannot be verified and are DROPPED, so new sign-ups never get a User row.
# The lazy upsert in ClerkGuard is the backstop, but a bad secret raises a
# WEBHOOK_SIGNATURE_INVALID admin alert — do not ignore it.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL, opt-in hardening. Comma-separated list of origins allowed to mint
# session tokens for this API (Clerk `azp` claim). Unset → azp is not checked
# (Clerk's own default). Deliberately opt-in so we can't lock out the
# Capacitor app shells by forgetting to list capacitor:// / ionic://.
# Example: https://gungalore.co.za,capacitor://localhost,ionic://localhost
CLERK_AUTHORIZED_PARTIES=


# ─── Auth: Admin (custom JWT, entirely separate from Clerk) ────────────────

# Signs and verifies the /admin session token. In PRODUCTION a missing,
# empty, or the known-bad legacy default value THROWS at boot — the process
# will not start. That is intentional: the old fallback was a string in this
# repo, so anyone could have forged a SUPERADMIN token.
# Local dev needs nothing here; src/admin/admin-jwt-secret.ts substitutes a
# throwaway dev-only value. Generate prod: openssl rand -hex 32
JWT_ADMIN_SECRET=


# ─── SA ID encryption — READ docs/ENVIRONMENT.md BEFORE TOUCHING ───────────
#
# ⚠️  THIS IS THE ONE VARIABLE YOU CAN NEVER ROTATE.
#
# src/common/id-crypto.ts uses it for BOTH jobs:
#   1. HKDF-SHA256 input → the AES-256-GCM key encrypting sellers' 13-digit
#      SA ID numbers at rest (User.idNumberEncrypted).
#   2. The salt in sha256(secret + id) → User.kycIdHash, which carries a DB
#      UNIQUE constraint used to detect duplicate identities.
#
# Change it and every already-stored ID becomes permanently undecryptable
# and every stored hash stops matching. There is no recovery — the plaintext
# was deliberately never kept anywhere else.
#
# The HKDF `info` string is the hard-coded literal 'gungalore-id-encrypt' in
# id-crypto.ts. A repo-wide search-and-replace of "gungalore" (say, during
# the All Outdoor rebrand) silently changes the derived key with NO error at
# build time and NO error until the first decrypt fails. Do not rename it.
#
# Local dev: any long random string is fine. Set it — src/kyc/kyc.service.ts
# has its own copy of the hash function that silently falls back to a salt
# committed in this repo when the var is unset, so hashes computed without
# it will not match hashes computed with it.
# Generate: openssl rand -hex 32
ID_HASH_SECRET=


# ─── KYC: VerifyNow (SA identity + PEP screening) ──────────────────────────

VERIFYNOW_API_KEY=
VERIFYNOW_BASE_URL=https://api.verifynow.co.za

# sandbox (free, canned data) | production (real lookups, burns credits).
# Defaults to sandbox when unset. Sandbox in production silently PASSES fake
# identities — main.ts logs a loud WARN but still boots, on purpose, so a
# deploy can't take prod down before launch credentials are wired.
VERIFYNOW_MODE=sandbox

# OPTIONAL. Overrides the report type string sent on the basic lookup. Only
# set this if VerifyNow tells you to.
VERIFYNOW_BASIC_REPORT_TYPE=

# OPTIONAL. Credit balance at which the 5-minute cron starts nagging admins
# to top up. Default 100. Set to a number, not a string with units.
LOW_CREDIT_THRESHOLD=100


# ─── AI: Anthropic ─────────────────────────────────────────────────────────

# Powers Ask Boet, Claude-vision KYC, listing + Q&A moderation, the
# contact-detail filter, firearm-licence / dealer / swap-proof verification,
# price estimates and load-data extraction.
# Missing → nothing crashes, everything DEGRADES: listings route to
# HUMAN_REVIEW instead of auto-publishing, the contact filter drops to its
# regex layer only, Ask Boet goes quiet. Boot logs a WARN.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SEPARATE Anthropic *admin* key (Console → Admin keys, starts sk-ant-admin).
# Only used by the spend monitor on /admin/credits. A regular API key here
# does not work — the usage endpoint rejects it.
ANTHROPIC_ADMIN_API_KEY=

# Model overrides. All OPTIONAL — the defaults shown are what the code uses
# when the var is unset. Set these to pin a model or to cost-tune; a typo in
# a model id is a runtime 404 from the API, not a build error.
ANTHROPIC_MODEL_SIMPLE=              # default claude-haiku-4-5-20251001 — cheap pass: moderation, Q&A, contact filter
ANTHROPIC_MODEL_JUDGE=               # default claude-sonnet-4-6 — escalated pass: licence/dealer/swap vision, OCR
ANTHROPIC_MODEL_KYC=                 # default claude-sonnet-5 — KYC face-match + document read
ANTHROPIC_MODEL_PRICE_ESTIMATE=      # default claude-haiku-4-5-20251001
ANTHROPIC_MODEL_LOADDATA=            # default claude-sonnet-4-6 — reloading-manual extraction
ANTHROPIC_MODEL_INSIGHTS_DIGEST=     # default claude-sonnet-4-6 — weekly analytics digest
ANTHROPIC_MODEL_ASK_GG_LANE=         # default claude-haiku-4-5-20251001 — Ask Boet intent router
ANTHROPIC_MODEL_ASK_GG_DEFAULT=      # default claude-sonnet-4-6
ANTHROPIC_MODEL_ASK_GG_ESCALATED=    # default claude-opus-4-8
ANTHROPIC_MODEL_HB_RANGE_DEFAULT=    # default claude-sonnet-4-6 — Hunt Ballistics range estimator
ANTHROPIC_MODEL_HB_RANGE_FALLBACK=   # default claude-opus-4-8

# Confidence below which the range estimator escalates to the Opus fallback.
# Opus is ~5x the cost, so this is a money dial. Default 0.7.
HB_RANGE_OPUS_THRESHOLD=0.7


# ─── Images: Cloudinary ────────────────────────────────────────────────────
# All three from the Cloudinary dashboard → Settings → API Keys.
# Any one missing → CloudinaryService logs a warn at boot and every upload
# throws 'Cloudinary not configured'. Listings cannot be created without
# photos, so in practice this is required even locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ─── Search: Meilisearch ───────────────────────────────────────────────────
# Unset MEILISEARCH_HOST → SearchService logs 'search disabled' and the app
# runs without it. Browse/filter still work off Postgres; the search box
# returns nothing. Fine for most local work.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=


# ─── SMS: SMSPortal ────────────────────────────────────────────────────────
# Client-ID + secret pair (SMSPortal → API keys). Both required or SMS is
# disabled and every send becomes a no-op — which silently breaks the
# SMS-link checkout and the waybill/PIN dispatch messages.
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
# Legacy alias for SMSPORTAL_CLIENT_ID, still read as a fallback. Prefer
# SMSPORTAL_CLIENT_ID for new setups.
SMSPORTAL_API_KEY=
# OPTIONAL. Default https://rest.smsportal.com/v1
SMSPORTAL_BASE_URL=


# ─── Email: Resend ─────────────────────────────────────────────────────────
# Unset → 'RESEND_API_KEY not set — emails disabled'; sends become no-ops.
# The in-app notification inbox still fills, so nothing looks broken locally.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# OPTIONAL. Reply-to / support address in outbound mail. Default
# support@gungalore.co.za
SUPPORT_EMAIL=
# OPTIONAL. Absolute URL of the logo in email templates. Needed locally only
# if you want images to render — a mail client cannot reach localhost:3000.
EMAIL_LOGO_URL=


# ─── Web push (VAPID) ──────────────────────────────────────────────────────
#
# ⚠️  A MATCHED KEY PAIR. Push subscriptions in browsers are bound to the
# public key that created them. Change either value and EVERY existing
# subscription in the PushSubscription table becomes undeliverable — users
# must re-grant permission before they get another push. Generate once, keep.
#   npx web-push generate-vapid-keys
#
# Missing → 'push notifications disabled'; sends are silent no-ops. The
# inbox, email and SMS channels are unaffected, so this is safe to skip
# locally. The frontend fetches the public key from GET /api/push/vapid-
# public-key at runtime — there is deliberately no NEXT_PUBLIC copy to drift.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: URL identifying us to Apple/Google push gateways. Default
# mailto:support@gungalore.co.za
VAPID_SUBJECT=mailto:support@example.co.za


# ─── Shipping: PUDO (locker-to-locker) ─────────────────────────────────────
# PUDO is a South African parcel-locker network — buyer and seller each use
# a locker instead of a street address. Popular here because a lot of trade
# happens between towns with no reliable home delivery.
# ⚠️ PUDO has NO sandbox. Creating a shipment bills real credits against the
# operator's account. Never call the create path casually.
PUDO_API_KEY=
# OPTIONAL second half of the credential on some PUDO account types.
PUDO_API_SECRET=
# OPTIONAL. Default https://api-pudo.co.za
PUDO_BASE_URL=


# ─── AWS: Textract OCR + Rekognition face match / liveness ────────────────
#
# ⚠️ eu-west-1 (IRELAND) AND NOWHERE ELSE. Checked against the live console:
# eu-north-1 (Stockholm) supports NEITHER service, and eu-central-1
# (Frankfurt) has Rekognition but NOT Face Liveness — its console omits the
# entry that us-east-1 and eu-west-1 both show. Ireland is the only region
# carrying all three, and EU adequacy is what makes the POPIA s72 transborder
# transfer defensible for SA identity documents.
#
# 🚨 THE KYC CONSENT COPY MUST NAME THE DESTINATION BEFORE THESE ARE USED.
# frontend/app/kyc/verify/page.tsx currently tells the seller their document
# and selfie go to providers 'in the United States'. POPIA s72(1)(b) consent
# is only valid if it is INFORMED, so sending to AWS Ireland under that
# wording has no legal basis. The IAM policy this pairs with lives at
# infra/aws/kyc-iam-policy.json.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Role the BROWSER's liveness challenge is given temporary credentials for.
# Our own key must never reach a browser, so the server assumes this role
# (rekognition:StartFaceLivenessSession only, region-locked) and hands the
# short-lived credentials to the page. UNSET = no liveness challenge runs,
# which means anti-spoofing is never checked and EVERY verdict parks in
# UNDER_REVIEW for a human. See infra/aws/README.md.
AWS_KYC_LIVENESS_ROLE_ARN=


# ─── Payments: Peach Payments ──────────────────────────────────────────────
#
# Peach is THE payment provider — Checkout V2 for pay-in, Payouts for seller
# disbursement, BANV for bank-account ownership verification. Leave the
# credentials blank and checkout runs in MOCK mode: the whole app is usable,
# no money moves.
#
# 'live' → the production hosts; anything else → the Peach sandbox hosts.
PEACH_ENV=sandbox

# OAuth client-credentials (Dashboard → Checkout → Settings). Shared by
# checkout, payouts and BANV.
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=

# Checkout channel/entity id.
PEACH_ENTITY_ID=

# The "secret token" that SIGNS checkout creates + refunds and VERIFIES
# inbound webhook signatures. Set the same value in the Dashboard under
# Webhook security.
# FAILS CLOSED: unset in production → inbound Peach webhooks are REJECTED,
# so a forged webhook can never mark an order paid. That also means a
# missing secret quietly stops real payments from ever confirming.
PEACH_SECRET=

# Webhook URLs to register in the Peach Dashboard:
#   /api/payments/webhook/peach          (checkout lifecycle)
#   /api/payments/webhook/peach-payout   (payout status)
#   /api/payments/webhook/peach-banv     (bank verification result)
#   /api/payments/webhook/peach-dispute  (chargebacks)

# Rail selectors. Both default OFF — the site is not trading yet.
#   PAYMENT_MODE=paygate → card-rate fee maths + card-reversal refund arm.
#                          Anything else → 'manual' (the pre-paygate maths).
#   PAYMENTS_LIVE=true   → opens checkout and enables payout disbursement.
#                          While false, every checkout entry point returns
#                          503 "card payments launching soon".
PAYMENT_MODE=manual
PAYMENTS_LIVE=false


# ─── Accounting: Zoho Books ────────────────────────────────────────────────
# Feature-flagged. ZOHO_BOOKS_ENABLED must be the literal string 'true'.
# If it is 'true' but any credential is blank, the service logs and disables
# itself rather than throwing — so a half-filled config looks like "off".
ZOHO_BOOKS_ENABLED=false
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_BOOKS_ORG_ID=
# Data-centre hosts. The account is on the .com DC.
# Defaults: https://www.zohoapis.com and https://accounts.zoho.com
ZOHO_BOOKS_API_DOMAIN=https://www.zohoapis.com
ZOHO_BOOKS_ACCOUNTS_DOMAIN=https://accounts.zoho.com


# ─── Reloading-manual library ──────────────────────────────────────────────
# The operator SCPs manual PDFs into the inbox dir; the ingest job OCRs them
# and moves them into the storage dir under a random hex filename. Both are
# absolute paths on the server's filesystem.
# Defaults (relative to the backend process cwd): ../manual-inbox and
# ../manuals — which is why the repo root has a manual-inbox/ directory.
RELOADING_MANUALS_INBOX_DIR=
RELOADING_MANUALS_STORAGE_DIR=
# OPTIONAL. Pages per Claude call during OCR backfill. Default 6.
OCR_CHUNK_PAGES=


# ─── Operational secrets ───────────────────────────────────────────────────

# Query-string key for GET /api/health/crons, the unauthenticated endpoint an
# external uptime monitor polls for cron freshness.
# FAILS CLOSED: unset → the endpoint returns 503 'not configured' rather than
# 200, so a monitor wired before the secret exists alarms loudly instead of
# reporting a false healthy.
HEALTH_PING_SECRET=


# Coming-soon gate bypass. The FRONTEND owns this gate (see
# frontend/.env.example) — the value is mirrored here only so the two
# processes can be deployed from one env file on the server. Nothing in the
# backend reads it.
COMING_SOON_BYPASS_SECRET=


# ===========================================================================
# Present in the LIVE server's .env but NOT read by any code in this repo.
# Left here, commented, so the next person reconciling the server against
# this file knows they are dead rather than missing. Safe to delete from the
# server. Verified by grep across backend/ frontend/ scripts/ on 2026-08-12.
#
#   BACKEND_URL              — superseded by PUBLIC_API_URL
#   GOOGLE_MAPS_API_KEY      — maps are frontend-only; see
#                              NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#   STITCH_CLIENT_ID         — Stitch was replaced by Peach. Only
#   STITCH_CLIENT_SECRET       scripts/stitch-redirect-setup.cjs (a one-off
#                              setup script) still references these.
#   FNB_ACCOUNT_SUFFIX       — FNB payout batch rail was stripped 2026-07
#   IMAP_HOST / IMAP_PORT    — no IMAP client in the codebase
#   IMAP_USER / IMAP_PASSWORD
#   PEACH_ACCESS_TOKEN       — not the Peach auth model we implemented; the
#   PEACH_BASE_URL             code uses PEACH_CLIENT_ID/SECRET + PEACH_ENV
#   ODOO_URL / ODOO_DB       — Odoo was replaced by Zoho Books
#   ODOO_API_KEY
#
# If you delete these from the server, rotate STITCH_CLIENT_SECRET and the
# IMAP password rather than just removing them — they were real credentials.
# ===========================================================================
