# ===========================================================================
# Gun Galore — backend/.env.example
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Variable names are the canonical list from CLAUDE.md.
# ===========================================================================

# --- Core runtime ---------------------------------------------------------
NODE_ENV=development
PORT=3001
# Public base URL of the backend API (used for Peach webhook notificationUrl).
# Prod example: https://gungalore.co.za
BACKEND_URL=
# Public base URL of the frontend (CORS allow-list + email/SMS links).
# Prod example: https://gungalore.co.za
FRONTEND_URL=

# --- Database (PostgreSQL) ------------------------------------------------
# Example: postgresql://USER:PASSWORD@localhost:5432/gun_galore?schema=public
DATABASE_URL=

# --- Auth: Clerk (buyers + sellers) ---------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Auth: Admin (custom JWT, separate from Clerk) ------------------------
JWT_ADMIN_SECRET=

# --- KYC: VerifyNow -------------------------------------------------------
VERIFYNOW_API_KEY=
VERIFYNOW_BASE_URL=
# "sandbox" (free, canned data) | "production" (real identity checks, uses
# credits). MUST be "production" at launch — sandbox in prod silently passes
# fake identities. Defaults to sandbox if unset.
VERIFYNOW_MODE=sandbox

# --- AI: Anthropic (listing moderation, skill questions, quality scoring) -
ANTHROPIC_API_KEY=

# --- Images: Cloudinary ---------------------------------------------------
# All three values are on your Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Search: Meilisearch --------------------------------------------------
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- SMS: SMSPortal -------------------------------------------------------
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=

# --- Email: Resend --------------------------------------------------------
RESEND_API_KEY=

# --- Shipping: Pudo (lockers) ---------------------------------------------
PUDO_API_KEY=

# --- Shipping: The Courier Guy (TCG, door) --------------------------------
TCG_API_KEY=
TCG_WEBHOOK_SECRET=

# --- Maps -----------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Accounting: Odoo (self-hosted, Community edition) --------------------
ODOO_API_KEY=
ODOO_URL=
ODOO_DB=

# --- Payments: Peach Payments (Checkout V2 pay-in + Payouts pay-out) -------
# The ONLY payment provider. Leave blank → checkout runs in MOCK mode (no
# real charges); the app is fully usable inert. Fill ALL of these + set
# PEACH_ENV=live + PAYMENT_MODE=paygate + PAYMENTS_LIVE=true to go live.
#
# 'live' → dashboard/secure/api/payouts.peachpayments.com hosts;
# anything else → the sandbox hosts (testsecure / sandbox-dashboard / …).
PEACH_ENV=sandbox
# OAuth client-credentials (Dashboard → Checkout → Settings). Shared by the
# checkout status calls AND the payouts API.
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
# Checkout channel/entity id + the "secret token" used to SIGN checkout
# creates + refunds and to VERIFY inbound webhook/result signatures. Set the
# same secret in the Dashboard (Webhook security). REQUIRED in production —
# without PEACH_SECRET inbound webhooks are rejected (fail-closed) so a
# forged webhook can't mark orders paid.
PEACH_ENTITY_ID=
PEACH_SECRET=
# Payouts is a separately-onboarded product with its own entity id
# (Dashboard → Payouts → Settings). Blank → seller disbursement is disabled
# (run-payouts logs intent only).
PEACH_PAYOUT_ENTITY_ID=

# Payment rail selectors (default OFF — site not trading):
#   PAYMENT_MODE=paygate  selects card-rate fees + card-reversal refunds.
#   PAYMENTS_LIVE=true     opens checkout + enables payout disbursement.
PAYMENT_MODE=manual
PAYMENTS_LIVE=false
# Public /api origin for Peach server-to-server callbacks (notificationUrl +
# webhook signature base). Defaults to FRONTEND_URL + '/api' when unset.
PUBLIC_API_URL=
