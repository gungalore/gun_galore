# ===========================================================================
# Gun Galore — backend/.env.example
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Variable names are the canonical list from CLAUDE.md.
# ===========================================================================

# --- Core runtime ---------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Database (PostgreSQL) ------------------------------------------------
# Example: postgresql://USER:PASSWORD@localhost:5432/gun_galore?schema=public
DATABASE_URL=

# --- Auth: Clerk (buyers + sellers) ---------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Auth: Admin (custom JWT, separate from Clerk) ------------------------
JWT_ADMIN_SECRET=

# --- KYC: VerifyNow -------------------------------------------------------
VERIFYNOW_API_KEY=
VERIFYNOW_BASE_URL=

# --- AI: Anthropic (listing moderation, skill questions, quality scoring) -
ANTHROPIC_API_KEY=

# --- Images: Cloudinary ---------------------------------------------------
# All three values are on your Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Search: Meilisearch --------------------------------------------------
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- SMS: SMSPortal -------------------------------------------------------
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=

# --- Email: Resend --------------------------------------------------------
RESEND_API_KEY=

# --- Shipping: Pudo (lockers) ---------------------------------------------
PUDO_API_KEY=

# --- Shipping: The Courier Guy (TCG, door) --------------------------------
TCG_API_KEY=
TCG_WEBHOOK_SECRET=

# --- Maps -----------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Accounting: Odoo (self-hosted, Community edition) --------------------
ODOO_API_KEY=
ODOO_URL=
ODOO_DB=

# --- Payments: Peach Payments (ONLY payment provider) ---------------------
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=
PEACH_BASE_URL=
