    { "id": "qk_steel", "kind": "SIZE", "text": "Blade steel (if marked or known)?", "type": "single", "options": ["Stainless (marked)", "Carbon steel", "Unknown"], "allow_custom": true, "allow_unsure": true, "required": false },
