# ===========================================================================
# Gun Galore — .gitignore
# This is the FIRST commit of the repository, before any secret exists.
# NEVER commit .env files, credential files, or anything containing secrets.
# ===========================================================================

# ---------------------------------------------------------------------------
# Environment variables & secrets (NEVER COMMIT)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# Credential files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json
gcp-key*.json

# ---------------------------------------------------------------------------
# Node / npm / pnpm / yarn
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.loader.mjs
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/
.npm/

# Lockfile backups
*.lock.bak

# ---------------------------------------------------------------------------
# Next.js (frontend)
# ---------------------------------------------------------------------------
.next/
out/
.vercel/
.swc/
next-env.d.ts

# ---------------------------------------------------------------------------
# NestJS / TypeScript build output (backend)
# ---------------------------------------------------------------------------
dist/
build/
*.tsbuildinfo
.tsbuildinfo

# ---------------------------------------------------------------------------
# Prisma — schema.prisma and migrations ARE committed.
# Generated client is ignored (regenerated by `prisma generate`).
# ---------------------------------------------------------------------------
**/prisma/generated/
**/@prisma/client/

# ---------------------------------------------------------------------------
# Testing & coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
.vitest-cache/
junit.xml
test-results/
playwright-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ---------------------------------------------------------------------------
# Caches & build tools
# ---------------------------------------------------------------------------
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.rollup.cache/
.webpack/

# ---------------------------------------------------------------------------
# IDE & editor
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*.swn
*.bak
*~

# ---------------------------------------------------------------------------
# OS-generated files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# PM2 (process manager — server-only, but ignore locally too)
# ---------------------------------------------------------------------------
.pm2/
ecosystem.config.local.js

# ---------------------------------------------------------------------------
# Meilisearch (if running locally with persistent data folder)
# ---------------------------------------------------------------------------
data.ms/
meili_data/

# ---------------------------------------------------------------------------
# Local-only files / temp / scratch
# ---------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.local
*-tmp.*
*-tmp.mjs

# ---------------------------------------------------------------------------
# Internal business documents — kept locally, not pushed to the repo
# ---------------------------------------------------------------------------
Marketing Numbers.xlsx
*.xlsx

# ---------------------------------------------------------------------------
# Uploads / generated images (anything written by the app at runtime
# should never end up in git)
# ---------------------------------------------------------------------------
uploads/
public/uploads/

# ---------------------------------------------------------------------------
# Sentry / monitoring
# ---------------------------------------------------------------------------
.sentryclirc

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Design reference build artefact (1.7MB HTML) — regenerate via agent
gungalore-design-reference.html

# Photo source folder for design reference (not part of the app)
design-photos/

# ---------------------------------------------------------------------------
# Operator's local copy of reloading manuals (Phase D)
# ---------------------------------------------------------------------------
# Copyright-sensitive commercial publications (Hodgdon, Lyman, Hornady,
# Accurate, Vihtavuori, IMR, Alliant, Somchem, ABCs of Reloading, etc.).
# The PDFs live on the prod server's filesystem
# (~/app/manual-inbox/ + ~/app/manuals/), never in git.
Manuals/

# Stray preview artifacts
postal-entry-preview.pdf

# ---------------------------------------------------------------------------
# Claude Code per-developer config (VS Code debug launchers, etc.)
# ---------------------------------------------------------------------------
.claude/

# Operator-supplied sample motivations and any extracted text from them.
# These are REAL documents containing third parties SA ID numbers, home
# addresses, firearm serials and licence numbers. They are reference material
# for structure only and must never enter version control.
/samples/
/motivation-samples/
*.motivation-sample.*
