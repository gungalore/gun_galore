# ===========================================================================
# All Outdoor (Gun Galore) — frontend/.env.example
#
# Copy to frontend/.env.local and fill in. NEVER commit .env.local.
#
# ⚠️  NEXT_PUBLIC_* VALUES ARE INLINED AT BUILD TIME.
# Next.js substitutes them into the JavaScript bundle during `next build`.
# Changing one on the server and restarting pm2 does NOTHING — the old value
# is already compiled into the served chunks. You must REBUILD. Everything
# without the prefix is read at request time on the server and does pick up
# a restart.
#
# Corollary: anything with the NEXT_PUBLIC_ prefix is shipped to the browser
# in plaintext. Never put a secret behind that prefix.
# ===========================================================================


# ─── API endpoints ─────────────────────────────────────────────────────────

# Browser-visible base URL of the backend. Note it INCLUDES the /api prefix
# (Nest sets that globally). Default when unset: http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-side base URL used by Server Components and route handlers. Lets
# server-rendered fetches skip the public hostname (and therefore nginx and
# Cloudflare) and talk to the backend over loopback. Falls back to
# NEXT_PUBLIC_API_URL, then http://localhost:3001/api.
# Prod: http://127.0.0.1:3001/api
INTERNAL_API_URL=http://localhost:3001/api


# ─── Auth ──────────────────────────────────────────────────────────────────

# The SAME value as the backend's JWT_MEMBER_SECRET, and a different value
# from JWT_ADMIN_SECRET.
#
# ⚠️ NOT NEXT_PUBLIC_. It is read in middleware.ts and in server components to
# verify the session cookie; a NEXT_PUBLIC_ prefix would inline the signing
# secret into the browser bundle, at which point anybody can mint a session.
#
# ⚠️ VERIFY-ONLY ON THIS SIDE. Nothing here signs a token — the backend does
# that. If the two ever disagree, every signed-in member is bounced to
# sign-in by the middleware while the API happily accepts them.
JWT_MEMBER_SECRET=change-me-to-a-long-random-string


# ─── Maps ──────────────────────────────────────────────────────────────────

# Google Maps browser key. Needs THREE APIs enabled on the key in Google
# Cloud: Maps JavaScript, Places, AND Geocoding. Geocoding is the one people
# forget — without it the map loads but "use my location" silently fails.
# Unset, or the literal string 'placeholder', disables address autocomplete
# and the component falls back to a plain text field. That is a supported
# state, so local dev does not need a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=placeholder


# ─── Coming-soon gate ──────────────────────────────────────────────────────
#
# Enforced in frontend/middleware.ts, BEFORE the auth check. When on, every
# request that is not an always-allowed route is REWRITTEN (not redirected)
# to /coming-soon with an X-Robots-Tag: noindex header, so the URL the
# visitor typed stays in the address bar and Google does not index "Coming
# Soon" as the homepage.
#
# Three ways through: the gate is off, the path is always-allowed (API,
# admin, SMS-token checkout links, /checkout/complete), or the visitor holds
# the bypass cookie.

# The literal string 'on' enables the gate. Anything else = off.
COMING_SOON_GATE=off

# Bypass secret. Visit /preview?key=<this value> to be issued the gg-preview
# cookie; middleware compares the cookie value against this variable.
# Unset while the gate is on → nobody can bypass, including you.
# Rotate by changing this and re-issuing the cookie via /preview.
COMING_SOON_BYPASS_SECRET=


# ─── Feature flags / build-time switches ───────────────────────────────────

# Ask Boet page-context: sends the current page's context with the question
# so the assistant knows what the user is looking at. Literal string 'true'.
NEXT_PUBLIC_ASKGG_CONTEXT=true

# Mirrors the backend's PAYMENT_MODE so the checkout UI renders the card
# path instead of the manual path. 'paygate' or anything else (= manual).
# Keep it in step with the backend — the backend is the authority; this only
# decides what the buyer is shown.
NEXT_PUBLIC_PAYMENT_MODE=manual

# PWA service-worker kill switch. Literal string 'true' does two things at
# once: Serwist skips generating /sw.js at build, AND the client helper
# unregisters any service worker already installed on a returning visitor.
# That double action is how a bad SW gets remotely killed. Leave unset.
NEXT_PUBLIC_DISABLE_PWA=

# The new document scanner (components/scan-v3, the ground-up rebuild). Literal
# '1' swaps it in behind ScanButton and the phone hand-off page; anything else
# leaves the previous scanner in place. Inlined at build time.
NEXT_PUBLIC_SCANNER_V3=

# Canonical public origin, used for sitemap.xml, robots.txt, OpenGraph tags
# and JSON-LD. No trailing slash. Falls back to https://gungalore.co.za —
# so if you ever run a staging build, set this or staging will advertise
# production URLs to crawlers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin used to build the absolute redirect out of /admin/logout. Default
# http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The rebuilt licence-services "pack" screen at /licence-services/[id].
# BUILD-TIME: literal 'true' ships it to every member and needs a rebuild.
# Leave unset to keep the /motivations/[id] wizard as the live UI. For a
# one-tab look at the unfinished screen use ?preview=1 instead — see
# lib/licence-services-preview.ts.
NEXT_PUBLIC_LICENCE_SERVICES_ENABLED=
