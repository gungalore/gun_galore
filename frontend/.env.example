# ===========================================================================
# Gun Galore — frontend/.env.example
# Copy to frontend/.env.local and fill in real values. NEVER commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ===========================================================================

# --- API endpoint (browser-visible) ---------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Clerk auth -----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect routes (these stay the same across environments)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Ask GG Everywhere W4 — page-context flag (true on prod since 2026-07-12)
NEXT_PUBLIC_ASKGG_CONTEXT=true
