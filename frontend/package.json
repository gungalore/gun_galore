    "aws-amplify": "^6.20.0",
    "gsap": "^3.15.0",
    "next": "^16.2.6",
    "onnxruntime-web": "^1.18.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.11",
    "three": "^0.185.1"
  },
  "devDependencies": {
